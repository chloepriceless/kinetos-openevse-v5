-          _enabled = (RAPI_RESPONSE_OK == ret);
-          DBUGF("kinetos: $F2 0 -> %d", ret);
-        });
-        return 1000;
+      if(!_enabled) {
+        return enable();
       }
 
       kinetos_config_backup();
 
+      // Repeat "$F2 0" every 10 minutes: a controller that restarted on its own (the ESP keeps
+      // running) would otherwise silently fall back to its own, empty current reading
+      if(millis() - _enabledAt > 10UL * 60UL * 1000UL) {
+        _tries = 0;
+        return enable();
+      }
+
       if(!sdmMeter.isValid()) {
+        _state = "meter_invalid";
         return 2000;
       }
+      _state = "on";
 
       char cmd[48];
       snprintf(cmd, sizeof(cmd), "$T0 %lu %lu %lu",
@@ -244,7 +269,15 @@ class KinetosControllerFeed : public MicroTasks::Task
         (unsigned long)(sdmMeter.get(SdmMeter::CurrentL2) * 1000),
