@@ -193,8 +193,34 @@ class KinetosControllerFeed : public MicroTasks::Task
     bool _enabled = false;
     bool _busy = false;
     uint32_t _lastWh = 0;
+    uint32_t _enabledAt = 0;
+    int _lastAnswer = RAPI_RESPONSE_OK;
+    const char *_state = "starting";
     bool _ocppIdChecked = false;
 
+    // "$F2 0" switches the controller to external meter values. It can refuse while it is
+    // disabled/sleeping or still booting, so retry quickly a few times and then every minute
+    // for as long as it takes (rev <= 20 gave up after six tries right after boot).
+    unsigned long enable()
+    {
+      if(_tries < 255) {
+        _tries++;
+      }
+      _busy = true;
+      _state = "enabling";
+      rapiSender.sendCmd("$F2 0", [this](int ret) {
+        _busy = false;
+        _lastAnswer = ret;
+        _enabled = (RAPI_RESPONSE_OK == ret);
+        _state = _enabled ? "on" : (RAPI_RESPONSE_NK == ret ? "f2_rejected" : "f2_no_answer");
+        if(_enabled) {
+          _enabledAt = millis();
+        }
+        DBUGF("kinetos: $F2 0 -> %d", ret);
+      });
+      return _tries < 6 ? 1000 : 60UL * 1000UL;
+    }
+
   protected:
     void setup() {}
 
