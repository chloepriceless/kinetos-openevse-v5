+//-------------------------------------------------------------------------------------------//
+// Worker thread: set-up, periodic work, tear-down
+//-------------------------------------------------------------------------------------------//
+
+static bool AddEvseEntity(DeviceLocalObject* device) {
+  uint32_t ids[1]                 = {(uint32_t)VectorGetSize(DEVICE_LOCAL_GET_ENTITIES(device))};
+  EntityLocalObject* const entity = EntityLocalCreate(device, kEntityTypeTypeEVSE, ids, ARRAY_SIZE(ids), kHeartbeatTimeoutSeconds);
+  if (entity == NULL) {
+    return false;
+  }
+  app.cs_lpc = CsLpcUseCaseCreate(entity, kConnectionId, &cs_listener);
+  const MuMpcConfig* const mpc = !app.per_phase ? &kMpcBasic : (app.frequency ? &kMpcMeterFrequency : &kMpcMeter);
+  app.mu_mpc                   = MuMpcUseCaseCreate(entity, kConnectionId, mpc, &mu_listener);
+  if ((app.cs_lpc == NULL) || (app.mu_mpc == NULL)) {
+    EntityLocalDelete(entity);
+    return false;
+  }
+  CsLpSetWriteApprover(app.cs_lpc, &approver);
+  DEVICE_LOCAL_ADD_ENTITY(device, entity);
+  return true;
+}
+
+/** First start: create the identity of this node. */
+static bool GenerateIdentity(void) {
+  char name[96];
+  snprintf(name, sizeof(name), "%s %s %s", app.brand, app.model, app.serial);
+  char* const cert = (char*)EEBUS_MALLOC(EEBUS_CERT_PEM_MAX);
+  char* const key  = (char*)EEBUS_MALLOC(EEBUS_CERT_PEM_MAX);
+  if ((cert == NULL) || (key == NULL) || (EebusCertGenerate(name, cert, EEBUS_CERT_PEM_MAX, key, EEBUS_CERT_PEM_MAX) != 0)) {
+    EEBUS_FREE(cert);
+    EEBUS_FREE(key);
+    return false;
+  }
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EEBUS_FREE(app.cert_pem);
+  EEBUS_FREE(app.key_pem);
+  app.cert_pem                  = cert;
+  app.key_pem                   = key;
+  app.status.identity_generated = true;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  return true;
+}
+
+static bool Setup(void) {
+  if (((app.cert_pem[0] == '\0') || (app.key_pem[0] == '\0')) && !GenerateIdentity()) {
+    return false;
+  }
+
+  app.tls = TlsCertificateParseX509KeyPair(app.cert_pem, strlen(app.cert_pem), app.key_pem, strlen(app.key_pem));
+  if (app.tls == NULL) {
+    return false;
+  }
+
+  app.cfg = EebusServiceConfigCreate(app.brand, app.brand, app.model, app.serial, "ChargingStation", app.port);
+  if (app.cfg == NULL) {
+    return false;
+  }
+  char ship_id[160];
+  snprintf(ship_id, sizeof(ship_id), "%s-%s-%s", app.brand, app.model, app.serial);
+  EebusServiceConfigSetAlternateIdentifier(app.cfg, ship_id);
+
+  app.service = EebusServiceCreate(app.cfg, "auto", app.tls, &app.reader);
+  if (app.service == NULL) {
+    return false;
+  }
+  if (!AddEvseEntity(EEBUS_SERVICE_GET_LOCAL_DEVICE(app.service))) {
+    return false;
+  }
+
+  // A Controllable System has to publish its (inactive) limit entry itself;
+  // without it the energy guard's write has nothing to update.
+  const ScaledValue no_limit = {.value = 0, .scale = 0};
+  if (CsLpSetActivePowerLimit(app.cs_lpc, &no_limit, false, true) != kEebusErrorOk) {
+    return false;
+  }
+  EEBUS_MUTEX_LOCK(app.mutex);
+  const double failsafe_w          = app.limit.failsafe_w;
+  const int64_t failsafe_duration  = app.limit.failsafe_duration_s;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  const ScaledValue nominal        = Scaled(app.nominal_max_w, 0);
+  const ScaledValue failsafe       = Scaled(failsafe_w, 0);
+  const EebusDuration failsafe_dur = SecondsToDuration(failsafe_duration);
+  CsLpSetNominalMax(app.cs_lpc, &nominal);
+  CsLpSetFailsafeActivePowerLimit(app.cs_lpc, &failsafe, true);
+  CsLpSetFailsafeDurationMinimum(app.cs_lpc, &failsafe_dur, true);
+  CsLpStartHeartbeat(app.cs_lpc);
+
+  // Only nodes the user paired may connect
+  EEBUS_SERVICE_SET_PAIRING_POSSIBLE(app.service, false);
+  EEBUS_SERVICE_START(app.service);
+
+  EEBUS_MUTEX_LOCK(app.mutex);
+  CopyField(app.status.ski, sizeof(app.status.ski), EEBUS_SERVICE_GET_LOCAL_SKI(app.service));
+  // Pairings from the configuration
+  for (size_t i = 0; (i < app.peer_count) && (app.op_count < TRUST_OPS_MAX); ++i) {
+    if (app.peers[i].trusted) {
+      TrustOp* const op = &app.ops[app.op_count++];
+      CopyField(op->ski, sizeof(op->ski), app.peers[i].ski);
+      op->trust = true;
+    }
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  return true;
+}
+
+static void Teardown(void) {
+  if (app.service != NULL) {
+    EEBUS_SERVICE_STOP(app.service);
+  }
+  // Use cases unsubscribe from the service's events while being destroyed,
+  // so they go before the service (same order as the openeebus examples).
+  if (app.cs_lpc != NULL) {
+    CsLpSetWriteApprover(app.cs_lpc, NULL);
+    UseCaseDelete(USE_CASE_OBJECT(app.cs_lpc));
+    app.cs_lpc = NULL;
+  }
+  if (app.mu_mpc != NULL) {
+    UseCaseDelete(USE_CASE_OBJECT(app.mu_mpc));
+    app.mu_mpc = NULL;
+  }
+  if (app.service != NULL) {
+    EebusServiceDelete(app.service);  // releases the certificate as well
+    app.service = NULL;
+  } else {
+    TlsCertificateDelete(app.tls);
+  }
+  app.tls = NULL;
+  if (app.cfg != NULL) {
+    EebusServiceConfigDelete(app.cfg);
+    app.cfg = NULL;
+  }
+}
+
+/** State machine and what follows from it; about once a second. */
+static void Evaluate(void) {
+  const bool heartbeat_ok = CsLpIsHeartbeatWithinDuration(app.cs_lpc);
+  const int64_t now       = NowMs();
+  bool announce_inactive  = false;
+  double announce_w       = 0.0;
+
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusLimitStateOnHeartbeat(&app.limit, heartbeat_ok, now);
+
+  double limit_w = 0.0;
+  int64_t until  = 0;
+  const bool limited              = EebusLimitStateEffective(&app.limit, &limit_w, &until);
+  app.status.limit_state          = app.limit.state;
+  app.status.limited              = limited;
+  app.status.limit_w              = limited ? limit_w : 0.0;
+  app.status.limit_remaining_s    = (limited && (until > 0)) ? ((until > now) ? (until - now + 999) / 1000 : 0) : -1;
+  app.status.heartbeat_ok         = heartbeat_ok;
+  app.status.failsafe_w           = app.limit.failsafe_w;
+  app.status.failsafe_duration_s  = (int32_t)app.limit.failsafe_duration_s;
+
+  // The duration of the limit is over: the energy guard reads it as inactive again.
+  if (app.limit_announced_active && app.limit.has_limit && app.limit.limit_expires && (app.limit.limit_until_ms <= now)) {
+    app.limit_announced_active = false;
+    app.limit.limit_active     = false;
+    announce_inactive          = true;
+    announce_w                 = app.limit.limit_w;
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+
+  if (announce_inactive) {
+    const ScaledValue sv = Scaled(announce_w, 0);
+    CsLpSetActivePowerLimit(app.cs_lpc, &sv, false, true);
+  }
+}
+
+static void Tick(int tick) {
+  TrustOp ops[TRUST_OPS_MAX];
+  EebusAppMeasurements measurements;
+
+  EEBUS_MUTEX_LOCK(app.mutex);
+  const size_t op_count = app.op_count;
+  memcpy(ops, app.ops, sizeof(ops));
+  app.op_count        = 0;
+  const bool publish  = app.measurements_dirty;
+  measurements        = app.measurements;
+  app.measurements_dirty = false;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+
+  for (size_t i = 0; i < op_count; ++i) {
+    if (ops[i].trust) {
+      EEBUS_SERVICE_REGISTER_REMOTE_SKI(app.service, ops[i].ski, true);
+    } else {
+      EEBUS_SERVICE_UNREGISTER_REMOTE_SKI(app.service, ops[i].ski);
+    }
+  }
+  if (publish) {
+    PublishMeasurements(&measurements);
+  }
+  if ((tick % kTicksPerEvaluation) == 0) {
+    Evaluate();
+  }
+}
+
+static void* Worker(void* arg) {
+  (void)arg;
+  const bool running = Setup();
+  EEBUS_MUTEX_LOCK(app.mutex);
+  app.status.running = running;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+
+  for (int tick = 0; !app.stop; ++tick) {
+    if (running) {
+      Tick(tick);
+    }
+    EebusThreadUsleep(kTickMs * 1000);
+  }
+
+  EEBUS_MUTEX_LOCK(app.mutex);
+  app.status.running = false;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  Teardown();
+  app.finished = true;
+  return NULL;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Interface to the firmware
+//-------------------------------------------------------------------------------------------//
+
+static void FreeConfig(void) {
+  EEBUS_FREE(app.cert_pem);
+  EEBUS_FREE(app.key_pem);
+  EEBUS_FREE(app.brand);
+  EEBUS_FREE(app.model);
+  EEBUS_FREE(app.serial);
+  app.cert_pem = app.key_pem = app.brand = app.model = app.serial = NULL;
+}
+
+bool EebusAppStart(const EebusAppConfig* cfg) {
+  if (app.started || (cfg == NULL) || (cfg->port <= 0) || (cfg->port > 65535)) {
+    return false;
+  }
+  memset(&app, 0, sizeof(app));
+  SERVICE_READER_INTERFACE(&app.reader) = &reader_methods;
+
+  app.port          = cfg->port;
+  app.cert_pem      = CopyString(cfg->cert_pem);
+  app.key_pem       = CopyString(cfg->key_pem);
+  app.brand         = CopyString(cfg->brand);
+  app.model         = CopyString(cfg->model);
+  app.serial        = CopyString(cfg->serial);
+  app.nominal_max_w = cfg->nominal_max_w;
+  app.per_phase     = cfg->per_phase;
+  app.frequency     = cfg->per_phase && cfg->frequency;
+  app.mutex         = EebusMutexCreate();
+  if ((app.cert_pem == NULL) || (app.key_pem == NULL) || (app.brand == NULL) || (app.model == NULL) || (app.serial == NULL)
+      || (app.mutex == NULL)) {
+    EebusMutexDelete(app.mutex);
+    FreeConfig();
+    return false;
+  }
+
+  EebusLimitStateInit(&app.limit, cfg->failsafe_w, cfg->failsafe_duration_s, NowMs());
+  app.status.failsafe_w          = cfg->failsafe_w;
+  app.status.failsafe_duration_s = cfg->failsafe_duration_s;
+  app.status.limit_remaining_s   = -1;
+
+  // "ski,ski,..."
+  for (const char* p = (cfg->trusted != NULL) ? cfg->trusted : ""; *p != '\0';) {
+    const char* const end = strchr(p, ',');
+    const size_t len      = (end != NULL) ? (size_t)(end - p) : strlen(p);
+    if (len == EEBUS_APP_SKI_LEN) {
+      char ski[EEBUS_APP_SKI_LEN + 1];
+      memcpy(ski, p, len);
+      ski[len]                 = '\0';
+      EebusAppPeer* const peer = PeerGet(ski);
+      if (peer != NULL) {
+        peer->trusted = true;
+      }
+    }
+    p += len + ((end != NULL) ? 1 : 0);
+  }
+  if (cfg->guard_ski != NULL) {
+    GuardSetIfTrusted(cfg->guard_ski);
+    app.status.persist_seq = 0;  // nothing new to store
+  }
+
+  app.thread = EebusThreadCreate(Worker, NULL, kWorkerStackSize);
+  if (app.thread == NULL) {
+    EebusMutexDelete(app.mutex);
+    FreeConfig();
+    return false;
+  }
+  app.started = true;
+  return true;
+}
+
+void EebusAppRequestStop(void) {
+  if (app.started) {
+    app.stop = true;
+  }
+}
+
+bool EebusAppFinished(void) {
+  return !app.started || app.finished;
+}
+
+bool EebusAppGetIdentity(char* cert_pem, size_t cert_pem_size, char* key_pem, size_t key_pem_size) {
+  if (!app.started || (cert_pem == NULL) || (key_pem == NULL)) {
+    return false;
+  }
+  EEBUS_MUTEX_LOCK(app.mutex);
+  const bool ok = app.status.running && (strlen(app.cert_pem) < cert_pem_size) && (strlen(app.key_pem) < key_pem_size);
+  if (ok) {
+    strcpy(cert_pem, app.cert_pem);
+    strcpy(key_pem, app.key_pem);
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  return ok;
+}
+
+void EebusAppStop(void) {
+  if (!app.started) {
+    return;
+  }
+  app.stop = true;
+  EEBUS_THREAD_JOIN(app.thread);
+  EebusThreadDelete(app.thread);
+  EebusMutexDelete(app.mutex);
+  FreeConfig();
+  memset(&app, 0, sizeof(app));
+}
+
+bool EebusAppTrust(const char* ski, bool trust) {
+  if (!app.started || !EebusAppSkiValid(ski)) {
+    return false;
+  }
+  bool ok = false;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusAppPeer* const peer = trust ? PeerGet(ski) : PeerFind(ski);
+  if (!trust && (peer == NULL)) {
+    ok = true;  // not paired anyway
+  } else if ((peer != NULL) && (app.op_count < TRUST_OPS_MAX)) {
+    TrustOp* const op = &app.ops[app.op_count++];
+    CopyField(op->ski, sizeof(op->ski), peer->ski);
+    op->trust     = trust;
+    peer->trusted = trust;
+    if (!trust) {
+      if (peer->guard) {
+        GuardSet("");
+      }
+      PeersCleanup();
+    }
+    ok = true;
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  return ok;
+}
+
+void EebusAppSetMeasurements(const EebusAppMeasurements* measurements) {
+  if (!app.started || (measurements == NULL)) {
+    return;
+  }
+  EEBUS_MUTEX_LOCK(app.mutex);
+  if (memcmp(&app.measurements, measurements, sizeof(*measurements)) != 0) {
+    app.measurements       = *measurements;
+    app.measurements_dirty = true;
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+void EebusAppGetStatus(EebusAppStatus* status) {
+  if (status == NULL) {
+    return;
+  }
+  if (!app.started) {
+    memset(status, 0, sizeof(*status));
+    status->limit_remaining_s = -1;
+    return;
+  }
+  EEBUS_MUTEX_LOCK(app.mutex);
+  *status = app.status;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+size_t EebusAppGetPeers(EebusAppPeer* peers, size_t max) {
+  if (!app.started || (peers == NULL)) {
+    return 0;
+  }
+  EEBUS_MUTEX_LOCK(app.mutex);
+  const size_t count = (app.peer_count < max) ? app.peer_count : max;
+  memcpy(peers, app.peers, count * sizeof(EebusAppPeer));
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+  return count;
+}
diff --git a/eebus/app/eebus_app.h b/eebus/app/eebus_app.h
new file mode 100644
index 00000000..9c83ed28
--- /dev/null
+++ b/eebus/app/eebus_app.h
@@ -0,0 +1,151 @@
+/*
+ * EEBUS node of the wallbox (openeebus by NIBE).
+ *
+ * Local SPINE device "ChargingStation" with one EVSE entity:
+ *   - CS LPC: the grid operator's control box (§14a EnWG) or an energy
+ *     manager limits the power the charger may draw
+ *   - MU MPC: power, energy, currents, voltages and frequency for whoever
+ *     monitors the charger
+ *
+ * Everything that talks to openeebus runs in the threads of this module. The
+ * firmware only passes values in and reads a snapshot back, so it never waits
+ * for the network and needs no stack for the protocol.
+ *
+ * Plain C, no firmware dependencies: the same code runs on the host against
+ * the openeebus reference programs (eebus/test).
+ */
+#ifndef EEBUS_APP_EEBUS_APP_H_
+#define EEBUS_APP_EEBUS_APP_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "eebus_limit_state.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Length of an SKI in hex characters. */
+#define EEBUS_APP_SKI_LEN 40
+
+/** Remote nodes kept in the list (trusted and found in the network). */
+#define EEBUS_APP_MAX_PEERS 8
+
+typedef struct EebusAppConfig {
+  int32_t port;
+  /**
+   * Certificate and key of this node, PEM (see eebus_cert.h). Both NULL or
+   * empty: a new pair is generated, see EebusAppStatus.identity_generated.
+   */
+  const char* cert_pem;
+  const char* key_pem;
+  const char* brand;
+  const char* model;
+  const char* serial;
+  /** SKIs paired earlier, separated by ',' (may be NULL) */
+  const char* trusted;
+  /** SKI of the energy guard that limited this charger before (may be NULL) */
+  const char* guard_ski;
+  /** Power the charger draws at most, W */
+  double nominal_max_w;
+  /** Failsafe values until the energy guard writes its own */
+  double failsafe_w;
+  int32_t failsafe_duration_s;
+  /** A meter delivers power, current and voltage per phase */
+  bool per_phase;
+  /** ... and the grid frequency */
+  bool frequency;
+} EebusAppConfig;
+
+typedef struct EebusAppMeasurements {
+  double power_w;    // total
+  double energy_wh;  // consumed, counter
+  // only with EebusAppConfig.per_phase
+  double phase_power_w[3];
+  double current_a[3];
+  double voltage_v[3];
+  // only with EebusAppConfig.frequency
+  double frequency_hz;
+} EebusAppMeasurements;
+
+typedef struct EebusAppStatus {
+  bool running;
+  char ski[EEBUS_APP_SKI_LEN + 1];
+  /** The node created its certificate itself: fetch it with EebusAppGetIdentity() and keep it */
+  bool identity_generated;
+
+  EebusLimitStateId limit_state;
+  /** A limit has to be applied now (state limited or failsafe) */
+  bool limited;
+  double limit_w;
+  /** Seconds until the limit ends, -1 when open-ended or not limited */
+  int64_t limit_remaining_s;
+  bool heartbeat_ok;
+
+  /**
+   * To be kept across restarts; `persist_seq` changes whenever one of them
+   * does. The failsafe values are the ones in force (written by the energy
+   * guard or still the configured ones).
+   */
+  uint32_t persist_seq;
+  double failsafe_w;
+  int32_t failsafe_duration_s;
+  char guard_ski[EEBUS_APP_SKI_LEN + 1];
+} EebusAppStatus;
+
+typedef struct EebusAppPeer {
+  char ski[EEBUS_APP_SKI_LEN + 1];
+  char name[48];
+  char brand[32];
+  char model[32];
+  char type[32];
+  bool trusted;        // paired by the user
+  bool discovered;     // currently announced in the network (mDNS)
+  bool connected;      // SHIP connection established
+  bool waiting_trust;  // connected so far that the other side has to trust us
+  bool guard;          // this node limits the charger (energy guard)
+} EebusAppPeer;
+
+/**
+ * Start the node. The strings in `cfg` are copied. Returns false when the
+ * configuration is unusable or there is not enough memory; whether the
+ * service came up is in EebusAppStatus.running.
+ */
+bool EebusAppStart(const EebusAppConfig* cfg);
+
+/**
+ * Stop and release everything. Shutting the connections down takes a moment;
+ * a caller that must not wait asks with EebusAppRequestStop(), and calls this
+ * once EebusAppFinished() is true (it then returns at once).
+ */
+void EebusAppStop(void);
+
+void EebusAppRequestStop(void);
+
+/** The node has shut down after EebusAppRequestStop() (also true when it was never started). */
+bool EebusAppFinished(void);
+
+/** Certificate and key in use, as NUL-terminated PEM. False while the node is not running. */
+bool EebusAppGetIdentity(char* cert_pem, size_t cert_pem_size, char* key_pem, size_t key_pem_size);
+
+/** Pair with a node (trust its SKI) or remove the pairing. */
+bool EebusAppTrust(const char* ski, bool trust);
+
+/** New values of the charger; sent to subscribers when they changed. */
+void EebusAppSetMeasurements(const EebusAppMeasurements* measurements);
+
+void EebusAppGetStatus(EebusAppStatus* status);
+
+/** Copy up to `max` nodes into `peers`, returns the number copied. */
+size_t EebusAppGetPeers(EebusAppPeer* peers, size_t max);
+
+/** True for exactly 40 hex characters. */
+bool EebusAppSkiValid(const char* ski);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // EEBUS_APP_EEBUS_APP_H_
diff --git a/eebus/app/eebus_limit_state.c b/eebus/app/eebus_limit_state.c
new file mode 100644
index 00000000..44c3006f
--- /dev/null
+++ b/eebus/app/eebus_limit_state.c
@@ -0,0 +1,167 @@
+/*
+ * LPC state machine, see eebus_limit_state.h.
+ */
+#include "eebus_limit_state.h"
+
+#include <stddef.h>
+#include <string.h>
+
+static bool Go(EebusLimitState* s, EebusLimitStateId next, int64_t now_ms) {
+  if (s->state == next) {
+    return false;
+  }
+  s->state    = next;
+  s->since_ms = now_ms;
+  if (next == kEebusLimitFailsafe) {
+    s->failsafe_since_ms = now_ms;
+  }
+  return true;
+}
+
+static bool LimitValid(const EebusLimitState* s, int64_t now_ms) {
+  return s->has_limit && s->limit_active && (!s->limit_expires || (s->limit_until_ms > now_ms));
+}
+
+static EebusLimitStateId ControlledState(const EebusLimitState* s, int64_t now_ms) {
+  return LimitValid(s, now_ms) ? kEebusLimitLimited : kEebusLimitUnlimitedControlled;
+}
+
+// openeebus reports a dropped connection as "no heartbeat" right away. LPC
+// asks for the failsafe state only after 120 s without one: a restart of the
+// control box or a short network outage must not limit the charger for hours.
+static bool HeartbeatLost(const EebusLimitState* s, int64_t now_ms) {
+  if (s->heartbeat_ok) {
+    return false;
+  }
+  return !s->heartbeat_seen || (now_ms - s->last_heartbeat_ms >= EEBUS_LIMIT_HEARTBEAT_TIMEOUT_MS);
+}
+
+void EebusLimitStateInit(EebusLimitState* s, double failsafe_w, int64_t failsafe_duration_s, int64_t now_ms) {
+  memset(s, 0, sizeof(*s));
+  s->state               = kEebusLimitDisabled;
+  s->since_ms            = now_ms;
+  s->failsafe_w          = failsafe_w;
+  s->failsafe_duration_s = failsafe_duration_s;
+}
+
+bool EebusLimitStateSetEnabled(EebusLimitState* s, bool enabled, int64_t now_ms) {
+  if (!enabled) {
+    return Go(s, kEebusLimitDisabled, now_ms);
+  }
+  if (s->state != kEebusLimitDisabled) {
+    return false;
+  }
+  s->init_at_ms = now_ms;
+  return Go(s, kEebusLimitInit, now_ms);
+}
+
+bool EebusLimitStateOnLimit(EebusLimitState* s, double limit_w, int64_t duration_s, bool active, int64_t now_ms) {
+  s->has_limit      = true;
+  s->limit_w        = limit_w;
+  s->limit_active   = active;
+  s->limit_expires  = duration_s > 0;
+  s->limit_until_ms = now_ms + duration_s * 1000;
+  s->last_write_ms  = now_ms;
+  // A write proves a living connection.
+  s->heartbeat_ok      = true;
+  s->heartbeat_seen    = true;
+  s->last_heartbeat_ms = now_ms;
+  if (s->state == kEebusLimitDisabled) {
+    return false;
+  }
+  return Go(s, ControlledState(s, now_ms), now_ms);
+}
+
+void EebusLimitStateOnFailsafeLimit(EebusLimitState* s, double limit_w) {
+  if (limit_w >= 0.0) {
+    s->failsafe_w = limit_w;
+  }
+}
+
+void EebusLimitStateOnFailsafeDuration(EebusLimitState* s, int64_t duration_s) {
+  if (duration_s > 0) {
+    s->failsafe_duration_s = duration_s;
+  }
+}
+
+bool EebusLimitStateOnHeartbeat(EebusLimitState* s, bool ok, int64_t now_ms) {
+  s->heartbeat_ok = ok;
+  return EebusLimitStateEvaluate(s, now_ms);
+}
+
+bool EebusLimitStateEvaluate(EebusLimitState* s, int64_t now_ms) {
+  if (s->heartbeat_ok) {
+    s->heartbeat_seen    = true;
+    s->last_heartbeat_ms = now_ms;
+  }
+  switch (s->state) {
+    case kEebusLimitDisabled: return false;
+
+    case kEebusLimitInit:
+      if (s->heartbeat_ok) {
+        return Go(s, ControlledState(s, now_ms), now_ms);
+      }
+      if (now_ms - s->init_at_ms >= EEBUS_LIMIT_HEARTBEAT_TIMEOUT_MS) {
+        return Go(s, kEebusLimitFailsafe, now_ms);
+      }
+      return false;
+
+    case kEebusLimitLimited:
+    case kEebusLimitUnlimitedControlled:
+      if (HeartbeatLost(s, now_ms)) {
+        return Go(s, kEebusLimitFailsafe, now_ms);
+      }
+      return Go(s, ControlledState(s, now_ms), now_ms);
+
+    case kEebusLimitFailsafe:
+      // A new limit from the reconnected energy guard ends the failsafe state.
+      if (s->heartbeat_ok && s->has_limit && (s->last_write_ms > s->failsafe_since_ms)) {
+        return Go(s, ControlledState(s, now_ms), now_ms);
+      }
+      if (now_ms - s->failsafe_since_ms < s->failsafe_duration_s * 1000) {
+        return false;
+      }
+      return Go(s, s->heartbeat_ok ? ControlledState(s, now_ms) : kEebusLimitUnlimitedAutonomous, now_ms);
+
+    case kEebusLimitUnlimitedAutonomous:
+      if (s->heartbeat_ok) {
+        return Go(s, ControlledState(s, now_ms), now_ms);
+      }
+      return false;
+  }
+  return false;
+}
+
+bool EebusLimitStateEffective(const EebusLimitState* s, double* limit_w, int64_t* until_ms) {
+  double w      = 0.0;
+  int64_t until = 0;
+  bool limited  = false;
+  if (s->state == kEebusLimitLimited) {
+    limited = true;
+    w       = s->limit_w;
+    until   = s->limit_expires ? s->limit_until_ms : 0;
+  } else if (s->state == kEebusLimitFailsafe) {
+    limited = true;
+    w       = s->failsafe_w;
+    until   = s->failsafe_since_ms + s->failsafe_duration_s * 1000;
+  }
+  if (limit_w != NULL) {
+    *limit_w = w;
+  }
+  if (until_ms != NULL) {
+    *until_ms = until;
+  }
+  return limited;
+}
+
+const char* EebusLimitStateName(EebusLimitStateId state) {
+  switch (state) {
+    case kEebusLimitDisabled: return "disabled";
+    case kEebusLimitInit: return "init";
+    case kEebusLimitUnlimitedControlled: return "unlimited_controlled";
+    case kEebusLimitLimited: return "limited";
+    case kEebusLimitFailsafe: return "failsafe";
+    case kEebusLimitUnlimitedAutonomous: return "unlimited_autonomous";
+  }
+  return "?";
+}
diff --git a/eebus/app/eebus_limit_state.h b/eebus/app/eebus_limit_state.h
new file mode 100644
index 00000000..a125265f
--- /dev/null
+++ b/eebus/app/eebus_limit_state.h
@@ -0,0 +1,98 @@
+/*
+ * State machine of the EEBUS use case "Limitation of Power Consumption" (LPC).
+ *
+ * The wallbox is the "Controllable System", the grid operator's control box
+ * (§14a EnWG) or an energy manager is the "Energy Guard". LPC prescribes:
+ *
+ *   init                  after the start, until the energy guard is heard
+ *                         (120 s without heartbeat -> failsafe)
+ *   unlimited_controlled  energy guard connected, no active limit
+ *   limited               active limit, until its duration ends or it is lifted
+ *   failsafe              heartbeat lost -> failsafe limit, at least for the
+ *                         failsafe duration; a new limit from the reconnected
+ *                         energy guard ends it earlier
+ *   unlimited_autonomous  failsafe duration over, energy guard still gone
+ *
+ * Without a paired energy guard the machine is "disabled": a charger nobody
+ * controls must never fall back to the failsafe limit.
+ *
+ * Pure and without firmware dependencies (the clock is passed in), so it is
+ * tested on the host (test/test_eebus_limit_state).
+ */
+#ifndef EEBUS_APP_EEBUS_LIMIT_STATE_H_
+#define EEBUS_APP_EEBUS_LIMIT_STATE_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Without heartbeat for this long the energy guard counts as lost. */
+#define EEBUS_LIMIT_HEARTBEAT_TIMEOUT_MS 120000
+
+typedef enum EebusLimitStateId {
+  kEebusLimitDisabled = 0,
+  kEebusLimitInit,
+  kEebusLimitUnlimitedControlled,
+  kEebusLimitLimited,
+  kEebusLimitFailsafe,
+  kEebusLimitUnlimitedAutonomous,
+} EebusLimitStateId;
+
+typedef struct EebusLimitState {
+  EebusLimitStateId state;
+  int64_t since_ms;
+  int64_t init_at_ms;
+
+  bool heartbeat_ok;
+  bool heartbeat_seen;  // last_heartbeat_ms is valid
+  int64_t last_heartbeat_ms;
+
+  bool has_limit;  // the fields below are valid
+  double limit_w;
+  bool limit_active;
+  bool limit_expires;
+  int64_t limit_until_ms;
+  int64_t last_write_ms;
+
+  double failsafe_w;
+  int64_t failsafe_duration_s;
+  int64_t failsafe_since_ms;
+} EebusLimitState;
+
+/** Starts disabled. The failsafe values apply until the energy guard writes its own. */
+void EebusLimitStateInit(EebusLimitState* s, double failsafe_w, int64_t failsafe_duration_s, int64_t now_ms);
+
+/** Energy guard paired (true) or not (false). Returns true when the state changed. */
+bool EebusLimitStateSetEnabled(EebusLimitState* s, bool enabled, int64_t now_ms);
+
+/** A limit written by the energy guard (already approved). `duration_s` <= 0: until further notice. */
+bool EebusLimitStateOnLimit(EebusLimitState* s, double limit_w, int64_t duration_s, bool active, int64_t now_ms);
+
+/** Failsafe limit written by the energy guard; negative values are ignored. */
+void EebusLimitStateOnFailsafeLimit(EebusLimitState* s, double limit_w);
+
+/** Minimum failsafe duration written by the energy guard; values <= 0 are ignored. */
+void EebusLimitStateOnFailsafeDuration(EebusLimitState* s, int64_t duration_s);
+
+/** Heartbeat of the energy guard within its time limit or not. */
+bool EebusLimitStateOnHeartbeat(EebusLimitState* s, bool ok, int64_t now_ms);
+
+/** Time dependent transitions, call regularly. Returns true when the state changed. */
+bool EebusLimitStateEvaluate(EebusLimitState* s, int64_t now_ms);
+
+/**
+ * What has to be applied now. Returns true when a limit applies; then
+ * `limit_w` is the limit and `until_ms` its end (0: open-ended).
+ */
+bool EebusLimitStateEffective(const EebusLimitState* s, double* limit_w, int64_t* until_ms);
+
+const char* EebusLimitStateName(EebusLimitStateId state);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // EEBUS_APP_EEBUS_LIMIT_STATE_H_
