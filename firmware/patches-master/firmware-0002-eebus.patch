diff --git a/eebus/openeebus.py b/eebus/openeebus.py
new file mode 100644
index 00000000..14753741
--- /dev/null
+++ b/eebus/openeebus.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Fetch the pinned openeebus sources and apply our patches.
+
+    eebus/openeebus.py <work-dir>      prints the directory with the sources
+
+Used by the firmware build (scripts/eebus_build.py) and by the host test
+(eebus/test/build-host.sh). The tarball is checked against the checksum in
+openeebus.pin; the tree is unpacked again whenever the pin or a patch changes.
+Needs `patch`.
+"""
+import hashlib
+import os
+import shutil
+import subprocess
+import sys
+import tarfile
+import urllib.request
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def read_pin():
+    pin = {}
+    with open(os.path.join(HERE, "openeebus.pin")) as f:
+        for line in f:
+            line = line.strip()
+            if line and not line.startswith("#") and "=" in line:
+                key, value = line.split("=", 1)
+                pin[key.strip()] = value.strip()
+    return pin["OPENEEBUS_COMMIT"], pin["OPENEEBUS_SHA256"]
+
+
+def patches():
+    directory = os.path.join(HERE, "patches")
+    return sorted(os.path.join(directory, name) for name in os.listdir(directory) if name.endswith(".patch"))
+
+
+def sha256(path):
+    digest = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 16), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def prepare(work_dir):
+    """Returns the path of the patched openeebus tree below `work_dir`."""
+    commit, checksum = read_pin()
+    src = os.path.join(work_dir, "openeebus-" + commit)
+    stamp_file = os.path.join(src, ".patches")
+    stamp = hashlib.sha256(b"".join(open(p, "rb").read() for p in patches())).hexdigest()
+
+    if os.path.isdir(src):
+        try:
+            if open(stamp_file).read() == stamp:
+                return src
+        except OSError:
+            pass
+        shutil.rmtree(src)
+
+    os.makedirs(work_dir, exist_ok=True)
+    tarball = os.path.join(work_dir, "openeebus-" + commit + ".tar.gz")
+    if not os.path.isfile(tarball) or sha256(tarball) != checksum:
+        url = "https://codeload.github.com/NIBEGroup/openeebus/tar.gz/" + commit
+        print("eebus: fetching openeebus " + commit, file=sys.stderr)
+        urllib.request.urlretrieve(url, tarball)
+        if sha256(tarball) != checksum:
+            os.remove(tarball)
+            raise RuntimeError("eebus: checksum of the openeebus tarball does not match openeebus.pin")
+
+    with tarfile.open(tarball) as tar:
+        tar.extractall(work_dir)
+    for patch in patches():
+        with open(patch, "rb") as f:
+            subprocess.run(["patch", "-d", src, "-p1", "--forward", "--silent"], stdin=f, check=True)
+    with open(stamp_file, "w") as f:
+        f.write(stamp)
+    return src
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    print(prepare(sys.argv[1]))
