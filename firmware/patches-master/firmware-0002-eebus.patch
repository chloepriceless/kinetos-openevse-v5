diff --git a/src/web_server_eebus.cpp b/src/web_server_eebus.cpp
new file mode 100644
index 00000000..5579f5c9
--- /dev/null
+++ b/src/web_server_eebus.cpp
@@ -0,0 +1,103 @@
+#if defined(ENABLE_DEBUG) && !defined(ENABLE_DEBUG_WEB)
+#undef ENABLE_DEBUG
+#endif
+
+#ifdef ENABLE_EEBUS
+
+#include "debug.h"
+#include "web_server.h"
+#include "eebus.h"
+
+// -------------------------------------------------------------------
+// EEBUS: state of the node, its SKI, the nodes found in the network
+// and the paired ones
+//
+// url: GET /eebus
+// -------------------------------------------------------------------
+void handleEebus(MongooseHttpServerRequest *request)
+{
+  MongooseHttpServerResponseStream *response;
+  if(false == requestPreProcess(request, response)) {
+    return;
+  }
+
+  if(HTTP_GET != request->method())
+  {
+    response->setCode(405);
+    response->print("{\"msg\":\"Method not allowed\"}");
+    request->send(response);
+    return;
+  }
+
+  DynamicJsonDocument doc(4096);
+  eebus.serialize(doc);
+  response->setCode(200);
+  serializeJson(doc, *response);
+  request->send(response);
+}
+
+// The SKI in a request body: 40 hex characters, on their own or as the
+// value in {"ski":"..."}
+static String skiFromBody(const String &body)
+{
+  int run = 0;
+  for(int i = 0; i <= (int)body.length(); i++)
+  {
+    if(i < (int)body.length() && isxdigit((unsigned char)body[i])) {
+      run++;
+      continue;
+    }
+    if(40 == run) {
+      return body.substring(i - 40, i);
+    }
+    run = 0;
+  }
+  return String();
+}
+
+// -------------------------------------------------------------------
+// EEBUS pairing
+//
+// url: POST /eebus/trust    pair with the node whose SKI is in the body
+//      POST /eebus/untrust  remove the pairing
+// -------------------------------------------------------------------
+void handleEebusTrust(MongooseHttpServerRequest *request)
+{
+  MongooseHttpServerResponseStream *response;
+  if(false == requestPreProcess(request, response)) {
+    return;
+  }
+
+  if(HTTP_POST != request->method())
+  {
+    response->setCode(405);
+    response->print("{\"msg\":\"Method not allowed\"}");
+    request->send(response);
+    return;
+  }
+
+  String path = request->uri();
+  bool trust = !path.endsWith("untrust");
+  String ski = skiFromBody(request->body().toString());
+  if(0 == ski.length())
+  {
+    response->setCode(400);
+    response->print("{\"msg\":\"expected an SKI of 40 hex characters\"}");
+    request->send(response);
+    return;
+  }
+  if(!eebus.trust(ski, trust))
+  {
+    response->setCode(409);
+    response->print("{\"msg\":\"too many paired nodes\"}");
+    request->send(response);
+    return;
+  }
+  DBUGF("EEBUS: %s %s", trust ? "trust" : "untrust", ski.c_str());
+
+  response->setCode(200);
+  response->print("{\"msg\":\"done\"}");
+  request->send(response);
+}
+
+#endif // ENABLE_EEBUS
