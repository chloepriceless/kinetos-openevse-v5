+// With a meter: MPC scenarios 1 to 4, and 5 if it also measures the frequency
+#define MPC_METER_CONFIG(frequency)                                                         \
+  {                                                                                         \
+    .power_cfg = {                                                                          \
+        .power_total_cfg   = {.value_source = kMeasurementValueSourceTypeMeasuredValue},    \
+        .power_phase_a_cfg = &kMeasured,                                                    \
+        .power_phase_b_cfg = &kMeasured,                                                    \
+        .power_phase_c_cfg = &kMeasured,                                                    \
+    },                                                                                      \
+    .energy_cfg = &kEnergyConfig, .current_cfg = &kCurrentConfig, .voltage_cfg = &kVoltageConfig, \
+    .frequency_cfg = (frequency),                                                           \
+  }
+
+static const MuMpcConfig kMpcMeter          = MPC_METER_CONFIG(NULL);
+static const MuMpcConfig kMpcMeterFrequency = MPC_METER_CONFIG(&kFrequencyConfig);
+
+// Without: total power and energy as the charger works them out
+static const MuMpcConfig kMpcBasic = {
+    .power_cfg = {
+        .power_total_cfg = {.value_source = kMeasurementValueSourceTypeCalculatedValue},
+    },
+    .energy_cfg = &kEnergyConfig,
+};
+
+static void PublishMeasurements(const EebusAppMeasurements* m) {
+  ScaledValue v = Scaled(m->power_w, 0);
+  MuMpcSetMeasurementDataCache(app.mu_mpc, kMpcPowerTotal, &v, NULL, NULL);
+  v = Scaled(m->energy_wh, 0);
+  MuMpcSetEnergyConsumedCache(app.mu_mpc, &v, NULL, NULL, NULL, NULL);
+  if (app.per_phase) {
+    static const MuMpcMeasurementNameId kPower[3]   = {kMpcPowerPhaseA, kMpcPowerPhaseB, kMpcPowerPhaseC};
+    static const MuMpcMeasurementNameId kCurrent[3] = {kMpcCurrentPhaseA, kMpcCurrentPhaseB, kMpcCurrentPhaseC};
+    static const MuMpcMeasurementNameId kVoltage[3] = {kMpcVoltagePhaseA, kMpcVoltagePhaseB, kMpcVoltagePhaseC};
+    for (size_t i = 0; i < 3; ++i) {
+      v = Scaled(m->phase_power_w[i], 0);
+      MuMpcSetMeasurementDataCache(app.mu_mpc, kPower[i], &v, NULL, NULL);
+      v = Scaled(m->current_a[i], 2);
+      MuMpcSetMeasurementDataCache(app.mu_mpc, kCurrent[i], &v, NULL, NULL);
+      v = Scaled(m->voltage_v[i], 1);
+      MuMpcSetMeasurementDataCache(app.mu_mpc, kVoltage[i], &v, NULL, NULL);
+    }
+    if (app.frequency) {
+      v = Scaled(m->frequency_hz, 2);
+      MuMpcSetMeasurementDataCache(app.mu_mpc, kMpcFrequency, &v, NULL, NULL);
+    }
+  }
+  MuMpcUpdate(app.mu_mpc);
+}
