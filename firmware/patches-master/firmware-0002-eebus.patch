diff --git a/test/test_eebus_limit_state/test_eebus_limit_state.cpp b/test/test_eebus_limit_state/test_eebus_limit_state.cpp
new file mode 100644
index 00000000..be2cac82
--- /dev/null
+++ b/test/test_eebus_limit_state/test_eebus_limit_state.cpp
@@ -0,0 +1,181 @@
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include "doctest.h"
+#include "../../eebus/app/eebus_limit_state.h"
+
+static const int64_t S = 1000;
+static const int64_t H = 3600 * S;
+
+// Failsafe 4200 W for 2 h, energy guard paired at t = 0
+static EebusLimitState paired() {
+  EebusLimitState s;
+  EebusLimitStateInit(&s, 4200, 7200, 0);
+  EebusLimitStateSetEnabled(&s, true, 0);
+  return s;
+}
+
+static bool limited(const EebusLimitState &s, double &w, int64_t &until) {
+  return EebusLimitStateEffective(&s, &w, &until);
+}
+
+TEST_CASE("without a paired energy guard nothing ever limits") {
+  EebusLimitState s;
+  EebusLimitStateInit(&s, 4200, 7200, 0);
+  CHECK(s.state == kEebusLimitDisabled);
+  CHECK_FALSE(EebusLimitStateEvaluate(&s, 10 * H));
+  CHECK(s.state == kEebusLimitDisabled);
+
+  // a limit written while disabled is remembered but not applied
+  EebusLimitStateOnLimit(&s, 3000, 3600, true, 10 * H);
+  double w; int64_t until;
+  CHECK_FALSE(limited(s, w, until));
+}
+
+TEST_CASE("init: heartbeat within 120 s leads to unlimited/controlled") {
+  EebusLimitState s = paired();
+  CHECK(s.state == kEebusLimitInit);
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 60 * S));
+  CHECK(s.state == kEebusLimitInit);
+  CHECK(EebusLimitStateOnHeartbeat(&s, true, 61 * S));
+  CHECK(s.state == kEebusLimitUnlimitedControlled);
+  double w; int64_t until;
+  CHECK_FALSE(limited(s, w, until));
+}
+
+TEST_CASE("init: 120 s without heartbeat leads to failsafe") {
+  EebusLimitState s = paired();
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 119 * S));
+  CHECK(EebusLimitStateOnHeartbeat(&s, false, 120 * S));
+  CHECK(s.state == kEebusLimitFailsafe);
+  double w; int64_t until;
+  CHECK(limited(s, w, until));
+  CHECK(w == 4200);
+  CHECK(until == 120 * S + 2 * H);
+}
+
+TEST_CASE("an active limit applies until its duration is over") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, true, 1 * S);
+  CHECK(EebusLimitStateOnLimit(&s, 4200, 7200, true, 10 * S));
+  CHECK(s.state == kEebusLimitLimited);
+  double w; int64_t until;
+  CHECK(limited(s, w, until));
+  CHECK(w == 4200);
+  CHECK(until == 10 * S + 2 * H);
+
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, true, 10 * S + 2 * H - 1));
+  CHECK(EebusLimitStateOnHeartbeat(&s, true, 10 * S + 2 * H));
+  CHECK(s.state == kEebusLimitUnlimitedControlled);
+  CHECK_FALSE(limited(s, w, until));
+}
+
+TEST_CASE("a limit without duration stays until it is lifted") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, true, 1 * S);
+  EebusLimitStateOnLimit(&s, 6000, 0, true, 10 * S);
+  double w; int64_t until;
+  EebusLimitStateOnHeartbeat(&s, true, 100 * H);
+  CHECK(limited(s, w, until));
+  CHECK(w == 6000);
+  CHECK(until == 0);
+
+  CHECK(EebusLimitStateOnLimit(&s, 6000, 0, false, 100 * H + S));
+  CHECK(s.state == kEebusLimitUnlimitedControlled);
+}
+
+TEST_CASE("a short outage of the energy guard does not trigger failsafe") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, true, 10 * S);
+  EebusLimitStateOnLimit(&s, 5000, 3600, true, 10 * S);
+  // connection drops, back after 100 s
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 20 * S));
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 115 * S));
+  CHECK(s.state == kEebusLimitLimited);
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, true, 120 * S));
+  CHECK(s.state == kEebusLimitLimited);
+}
+
+TEST_CASE("120 s without heartbeat: failsafe with the values the energy guard wrote") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, true, 10 * S);
+  EebusLimitStateOnFailsafeLimit(&s, 3000);
+  EebusLimitStateOnFailsafeDuration(&s, 3 * 3600);
+  EebusLimitStateOnLimit(&s, 5000, 3600, true, 10 * S);
+
+  // last sign of life at 10 s
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 129 * S));
+  CHECK(EebusLimitStateOnHeartbeat(&s, false, 130 * S));
+  CHECK(s.state == kEebusLimitFailsafe);
+  double w; int64_t until;
+  CHECK(limited(s, w, until));
+  CHECK(w == 3000);
+  CHECK(until == 130 * S + 3 * H);
+}
+
+TEST_CASE("failsafe ends after its duration: autonomous without, controlled with energy guard") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, false, 120 * S);
+  REQUIRE(s.state == kEebusLimitFailsafe);
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 120 * S + 2 * H - 1));
+  CHECK(EebusLimitStateOnHeartbeat(&s, false, 120 * S + 2 * H));
+  CHECK(s.state == kEebusLimitUnlimitedAutonomous);
+  double w; int64_t until;
+  CHECK_FALSE(limited(s, w, until));
+
+  // the energy guard comes back
+  CHECK(EebusLimitStateOnHeartbeat(&s, true, 5 * H));
+  CHECK(s.state == kEebusLimitUnlimitedControlled);
+}
+
+TEST_CASE("failsafe: the returning energy guard alone does not end it, a new limit does") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, false, 120 * S);
+  REQUIRE(s.state == kEebusLimitFailsafe);
+
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, true, 200 * S));
+  CHECK(s.state == kEebusLimitFailsafe);
+
+  CHECK(EebusLimitStateOnLimit(&s, 7000, 3600, true, 210 * S));
+  CHECK(s.state == kEebusLimitLimited);
+  double w; int64_t until;
+  CHECK(limited(s, w, until));
+  CHECK(w == 7000);
+
+  // an inactive limit ends it as well
+  EebusLimitState t = paired();
+  EebusLimitStateOnHeartbeat(&t, false, 120 * S);
+  EebusLimitStateOnHeartbeat(&t, true, 200 * S);
+  CHECK(EebusLimitStateOnLimit(&t, 0, 0, false, 210 * S));
+  CHECK(t.state == kEebusLimitUnlimitedControlled);
+}
+
+TEST_CASE("invalid failsafe values are ignored") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnFailsafeLimit(&s, -1);
+  EebusLimitStateOnFailsafeDuration(&s, 0);
+  CHECK(s.failsafe_w == 4200);
+  CHECK(s.failsafe_duration_s == 7200);
+  EebusLimitStateOnFailsafeLimit(&s, 0);
+  CHECK(s.failsafe_w == 0);
+}
+
+TEST_CASE("unpairing the energy guard lifts everything, pairing again starts at init") {
+  EebusLimitState s = paired();
+  EebusLimitStateOnHeartbeat(&s, false, 120 * S);
+  REQUIRE(s.state == kEebusLimitFailsafe);
+  CHECK(EebusLimitStateSetEnabled(&s, false, 130 * S));
+  double w; int64_t until;
+  CHECK_FALSE(limited(s, w, until));
+
+  CHECK(EebusLimitStateSetEnabled(&s, true, 140 * S));
+  CHECK(s.state == kEebusLimitInit);
+  // the 120 s count from the new pairing
+  CHECK_FALSE(EebusLimitStateOnHeartbeat(&s, false, 259 * S));
+  CHECK(EebusLimitStateOnHeartbeat(&s, false, 260 * S));
+  CHECK(s.state == kEebusLimitFailsafe);
+}
