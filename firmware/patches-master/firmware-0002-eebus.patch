index 00000000..4cf61973
--- /dev/null
+++ b/eebus/app/eebus_app.c
@@ -0,0 +1,937 @@
+/*
+ * EEBUS node of the wallbox, see eebus_app.h.
+ */
+#include "eebus_app.h"
+
+#include "eebus_cert.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+
+#include "src/common/array_util.h"
+#include "src/common/eebus_malloc.h"
+#include "src/common/eebus_mutex/eebus_mutex.h"
+#include "src/common/eebus_thread/eebus_thread.h"
+#include "src/common/vector.h"
+#include "src/service/api/service_reader_interface.h"
+#include "src/service/service/eebus_service.h"
+#include "src/ship/api/mdns_entry.h"
+#include "src/ship/tls_certificate/tls_certificate.h"
+#include "src/spine/api/device_local_interface.h"
+#include "src/spine/api/device_remote_interface.h"
+#include "src/spine/entity/entity_local.h"
+#include "src/use_case/actor/cs/cs_lp.h"
+#include "src/use_case/actor/cs/lpc/cs_lpc.h"
+#include "src/use_case/actor/mu/mpc/mu_mpc.h"
+#include "src/use_case/api/cs_lp_listener_interface.h"
+#include "src/use_case/api/cs_lpc_approver_interface.h"
+#include "src/use_case/api/mu_mpc_listener_interface.h"
+#include "src/use_case/model/scaled_value.h"
+
+static const uint32_t kHeartbeatTimeoutSeconds        = 60;
+static const ElectricalConnectionIdType kConnectionId = 0;
+
+static const int32_t kTickMs         = 250;
+static const int kTicksPerEvaluation = 4;
+static const size_t kWorkerStackSize = 10 * 1024;
+
+#define TRUST_OPS_MAX 8
+
+typedef struct TrustOp {
+  char ski[EEBUS_APP_SKI_LEN + 1];
+  bool trust;
+} TrustOp;
+
+typedef struct App {
+  ServiceReaderObject reader;  // must be first ("inherits" the reader)
+
+  bool started;
+  volatile bool stop;
+  volatile bool finished;
+  EebusThreadObject* thread;
+  EebusMutexObject* mutex;
+
+  // configuration (copies)
+  int32_t port;
+  char* cert_pem;
+  char* key_pem;
+  char* brand;
+  char* model;
+  char* serial;
+  double nominal_max_w;
+  bool per_phase;
+  bool frequency;
+
+  // openeebus objects, created and released by the worker thread
+  TlsCertificateObject* tls;
+  EebusServiceConfig* cfg;
+  EebusServiceObject* service;
+  CsLpUseCaseObject* cs_lpc;
+  MuMpcUseCaseObject* mu_mpc;
+
+  // everything below is guarded by `mutex`
+  EebusLimitState limit;
+  bool limit_announced_active;  // "isLimitActive" as the energy guard sees it
+  EebusAppStatus status;
+  EebusAppPeer peers[EEBUS_APP_MAX_PEERS];
+  size_t peer_count;
+  TrustOp ops[TRUST_OPS_MAX];
+  size_t op_count;
+  EebusAppMeasurements measurements;
+  bool measurements_dirty;
+} App;
+
+static App app;
+
+//-------------------------------------------------------------------------------------------//
+// Small helpers
+//-------------------------------------------------------------------------------------------//
+
+static int64_t NowMs(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static char* CopyString(const char* s) {
+  if (s == NULL) {
+    s = "";
+  }
+  const size_t len = strlen(s);
+  char* const copy = (char*)EEBUS_MALLOC(len + 1);
+  if (copy != NULL) {
+    memcpy(copy, s, len + 1);
+  }
+  return copy;
+}
+
+static void CopyField(char* dst, size_t dst_size, const char* src) {
+  snprintf(dst, dst_size, "%s", (src != NULL) ? src : "");
+}
+
+/** `value` with `decimals` digits after the point. */
+static ScaledValue Scaled(double value, int decimals) {
+  double factor = 1.0;
+  for (int i = 0; i < decimals; ++i) {
+    factor *= 10.0;
+  }
+  const ScaledValue sv = {.value = (int64_t)llround(value * factor), .scale = (int8_t)-decimals};
+  return sv;
+}
+
+static double ScaledToDouble(const ScaledValue* v) {
+  double d = 0.0;
+  if (v != NULL) {
+    ScaledValueToDouble(v, &d);
+  }
+  return d;
+}
+
+static int64_t DurationSeconds(const DurationType* d) {
+  return (d != NULL) ? EebusDurationToSeconds(d) : 0;
+}
+
+static EebusDuration SecondsToDuration(int64_t seconds) {
+  EebusDuration d = {0};
+  if (seconds < 0) {
+    seconds = 0;
+  }
+  d.hours   = (int32_t)(seconds / 3600);
+  d.minutes = (int32_t)((seconds % 3600) / 60);
+  d.seconds = (int32_t)(seconds % 60);
+  return d;
+}
+
+bool EebusAppSkiValid(const char* ski) {
+  if ((ski == NULL) || (strlen(ski) != EEBUS_APP_SKI_LEN)) {
+    return false;
+  }
+  for (size_t i = 0; i < EEBUS_APP_SKI_LEN; ++i) {
+    const char c = ski[i];
+    if (!(((c >= '0') && (c <= '9')) || ((c >= 'a') && (c <= 'f')) || ((c >= 'A') && (c <= 'F')))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/** Lower-case copy of a valid SKI. */
+static void SkiNormalize(char* dst, const char* ski) {
+  for (size_t i = 0; i < EEBUS_APP_SKI_LEN; ++i) {
+    const char c = ski[i];
+    dst[i]       = ((c >= 'A') && (c <= 'F')) ? (char)(c - 'A' + 'a') : c;
+  }
+  dst[EEBUS_APP_SKI_LEN] = '\0';
+}
+
+//-------------------------------------------------------------------------------------------//
+// Remote nodes (call with the mutex held)
+//-------------------------------------------------------------------------------------------//
+
+static EebusAppPeer* PeerFind(const char* ski) {
+  for (size_t i = 0; i < app.peer_count; ++i) {
+    if (strcasecmp(app.peers[i].ski, ski) == 0) {
+      return &app.peers[i];
+    }
+  }
+  return NULL;
+}
+
+static EebusAppPeer* PeerGet(const char* ski) {
+  if (!EebusAppSkiValid(ski)) {
+    return NULL;
+  }
+  EebusAppPeer* peer = PeerFind(ski);
+  if ((peer == NULL) && (app.peer_count < EEBUS_APP_MAX_PEERS)) {
+    peer = &app.peers[app.peer_count++];
+    memset(peer, 0, sizeof(*peer));
+    SkiNormalize(peer->ski, ski);
+  }
+  return peer;
+}
+
+/** Forget nodes that are neither paired nor present. */
+static void PeersCleanup(void) {
+  size_t kept = 0;
+  for (size_t i = 0; i < app.peer_count; ++i) {
+    const EebusAppPeer* const peer = &app.peers[i];
+    if (peer->trusted || peer->discovered || peer->connected) {
+      if (kept != i) {
+        app.peers[kept] = *peer;
+      }
+      ++kept;
+    }
+  }
+  app.peer_count = kept;
+}
+
+/** The node that limits the charger; "" for none. Enables the LPC state machine. */
+static void GuardSet(const char* ski) {
+  if (strcasecmp(app.status.guard_ski, ski) == 0) {
+    return;
+  }
+  CopyField(app.status.guard_ski, sizeof(app.status.guard_ski), ski);
+  ++app.status.persist_seq;
+  for (size_t i = 0; i < app.peer_count; ++i) {
+    app.peers[i].guard = (ski[0] != '\0') && (strcasecmp(app.peers[i].ski, ski) == 0);
+  }
+  EebusLimitStateSetEnabled(&app.limit, ski[0] != '\0', NowMs());
+}
+
+static void GuardSetIfTrusted(const char* ski) {
+  if (ski == NULL) {
+    return;
+  }
+  const EebusAppPeer* const peer = PeerFind(ski);
+  if ((peer != NULL) && peer->trusted) {
+    GuardSet(peer->ski);
+  }
+}
