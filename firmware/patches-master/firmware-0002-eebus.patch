diff --git a/eebus/port/eebus_cert.c b/eebus/port/eebus_cert.c
new file mode 100644
index 00000000..0b7e7321
--- /dev/null
+++ b/eebus/port/eebus_cert.c
@@ -0,0 +1,133 @@
+/*
+ * SHIP certificate generation with mbedTLS, see eebus_cert.h.
+ */
+#include "eebus_cert.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include <mbedtls/bignum.h>
+#include <mbedtls/ctr_drbg.h>
+#include <mbedtls/ecp.h>
+#include <mbedtls/entropy.h>
+#include <mbedtls/pem.h>
+#include <mbedtls/pk.h>
+#include <mbedtls/platform_util.h>
+#include <mbedtls/version.h>
+#include <mbedtls/x509_crt.h>
+
+// The device may not know the time when it creates its certificate, and SHIP
+// peers do not look at the dates of a self-signed certificate.
+static const char kNotBefore[] = "20250101000000";
+static const char kNotAfter[]  = "20991231235959";
+
+#define DER_BUF_SIZE 1024
+
+/** DER (written by mbedTLS at the end of `der`) to PEM. */
+static int ToPem(const char* header, const char* footer, const unsigned char* der, int der_len, char* pem, size_t pem_size) {
+  size_t olen = 0;
+  return mbedtls_pem_write_buffer(header, footer, der + DER_BUF_SIZE - der_len, (size_t)der_len, (unsigned char*)pem, pem_size, &olen);
+}
+
+int EebusCertGenerate(const char* common_name, char* cert_pem, size_t cert_pem_size, char* key_pem, size_t key_pem_size) {
+  int ret = -1;
+
+  // "CN=<name>,O=OpenEVSE": characters with a meaning in this syntax are dropped
+  char subject[96] = "CN=";
+  size_t n         = strlen(subject);
+  for (const char* p = (common_name != NULL) ? common_name : ""; (*p != '\0') && (n < 64); ++p) {
+    const char c = *p;
+    if (((c >= 'a') && (c <= 'z')) || ((c >= 'A') && (c <= 'Z')) || ((c >= '0') && (c <= '9')) || (c == ' ') || (c == '-')
+        || (c == '_') || (c == '.')) {
+      subject[n++] = c;
+    }
+  }
+  if (n == 3) {
+    subject[n++] = 'x';
+  }
+  strcpy(&subject[n], ",O=OpenEVSE");
+
+  mbedtls_entropy_context entropy;
+  mbedtls_ctr_drbg_context drbg;
+  mbedtls_pk_context key;
+  mbedtls_x509write_cert crt;
+  mbedtls_entropy_init(&entropy);
+  mbedtls_ctr_drbg_init(&drbg);
+  mbedtls_pk_init(&key);
+  mbedtls_x509write_crt_init(&crt);
+#if MBEDTLS_VERSION_NUMBER < 0x03040000
+  mbedtls_mpi serial;
+  mbedtls_mpi_init(&serial);
+#endif
+
+  unsigned char* const der = (unsigned char*)malloc(DER_BUF_SIZE);
+  if (der == NULL) {
+    goto done;
+  }
+
+  static const char kPersonal[] = "ship-cert";
+  if ((mbedtls_ctr_drbg_seed(&drbg, mbedtls_entropy_func, &entropy, (const unsigned char*)kPersonal, sizeof(kPersonal) - 1)
+       != 0)
+      || (mbedtls_pk_setup(&key, mbedtls_pk_info_from_type(MBEDTLS_PK_ECKEY)) != 0)
+      || (mbedtls_ecp_gen_key(MBEDTLS_ECP_DP_SECP256R1, mbedtls_pk_ec(key), mbedtls_ctr_drbg_random, &drbg) != 0)) {
+    goto done;
+  }
+
+  // Random positive serial number
+  unsigned char serial_raw[8];
+  if (mbedtls_ctr_drbg_random(&drbg, serial_raw, sizeof(serial_raw)) != 0) {
+    goto done;
+  }
+  serial_raw[0] = (unsigned char)((serial_raw[0] & 0x7F) | 0x01);
+#if MBEDTLS_VERSION_NUMBER < 0x03040000
+  if ((mbedtls_mpi_read_binary(&serial, serial_raw, sizeof(serial_raw)) != 0)
+      || (mbedtls_x509write_crt_set_serial(&crt, &serial) != 0)) {
+    goto done;
+  }
+#else
+  if (mbedtls_x509write_crt_set_serial_raw(&crt, serial_raw, sizeof(serial_raw)) != 0) {
+    goto done;
+  }
+#endif
+
+  mbedtls_x509write_crt_set_version(&crt, MBEDTLS_X509_CRT_VERSION_3);
+  mbedtls_x509write_crt_set_md_alg(&crt, MBEDTLS_MD_SHA256);
+  mbedtls_x509write_crt_set_subject_key(&crt, &key);
+  mbedtls_x509write_crt_set_issuer_key(&crt, &key);
+  if ((mbedtls_x509write_crt_set_subject_name(&crt, subject) != 0)
+      || (mbedtls_x509write_crt_set_issuer_name(&crt, subject) != 0)
+      || (mbedtls_x509write_crt_set_validity(&crt, kNotBefore, kNotAfter) != 0)
+      || (mbedtls_x509write_crt_set_basic_constraints(&crt, 1, -1) != 0)
+      || (mbedtls_x509write_crt_set_subject_key_identifier(&crt) != 0)
+      || (mbedtls_x509write_crt_set_key_usage(&crt, MBEDTLS_X509_KU_DIGITAL_SIGNATURE | MBEDTLS_X509_KU_KEY_CERT_SIGN) != 0)) {
+    goto done;
+  }
+
+  int len = mbedtls_x509write_crt_der(&crt, der, DER_BUF_SIZE, mbedtls_ctr_drbg_random, &drbg);
+  if ((len <= 0)
+      || (ToPem("-----BEGIN CERTIFICATE-----\n", "-----END CERTIFICATE-----\n", der, len, cert_pem, cert_pem_size) != 0)) {
+    goto done;
+  }
+
+  len = mbedtls_pk_write_key_der(&key, der, DER_BUF_SIZE);
+  if ((len <= 0)
+      || (ToPem("-----BEGIN EC PRIVATE KEY-----\n", "-----END EC PRIVATE KEY-----\n", der, len, key_pem, key_pem_size) != 0)) {
+    goto done;
+  }
+
+  ret = 0;
+
+done:
+  if (der != NULL) {
+    mbedtls_platform_zeroize(der, DER_BUF_SIZE);
+    free(der);
+  }
+#if MBEDTLS_VERSION_NUMBER < 0x03040000
+  mbedtls_mpi_free(&serial);
+#endif
+  mbedtls_x509write_crt_free(&crt);
+  mbedtls_pk_free(&key);
+  mbedtls_ctr_drbg_free(&drbg);
+  mbedtls_entropy_free(&entropy);
+  return ret;
+}
diff --git a/eebus/port/eebus_cert.h b/eebus/port/eebus_cert.h
new file mode 100644
index 00000000..a61531c9
--- /dev/null
+++ b/eebus/port/eebus_cert.h
@@ -0,0 +1,35 @@
+/*
+ * SHIP certificate of the wallbox.
+ *
+ * SHIP (EEBUS) identifies a node by the Subject Key Identifier (SKI) of its
+ * self-signed certificate: EC prime256v1, SHA-256 signature, SKI extension
+ * computed from the public key. The key pair is the identity the other side
+ * pairs with, so it is generated once and kept.
+ */
+#ifndef EEBUS_PORT_EEBUS_CERT_H_
+#define EEBUS_PORT_EEBUS_CERT_H_
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Enough for the certificate as well as for the key, PEM, including the terminating NUL. */
+#define EEBUS_CERT_PEM_MAX 1024
+
+/**
+ * Generate a key pair and the self-signed certificate for it.
+ *
+ * Both are written as NUL-terminated PEM. `common_name` is reduced to letters,
+ * digits, space, '-', '_' and '.'. Takes about a second on an ESP32.
+ *
+ * @return 0 on success
+ */
+int EebusCertGenerate(const char* common_name, char* cert_pem, size_t cert_pem_size, char* key_pem, size_t key_pem_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // EEBUS_PORT_EEBUS_CERT_H_
diff --git a/eebus/port/eebus_debug.c b/eebus/port/eebus_debug.c
new file mode 100644
index 00000000..aabd0066
--- /dev/null
+++ b/eebus/port/eebus_debug.c
@@ -0,0 +1,35 @@
+/*
+ * Debug output of openeebus (src/common/debug.h) without libwebsockets.
+ *
+ * Silent unless EEBUS_DEBUG_STDOUT is defined: on the wallbox stdout is the
+ * serial line to the EVSE controller and must stay clean.
+ */
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdio.h>
+
+#include "src/common/debug.h"
+
+void DebugPrintf(const char* format, ...) {
+#ifdef EEBUS_DEBUG_STDOUT
+  va_list args;
+  va_start(args, format);
+  vprintf(format, args);
+  va_end(args);
+#else
+  (void)format;
+#endif
+}
+
+void DebugHexdump(void* data, size_t data_size) {
+#ifdef EEBUS_DEBUG_STDOUT
+  const unsigned char* const bytes = (const unsigned char*)data;
+  for (size_t i = 0; i < data_size; ++i) {
+    printf("%02x%s", bytes[i], ((i % 16) == 15) ? "\n" : " ");
+  }
+  printf("\n");
+#else
+  (void)data;
+  (void)data_size;
+#endif
+}
diff --git a/eebus/port/ship_transport.c b/eebus/port/ship_transport.c
new file mode 100644
index 00000000..4cefd2d8
--- /dev/null
+++ b/eebus/port/ship_transport.c
@@ -0,0 +1,1454 @@
+/*
+ * SHIP transport for openeebus without libwebsockets.
+ *
+ * openeebus talks to the network through three small interfaces: the HTTP
+ * server (incoming SHIP connections), the websocket client creator (outgoing
+ * ones) and the websocket object both hand out. Upstream implements them with
+ * libwebsockets, which does not fit into the 4 MB flash of the wallbox next to
+ * the rest of the firmware. This file implements the same interfaces directly
+ * on BSD sockets with mbedTLS (already part of the firmware) and the small
+ * part of RFC 6455 that SHIP needs: binary messages, fragments, ping/pong,
+ * close.
+ *
+ * SHIP specifics:
+ *   - TLS 1.2, ECDHE-ECDSA, both sides present a self-signed certificate.
+ *     Nothing is verified against a CA; a node is identified by the Subject
+ *     Key Identifier (SKI) of its certificate, and openeebus decides whether
+ *     that SKI is trusted.
+ *   - websocket sub-protocol "ship".
+ *
+ * Threads: every connection has its own thread (TLS handshake, websocket
+ * handshake, then reading and writing). The object openeebus owns
+ * (ShipWebsocket) and the connection (ShipConn) are two allocations, because
+ * openeebus may destroy its object at any time, also from inside a callback,
+ * while the connection thread is still running. `ShipConn.mutex` (recursive)
+ * guards the link between the two and is held while calling into openeebus,
+ * so after `destruct` returned no further callback is made. Finished
+ * connections are joined and freed by Reap().
+ *
+ * Builds for ESP-IDF (lwIP sockets) and POSIX hosts (interop test).
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+
+#include <mbedtls/base64.h>
+#include <mbedtls/ctr_drbg.h>
+#include <mbedtls/entropy.h>
+#include <mbedtls/net_sockets.h>
+#include <mbedtls/pk.h>
+#include <mbedtls/sha1.h>
+#include <mbedtls/ssl.h>
+#include <mbedtls/version.h>
+#include <mbedtls/x509_crt.h>
+
+#ifdef ESP_PLATFORM
+#include <mdns.h>
+#endif
+
+#include "src/common/debug.h"
+#include "src/common/eebus_errors.h"
+#include "src/common/eebus_malloc.h"
+#include "src/common/eebus_mutex/eebus_mutex.h"
+#include "src/common/eebus_queue/eebus_queue.h"
+#include "src/common/eebus_thread/eebus_thread.h"
+#include "src/ship/api/http_server_interface.h"
+#include "src/ship/api/tls_certificate_interface.h"
+#include "src/ship/api/websocket_creator_interface.h"
+#include "src/ship/api/websocket_interface.h"
+#include "src/ship/tls_certificate/tls_certificate.h"
+#include "src/ship/websocket/http_server.h"
+#include "src/ship/websocket/websocket_client_creator.h"
+
+#ifndef SHIP_TRANSPORT_DEBUG
+#define SHIP_TRANSPORT_DEBUG 0
+#endif
+
+#if SHIP_TRANSPORT_DEBUG
+#define TRANSPORT_DEBUG_PRINTF(fmt, ...) DebugPrintf(fmt, ##__VA_ARGS__)
+#else
+#define TRANSPORT_DEBUG_PRINTF(fmt, ...)
+#endif
+
+/** Largest reassembled websocket message accepted from the peer. */
+#ifndef EEBUS_WEBSOCKET_MAX_INPUT_MSG_SIZE
+#define EEBUS_WEBSOCKET_MAX_INPUT_MSG_SIZE (64 * 1024)
+#endif
+
+/** Messages waiting to be written (an entry is a pointer and a size). */
+#ifndef SHIP_TRANSPORT_WRITE_QUEUE_SIZE
+#define SHIP_TRANSPORT_WRITE_QUEUE_SIZE 128
+#endif
+
+/** Incoming connections served at the same time; further ones are refused. */
+#ifndef SHIP_TRANSPORT_MAX_SERVER_CONNECTIONS
+#define SHIP_TRANSPORT_MAX_SERVER_CONNECTIONS 3
+#endif
+
+/** Stack of a connection thread: the ECDSA handshake is the deepest path. */
+#ifndef SHIP_TRANSPORT_CONN_STACK_SIZE
+#define SHIP_TRANSPORT_CONN_STACK_SIZE (10 * 1024)
+#endif
+
+#define WS_SUB_PROTOCOL "ship"
+#define WS_GUID "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
+
+/** Room in front of a queued payload for the websocket frame header. */
+#define WS_HEADER_MAX 14
+
+#define WS_OP_CONTINUATION 0x0
+#define WS_OP_TEXT 0x1
+#define WS_OP_BINARY 0x2
+#define WS_OP_CLOSE 0x8
+#define WS_OP_PING 0x9
+#define WS_OP_PONG 0xA
+
+#define HTTP_HEADER_MAX 2048
+
+static const int kHandshakeTimeoutMs = 20000;  // TLS and websocket handshake together
+static const int kIoTimeoutMs        = 10000;  // rest of a frame, or a blocked write
+static const int kIdlePollMs         = 20;     // wait for input before looking at the write queue again
+static const int kAcceptPollMs       = 250;
+
+static const int kCiphersuites[] = {
+    MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,
+    MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CCM_8,
+    MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256,
+    0,
+};
+
+typedef struct ShipConn ShipConn;
+typedef struct ShipWebsocket ShipWebsocket;
+typedef struct ShipServer ShipServer;
+
+typedef struct WriteMessage {
+  uint8_t* data;  // WS_HEADER_MAX bytes of headroom, then the payload
+  size_t size;    // payload size
+} WriteMessage;
+
+/** What openeebus holds (and frees after `destruct`). */
+struct ShipWebsocket {
+  WebsocketObject obj;
+  ShipConn* conn;
+  WebsocketCallback callback;
+  void* context;
+  volatile bool is_closed;
+  int32_t close_error;
+};
+
+/** A connection and its thread. */
+struct ShipConn {
+  ShipConn* next;  // list of all connections, see Reap()
+
+  bool is_server;
+  int fd;
+  volatile bool cancel;       // stop the thread (closed by the owner, or the server stops)
+  volatile bool done;         // thread function finished
+  volatile bool established;  // handed over to openeebus (or failed before that)
+  EebusThreadObject* thread;
+
+  EebusMutexObject* mutex;  // recursive, guards `ws`; held while calling into openeebus
+  ShipWebsocket* ws;
+  EebusQueueObject* wr_queue;
+
+  const TlsCertificateObject* tls_cert;
+  bool tls_ready;
+  mbedtls_ssl_context ssl;
+  mbedtls_ssl_config conf;
+  mbedtls_x509_crt crt;
+  mbedtls_pk_context key;
+  mbedtls_entropy_context entropy;
+  mbedtls_ctr_drbg_context drbg;
+
+  // incoming
+  ShipServer* server;
+
+  // outgoing
+  char* host;
+  char* path;
+  int port;
+  char* remote_ski;
+
+  // message being reassembled from fragments
+  uint8_t* rx_msg;
+  size_t rx_size;
+};
+
+struct ShipServer {
+  HttpServerObject obj;
+  int port;
+  const TlsCertificateObject* tls_cert;
+  WebsocketServerCallbackType conn_establish_cb;
+  void* conn_establish_ctx;
+  int listen_fd;
+  volatile bool cancel;
+  EebusThreadObject* thread;
+};
+
+//-------------------------------------------------------------------------------------------//
+// Small helpers
+//-------------------------------------------------------------------------------------------//
+
+static int64_t NowMs(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static char* StrDup(const char* s, size_t len) {
+  char* const copy = (char*)EEBUS_MALLOC(len + 1);
+  if (copy != NULL) {
+    memcpy(copy, s, len);
+    copy[len] = '\0';
+  }
+  return copy;
+}
+
+/** Non-blocking, and no waiting for more data before a small message is sent. */
+static void SocketSetup(int fd) {
+  const int flags = fcntl(fd, F_GETFL, 0);
+  fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+  const int on = 1;
+  setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on));
+#ifdef SO_NOSIGPIPE
+  setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
+#endif
+}
+
+/** Wait until the socket is readable (or writable). 1 ready, 0 timeout, -1 error. */
+static int WaitFd(int fd, bool for_write, int timeout_ms) {
+  fd_set set;
+  FD_ZERO(&set);
+  FD_SET(fd, &set);
+  struct timeval tv = {.tv_sec = timeout_ms / 1000, .tv_usec = (timeout_ms % 1000) * 1000};
+  const int n       = select(fd + 1, for_write ? NULL : &set, for_write ? &set : NULL, NULL, &tv);
+  if (n < 0) {
+    return (errno == EINTR) ? 0 : -1;
+  }
+  return n > 0 ? 1 : 0;
+}
+
+//-------------------------------------------------------------------------------------------//
+// All connections; finished ones are joined and freed here
+//-------------------------------------------------------------------------------------------//
+
+static EebusMutexObject* conns_mutex = NULL;
+static ShipConn* conns               = NULL;
+
+static bool ConnsLock(void) {
+  if (conns_mutex == NULL) {
+    // Created on first use, possibly from two threads at once.
+    EebusMutexObject* const created = EebusMutexCreate();
+    if (created == NULL) {
+      return false;
+    }
+    if (!__sync_bool_compare_and_swap(&conns_mutex, NULL, created)) {
+      EebusMutexDelete(created);
+    }
+  }
+  EEBUS_MUTEX_LOCK(conns_mutex);
+  return true;
+}
+
+static void ConnsUnlock(void) {
+  EEBUS_MUTEX_UNLOCK(conns_mutex);
+}
+
+static void ConnFree(ShipConn* conn) {
+  if (conn->thread != NULL) {
+    EEBUS_THREAD_JOIN(conn->thread);
+    EebusThreadDelete(conn->thread);
+  }
+  EebusQueueDelete(conn->wr_queue);
+  EebusMutexDelete(conn->mutex);
+  EEBUS_FREE(conn->host);
+  EEBUS_FREE(conn->path);
+  EEBUS_FREE(conn->remote_ski);
+  EEBUS_FREE(conn->rx_msg);
+  EEBUS_FREE(conn);
+}
+
+/** Free every connection whose thread has finished and that openeebus no longer holds. */
+static void Reap(void) {
+  if (!ConnsLock()) {
+    return;
+  }
+  ShipConn** link = &conns;
+  while (*link != NULL) {
+    ShipConn* const conn = *link;
+    // A running thread may hold its mutex for long (callback into openeebus),
+    // so only finished connections are looked at; their mutex is free except
+    // for the moment the owner lets go of the websocket.
+    bool unused = false;
+    if (conn->done) {
+      EEBUS_MUTEX_LOCK(conn->mutex);
+      unused = (conn->ws == NULL);
+      EEBUS_MUTEX_UNLOCK(conn->mutex);
+    }
+    if (unused) {
+      *link = conn->next;
+      ConnFree(conn);
+    } else {
+      link = &conn->next;
+    }
+  }
+  ConnsUnlock();
+}
+
+static void WriteMessageRelease(void* msg) {
+  WriteMessage* const wr = (WriteMessage*)msg;
+  if (wr != NULL) {
+    EEBUS_FREE(wr->data);
+    wr->data = NULL;
+  }
+}
+
+static ShipConn* ConnCreate(bool is_server, const TlsCertificateObject* tls_cert) {
+  ShipConn* const conn = (ShipConn*)EEBUS_MALLOC(sizeof(ShipConn));
+  if (conn == NULL) {
+    return NULL;
+  }
+  memset(conn, 0, sizeof(*conn));
+  conn->is_server = is_server;
+  conn->fd        = -1;
+  conn->tls_cert  = tls_cert;
+  conn->mutex     = EebusMutexCreateRecursive();
+  conn->wr_queue  = EebusQueueCreate(SHIP_TRANSPORT_WRITE_QUEUE_SIZE, sizeof(WriteMessage), WriteMessageRelease);
+  if ((conn->mutex == NULL) || (conn->wr_queue == NULL)) {
+    ConnFree(conn);
+    return NULL;
+  }
+  return conn;
+}
+
+static void* ConnThread(void* arg);
+
+/** Add the connection to the list and start its thread. */
+static bool ConnStart(ShipConn* conn) {
+  Reap();
+  if (!ConnsLock()) {
+    return false;
+  }
+  conn->thread = EebusThreadCreate(ConnThread, conn, SHIP_TRANSPORT_CONN_STACK_SIZE);
+  if (conn->thread != NULL) {
+    conn->next = conns;
+    conns      = conn;
+  }
+  ConnsUnlock();
+  return conn->thread != NULL;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Websocket object (ShipWebsocket)
+//-------------------------------------------------------------------------------------------//
+
+#define SHIP_WEBSOCKET(obj) ((ShipWebsocket*)(obj))
+
+static void WsDestruct(WebsocketObject* self) {
+  ShipWebsocket* const ws = SHIP_WEBSOCKET(self);
+  ShipConn* const conn    = ws->conn;
+  ws->is_closed           = true;
+  if (conn != NULL) {
+    // Waits for a callback that is running in the connection thread, unless
+    // this is that thread (recursive mutex).
+    EEBUS_MUTEX_LOCK(conn->mutex);
+    conn->ws     = NULL;
+    conn->cancel = true;
+    EEBUS_MUTEX_UNLOCK(conn->mutex);
+    ws->conn = NULL;
+  }
+}
+
+static int32_t WsWrite(WebsocketObject* self, const uint8_t* msg, size_t msg_size) {
+  ShipWebsocket* const ws = SHIP_WEBSOCKET(self);
+  if (ws->is_closed || (ws->conn == NULL) || (msg == NULL) || (msg_size == 0)) {
+    return 0;
+  }
+  WriteMessage wr = {.data = (uint8_t*)EEBUS_MALLOC(WS_HEADER_MAX + msg_size), .size = msg_size};
+  if (wr.data == NULL) {
+    return 0;
+  }
+  memcpy(wr.data + WS_HEADER_MAX, msg, msg_size);
+  if (EEBUS_QUEUE_SEND(ws->conn->wr_queue, &wr, 0) != kEebusErrorOk) {
+    EEBUS_FREE(wr.data);
+    return 0;
+  }
+  return (int32_t)msg_size;
+}
+
+static void WsClose(WebsocketObject* self, int32_t close_code, const char* reason) {
+  (void)reason;
+  ShipWebsocket* const ws = SHIP_WEBSOCKET(self);
+  ws->close_error         = close_code;
+  ws->is_closed           = true;
+  if (ws->conn != NULL) {
+    // The thread flushes what is queued, sends the close frame and ends.
+    ws->conn->cancel = true;
+  }
+}
+
+static bool WsIsClosed(const WebsocketObject* self) {
+  return SHIP_WEBSOCKET(self)->is_closed;
+}
+
+static int32_t WsGetCloseError(const WebsocketObject* self) {
+  return SHIP_WEBSOCKET(self)->close_error;
+}
+
+static void WsScheduleWrite(WebsocketObject* self) {
+  (void)self;  // the connection thread looks at the queue on its own
+}
+
+static const WebsocketInterface ship_websocket_methods = {
+    .destruct        = WsDestruct,
+    .write           = WsWrite,
+    .close           = WsClose,
+    .is_closed       = WsIsClosed,
+    .get_close_error = WsGetCloseError,
+    .schedule_write  = WsScheduleWrite,
+};
+
+static ShipWebsocket* WsCreate(ShipConn* conn, WebsocketCallback cb, void* ctx) {
+  ShipWebsocket* const ws = (ShipWebsocket*)EEBUS_MALLOC(sizeof(ShipWebsocket));
+  if (ws == NULL) {
+    return NULL;
+  }
+  ws->obj.interface_ = &ship_websocket_methods;
+  ws->conn           = conn;
+  ws->callback       = cb;
+  ws->context        = ctx;
+  ws->is_closed      = false;
+  ws->close_error    = 0;
+  EEBUS_MUTEX_LOCK(conn->mutex);
+  conn->ws = ws;
+  EEBUS_MUTEX_UNLOCK(conn->mutex);
+  return ws;
+}
+
+/** Callback into openeebus, unless it closed or destroyed the websocket already. */
+static void ConnNotify(ShipConn* conn, WebsocketCallbackType type, const void* in, size_t size) {
+  EEBUS_MUTEX_LOCK(conn->mutex);
+  ShipWebsocket* const ws = conn->ws;
+  if ((ws != NULL) && !ws->is_closed) {
+    if (type != kWebsocketCallbackTypeRead) {
+      ws->is_closed = true;
+    }
+    if (ws->callback != NULL) {
+      ws->callback(type, in, size, ws->context);
+    }
+  }
+  EEBUS_MUTEX_UNLOCK(conn->mutex);
+}
+
+//-------------------------------------------------------------------------------------------//
+// TLS
+//-------------------------------------------------------------------------------------------//
+
+static int BioSend(void* ctx, const unsigned char* buf, size_t len) {
+  const int fd = ((ShipConn*)ctx)->fd;
+#ifdef MSG_NOSIGNAL
+  const int n = (int)send(fd, buf, len, MSG_NOSIGNAL);
+#else
+  const int n = (int)send(fd, buf, len, 0);
+#endif
+  if (n < 0) {
+    if ((errno == EAGAIN) || (errno == EWOULDBLOCK) || (errno == EINTR)) {
+      return MBEDTLS_ERR_SSL_WANT_WRITE;
+    }
+    return MBEDTLS_ERR_NET_SEND_FAILED;
+  }
+  return n;
+}
+
+static int BioRecv(void* ctx, unsigned char* buf, size_t len) {
+  const int fd = ((ShipConn*)ctx)->fd;
+  const int n  = (int)recv(fd, buf, len, 0);
+  if (n < 0) {
+    if ((errno == EAGAIN) || (errno == EWOULDBLOCK) || (errno == EINTR)) {
+      return MBEDTLS_ERR_SSL_WANT_READ;
+    }
+    return MBEDTLS_ERR_NET_RECV_FAILED;
+  }
+  return n;  // 0: the peer closed the connection
+}
+
+static bool TlsSetup(ShipConn* conn) {
+  mbedtls_ssl_init(&conn->ssl);
+  mbedtls_ssl_config_init(&conn->conf);
+  mbedtls_x509_crt_init(&conn->crt);
+  mbedtls_pk_init(&conn->key);
+  mbedtls_entropy_init(&conn->entropy);
+  mbedtls_ctr_drbg_init(&conn->drbg);
+  conn->tls_ready = true;
+
+  static const char kPersonal[] = "ship";
+  if (mbedtls_ctr_drbg_seed(
+          &conn->drbg,
+          mbedtls_entropy_func,
+          &conn->entropy,
+          (const unsigned char*)kPersonal,
+          sizeof(kPersonal) - 1
+      )
+      != 0) {
+    return false;
+  }
+
+  const unsigned char* const cert = (const unsigned char*)TLS_CERTIFICATE_GET_CERTIFICATE(conn->tls_cert);
+  const size_t cert_size          = TLS_CERTIFICATE_GET_CERTIFICATE_SIZE(conn->tls_cert);
+  const unsigned char* const key  = (const unsigned char*)TLS_CERTIFICATE_GET_PRIVATE_KEY(conn->tls_cert);
+  const size_t key_size           = TLS_CERTIFICATE_GET_PRIVATE_KEY_SIZE(conn->tls_cert);
+  if (mbedtls_x509_crt_parse_der(&conn->crt, cert, cert_size) != 0) {
+    return false;
+  }
+#if MBEDTLS_VERSION_MAJOR >= 3
+  if (mbedtls_pk_parse_key(&conn->key, key, key_size, NULL, 0, mbedtls_ctr_drbg_random, &conn->drbg) != 0) {
+#else
+  if (mbedtls_pk_parse_key(&conn->key, key, key_size, NULL, 0) != 0) {
+#endif
+    return false;
+  }
+
+  if (mbedtls_ssl_config_defaults(
+          &conn->conf,
+          conn->is_server ? MBEDTLS_SSL_IS_SERVER : MBEDTLS_SSL_IS_CLIENT,
+          MBEDTLS_SSL_TRANSPORT_STREAM,
+          MBEDTLS_SSL_PRESET_DEFAULT
+      )
+      != 0) {
+    return false;
+  }
+  // "Optional": the peer's certificate is requested and kept, the handshake
+  // goes on although no CA vouches for it. Its SKI is checked afterwards.
+  mbedtls_ssl_conf_authmode(&conn->conf, MBEDTLS_SSL_VERIFY_OPTIONAL);
+  mbedtls_ssl_conf_rng(&conn->conf, mbedtls_ctr_drbg_random, &conn->drbg);
+  mbedtls_ssl_conf_min_version(&conn->conf, MBEDTLS_SSL_MAJOR_VERSION_3, MBEDTLS_SSL_MINOR_VERSION_3);
+  mbedtls_ssl_conf_max_version(&conn->conf, MBEDTLS_SSL_MAJOR_VERSION_3, MBEDTLS_SSL_MINOR_VERSION_3);
+  mbedtls_ssl_conf_ciphersuites(&conn->conf, kCiphersuites);
+  if (mbedtls_ssl_conf_own_cert(&conn->conf, &conn->crt, &conn->key) != 0) {
+    return false;
+  }
+  if (mbedtls_ssl_setup(&conn->ssl, &conn->conf) != 0) {
+    return false;
+  }
+  mbedtls_ssl_set_bio(&conn->ssl, conn, BioSend, BioRecv, NULL);
+  return true;
+}
+
+static void TlsFree(ShipConn* conn) {
+  if (!conn->tls_ready) {
+    return;
+  }
+  mbedtls_ssl_free(&conn->ssl);
+  mbedtls_ssl_config_free(&conn->conf);
+  mbedtls_x509_crt_free(&conn->crt);
+  mbedtls_pk_free(&conn->key);
+  mbedtls_ctr_drbg_free(&conn->drbg);
+  mbedtls_entropy_free(&conn->entropy);
+  conn->tls_ready = false;
+}
+
+/** Wait for the socket as mbedTLS asked. False on timeout or error. */
+static bool TlsWait(ShipConn* conn, int ret, int64_t deadline) {
+  const int64_t left = deadline - NowMs();
+  if (left <= 0) {
+    return false;
+  }
+  const int step = left > 250 ? 250 : (int)left;  // so that `cancel` is noticed
+  return WaitFd(conn->fd, ret == MBEDTLS_ERR_SSL_WANT_WRITE, step) >= 0;
+}
+
+static bool TlsHandshake(ShipConn* conn, int64_t deadline) {
+  while (!conn->cancel) {
+    const int ret = mbedtls_ssl_handshake(&conn->ssl);
+    if (ret == 0) {
+      return true;
+    }
+    if ((ret != MBEDTLS_ERR_SSL_WANT_READ) && (ret != MBEDTLS_ERR_SSL_WANT_WRITE)) {
+      TRANSPORT_DEBUG_PRINTF("ship transport: TLS handshake failed: -0x%04x\n", (unsigned)-ret);
+      return false;
+    }
+    if (!TlsWait(conn, ret, deadline)) {
+      return false;
+    }
+  }
+  return false;
+}
+
+/** SKI of the peer's certificate (caller frees with EEBUS_FREE), NULL without certificate. */
+static char* TlsPeerSki(ShipConn* conn) {
+  const mbedtls_x509_crt* const peer = mbedtls_ssl_get_peer_cert(&conn->ssl);
+  if ((peer == NULL) || (peer->raw.p == NULL) || (peer->raw.len == 0)) {
+    return NULL;
+  }
+  return (char*)TlsCertificateCalcPublicKeySki(peer->raw.p, peer->raw.len);
+}
+
+/**
+ * Read up to `len` bytes. Returns the number read, 0 when nothing arrived
+ * within `timeout_ms`, -1 when the connection is gone.
+ */
+static int TlsReadSome(ShipConn* conn, uint8_t* buf, size_t len, int timeout_ms) {
+  const int64_t deadline = NowMs() + timeout_ms;
+  for (;;) {
+    const int ret = mbedtls_ssl_read(&conn->ssl, buf, len);
+    if (ret > 0) {
+      return ret;
+    }
+    if ((ret != MBEDTLS_ERR_SSL_WANT_READ) && (ret != MBEDTLS_ERR_SSL_WANT_WRITE)) {
+      return -1;  // closed by the peer (0, close notify) or broken
+    }
+    const int64_t left = deadline - NowMs();
+    if (left <= 0) {
+      return 0;
+    }
+    if (WaitFd(conn->fd, ret == MBEDTLS_ERR_SSL_WANT_WRITE, left > 250 ? 250 : (int)left) < 0) {
+      return -1;
+    }
+    if (conn->cancel && (timeout_ms > kIdlePollMs)) {
+      return -1;
+    }
+  }
+}
+
+/** Read exactly `len` bytes before `deadline`. */
+static bool TlsReadFull(ShipConn* conn, uint8_t* buf, size_t len, int64_t deadline) {
+  size_t got = 0;
+  while (got < len) {
+    const int64_t left = deadline - NowMs();
+    if (left <= 0) {
+      return false;
+    }
+    const int n = TlsReadSome(conn, buf + got, len - got, (int)left);
+    if (n <= 0) {
+      return false;
+    }
+    got += (size_t)n;
+  }
+  return true;
+}
+
+static bool TlsWriteAll(ShipConn* conn, const uint8_t* buf, size_t len) {
+  const int64_t deadline = NowMs() + kIoTimeoutMs;
+  size_t sent            = 0;
+  while (sent < len) {
+    const int ret = mbedtls_ssl_write(&conn->ssl, buf + sent, len - sent);
+    if (ret > 0) {
+      sent += (size_t)ret;
+      continue;
+    }
+    if ((ret != MBEDTLS_ERR_SSL_WANT_READ) && (ret != MBEDTLS_ERR_SSL_WANT_WRITE)) {
+      return false;
+    }
+    if (!TlsWait(conn, ret, deadline)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Websocket handshake (RFC 6455, section 4)
+//-------------------------------------------------------------------------------------------//
+
+/** Read an HTTP header block, byte by byte so that nothing after it is consumed. */
+static bool HttpReadHeader(ShipConn* conn, char* buf, size_t buf_size, int64_t deadline) {
+  size_t len = 0;
+  while (len + 1 < buf_size) {
+    if (!TlsReadFull(conn, (uint8_t*)&buf[len], 1, deadline)) {
+      return false;
+    }
+    ++len;
+    if ((len >= 4) && (memcmp(&buf[len - 4], "\r\n\r\n", 4) == 0)) {
+      buf[len] = '\0';
+      return true;
+    }
+  }
+  return false;
+}
+
+/** Value of a header (case-insensitive name), trimmed, copied into `value`. */
+static bool HttpHeaderValue(const char* header, const char* name, char* value, size_t value_size) {
+  const size_t name_len = strlen(name);
+  const char* line      = strstr(header, "\r\n");
+  while (line != NULL) {
+    line += 2;
+    if ((strncasecmp(line, name, name_len) == 0) && (line[name_len] == ':')) {
+      const char* start = line + name_len + 1;
+      while ((*start == ' ') || (*start == '\t')) {
+        ++start;
+      }
+      const char* end = strstr(start, "\r\n");
+      if (end == NULL) {
+        return false;
+      }
+      while ((end > start) && ((end[-1] == ' ') || (end[-1] == '\t'))) {
+        --end;
+      }
+      const size_t len = (size_t)(end - start);
+      if (len >= value_size) {
+        return false;
+      }
+      memcpy(value, start, len);
+      value[len] = '\0';
+      return true;
+    }
+    line = strstr(line, "\r\n");
+  }
+  return false;
+}
+
+/** Sec-WebSocket-Accept for a Sec-WebSocket-Key. */
+static bool WsAcceptKey(const char* key, char* accept, size_t accept_size) {
+  char input[128];
+  const int n = snprintf(input, sizeof(input), "%s%s", key, WS_GUID);
+  if ((n <= 0) || ((size_t)n >= sizeof(input))) {
+    return false;
+  }
+  unsigned char sha1[20];
+#if MBEDTLS_VERSION_MAJOR >= 3
+  if (mbedtls_sha1((const unsigned char*)input, (size_t)n, sha1) != 0) {
+#else
+  if (mbedtls_sha1_ret((const unsigned char*)input, (size_t)n, sha1) != 0) {
+#endif
+    return false;
+  }
+  size_t olen = 0;
+  if (mbedtls_base64_encode((unsigned char*)accept, accept_size, &olen, sha1, sizeof(sha1)) != 0) {
+    return false;
+  }
+  accept[olen] = '\0';
+  return true;
+}
+
+static bool WsServerHandshake(ShipConn* conn, int64_t deadline) {
+  char* const header = (char*)EEBUS_MALLOC(HTTP_HEADER_MAX);
+  if (header == NULL) {
+    return false;
+  }
+  bool ok = false;
+  char key[64];
+  char value[128];
+  char accept[40];
+  char response[256];
+  if (HttpReadHeader(conn, header, HTTP_HEADER_MAX, deadline) && (strncmp(header, "GET ", 4) == 0)
+      && HttpHeaderValue(header, "Upgrade", value, sizeof(value)) && (strcasecmp(value, "websocket") == 0)
+      && HttpHeaderValue(header, "Sec-WebSocket-Key", key, sizeof(key)) && WsAcceptKey(key, accept, sizeof(accept))) {
+    // A client that names sub-protocols has to offer "ship".
+    const bool names_protocol = HttpHeaderValue(header, "Sec-WebSocket-Protocol", value, sizeof(value));
+    if (!names_protocol || (strstr(value, WS_SUB_PROTOCOL) != NULL)) {
+      const int n = snprintf(
+          response,
+          sizeof(response),
+          "HTTP/1.1 101 Switching Protocols\r\n"
+          "Upgrade: websocket\r\n"
+          "Connection: Upgrade\r\n"
+          "Sec-WebSocket-Accept: %s\r\n"
+          "%s"
+          "\r\n",
+          accept,
+          names_protocol ? "Sec-WebSocket-Protocol: " WS_SUB_PROTOCOL "\r\n" : ""
+      );
+      ok = (n > 0) && ((size_t)n < sizeof(response)) && TlsWriteAll(conn, (const uint8_t*)response, (size_t)n);
+    }
+  }
+  EEBUS_FREE(header);
+  return ok;
+}
+
+static bool WsClientHandshake(ShipConn* conn, int64_t deadline) {
+  unsigned char nonce[16];
+  char key[32];
+  char accept[40];
+  char value[64];
+  size_t olen = 0;
+  if ((mbedtls_ctr_drbg_random(&conn->drbg, nonce, sizeof(nonce)) != 0)
+      || (mbedtls_base64_encode((unsigned char*)key, sizeof(key), &olen, nonce, sizeof(nonce)) != 0)) {
+    return false;
+  }
+  key[olen] = '\0';
+  if (!WsAcceptKey(key, accept, sizeof(accept))) {
+    return false;
+  }
+
+  char* const header = (char*)EEBUS_MALLOC(HTTP_HEADER_MAX);
+  if (header == NULL) {
+    return false;
+  }
+  bool ok     = false;
+  const int n = snprintf(
+      header,
+      HTTP_HEADER_MAX,
+      "GET %s HTTP/1.1\r\n"
+      "Host: %s:%d\r\n"
+      "Upgrade: websocket\r\n"
+      "Connection: Upgrade\r\n"
+      "Sec-WebSocket-Key: %s\r\n"
+      "Sec-WebSocket-Protocol: " WS_SUB_PROTOCOL "\r\n"
+      "Sec-WebSocket-Version: 13\r\n"
+      "\r\n",
+      conn->path,
+      conn->host,
+      conn->port,
+      key
+  );
+  if ((n > 0) && (n < HTTP_HEADER_MAX) && TlsWriteAll(conn, (const uint8_t*)header, (size_t)n)
+      && HttpReadHeader(conn, header, HTTP_HEADER_MAX, deadline) && (strncmp(header, "HTTP/1.1 101", 12) == 0)
+      && HttpHeaderValue(header, "Sec-WebSocket-Accept", value, sizeof(value)) && (strcmp(value, accept) == 0)) {
+    ok = true;
+  }
+  EEBUS_FREE(header);
+  return ok;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Websocket frames (RFC 6455, section 5)
+//-------------------------------------------------------------------------------------------//
+
+/**
+ * Send one frame. `payload` needs WS_HEADER_MAX writable bytes in front of it;
+ * a client masks the payload in place.
+ */
+static bool WsSendFrame(ShipConn* conn, uint8_t opcode, uint8_t* payload, size_t size) {
+  uint8_t header[WS_HEADER_MAX];
+  size_t n    = 0;
+  header[n++] = (uint8_t)(0x80 | opcode);  // FIN, no fragmentation on our side
+  const uint8_t mask_bit = conn->is_server ? 0x00 : 0x80;
+  if (size < 126) {
+    header[n++] = (uint8_t)(mask_bit | size);
+  } else if (size <= 0xFFFF) {
+    header[n++] = (uint8_t)(mask_bit | 126);
+    header[n++] = (uint8_t)(size >> 8);
+    header[n++] = (uint8_t)size;
+  } else {
+    header[n++] = (uint8_t)(mask_bit | 127);
+    for (int shift = 56; shift >= 0; shift -= 8) {
+      header[n++] = (uint8_t)((uint64_t)size >> shift);
+    }
+  }
+  if (!conn->is_server) {
+    uint8_t mask[4];
+    if (mbedtls_ctr_drbg_random(&conn->drbg, mask, sizeof(mask)) != 0) {
+      return false;
+    }
+    memcpy(&header[n], mask, sizeof(mask));
+    n += sizeof(mask);
+    for (size_t i = 0; i < size; ++i) {
+      payload[i] ^= mask[i & 3];
+    }
+  }
+  uint8_t* const frame = payload - n;
+  memcpy(frame, header, n);
+  return TlsWriteAll(conn, frame, n + size);
+}
+
+static bool WsSendControl(ShipConn* conn, uint8_t opcode, const uint8_t* payload, size_t size) {
+  uint8_t buf[WS_HEADER_MAX + 125];
+  if (size > 125) {
+    size = 125;
+  }
+  if (size > 0) {
+    memcpy(buf + WS_HEADER_MAX, payload, size);
+  }
+  return WsSendFrame(conn, opcode, buf + WS_HEADER_MAX, size);
+}
+
+static void WsSendClose(ShipConn* conn, int32_t code) {
+  const uint16_t status   = ((code >= 1000) && (code <= 4999)) ? (uint16_t)code : 1000;
+  const uint8_t payload[] = {(uint8_t)(status >> 8), (uint8_t)status};
+  WsSendControl(conn, WS_OP_CLOSE, payload, sizeof(payload));
+}
+
+static void RxRelease(ShipConn* conn) {
+  EEBUS_FREE(conn->rx_msg);
+  conn->rx_msg  = NULL;
+  conn->rx_size = 0;
+}
+
+/**
+ * Read one frame if one is coming in. Returns 1 when a frame was handled, 0
+ * when there was no input, -1 when the connection has to be closed.
+ */
+static int WsReadFrame(ShipConn* conn) {
+  uint8_t head[2];
+  const int first = TlsReadSome(conn, head, 1, kIdlePollMs);
+  if (first <= 0) {
+    return first;
+  }
+  const int64_t deadline = NowMs() + kIoTimeoutMs;
+  if (!TlsReadFull(conn, &head[1], 1, deadline)) {
+    return -1;
+  }
+  const bool fin       = (head[0] & 0x80) != 0;
+  const uint8_t opcode = head[0] & 0x0F;
+  const bool masked    = (head[1] & 0x80) != 0;
+  uint64_t size        = head[1] & 0x7F;
+  if ((head[0] & 0x70) != 0) {
+    return -1;  // extensions were not negotiated
+  }
+  if (size == 126) {
+    uint8_t ext[2];
+    if (!TlsReadFull(conn, ext, sizeof(ext), deadline)) {
+      return -1;
+    }
+    size = ((uint64_t)ext[0] << 8) | ext[1];
+  } else if (size == 127) {
+    uint8_t ext[8];
+    if (!TlsReadFull(conn, ext, sizeof(ext), deadline)) {
+      return -1;
+    }
+    size = 0;
+    for (size_t i = 0; i < sizeof(ext); ++i) {
+      size = (size << 8) | ext[i];
+    }
+  }
+  uint8_t mask[4] = {0, 0, 0, 0};
+  if (masked && !TlsReadFull(conn, mask, sizeof(mask), deadline)) {
+    return -1;
+  }
+
+  if (opcode >= WS_OP_CLOSE) {
+    // Control frames are short and never fragmented.
+    uint8_t payload[125];
+    if ((size > sizeof(payload)) || !fin) {
+      return -1;
+    }
+    if ((size > 0) && !TlsReadFull(conn, payload, (size_t)size, deadline)) {
+      return -1;
+    }
+    for (size_t i = 0; masked && (i < size); ++i) {
+      payload[i] ^= mask[i & 3];
+    }
+    if (opcode == WS_OP_PING) {
+      return WsSendControl(conn, WS_OP_PONG, payload, (size_t)size) ? 1 : -1;
+    }
+    if (opcode == WS_OP_CLOSE) {
+      WsSendControl(conn, WS_OP_CLOSE, payload, size >= 2 ? 2 : 0);
+      return -1;
+    }
+    return 1;  // pong
+  }
+
+  const bool is_start = (opcode == WS_OP_BINARY) || (opcode == WS_OP_TEXT);
+  if ((!is_start && (opcode != WS_OP_CONTINUATION)) || (is_start && (conn->rx_msg != NULL))
+      || (!is_start && (conn->rx_msg == NULL))) {
+    return -1;
+  }
+  if ((size > EEBUS_WEBSOCKET_MAX_INPUT_MSG_SIZE) || (conn->rx_size > EEBUS_WEBSOCKET_MAX_INPUT_MSG_SIZE - size)) {
+    return -1;
+  }
+
+  const size_t new_size  = conn->rx_size + (size_t)size;
+  uint8_t* const new_msg = (uint8_t*)EEBUS_MALLOC(new_size > 0 ? new_size : 1);
+  if (new_msg == NULL) {
+    return -1;
+  }
+  if (conn->rx_size > 0) {
+    memcpy(new_msg, conn->rx_msg, conn->rx_size);
+  }
+  uint8_t* const part = new_msg + conn->rx_size;
+  EEBUS_FREE(conn->rx_msg);
+  conn->rx_msg  = new_msg;
+  conn->rx_size = new_size;
+  if ((size > 0) && !TlsReadFull(conn, part, (size_t)size, deadline)) {
+    return -1;
+  }
+  for (size_t i = 0; masked && (i < size); ++i) {
+    part[i] ^= mask[i & 3];
+  }
+
+  if (fin) {
+    ConnNotify(conn, kWebsocketCallbackTypeRead, conn->rx_msg, conn->rx_size);
+    RxRelease(conn);
+  }
+  return 1;
+}
+
+/** Write what openeebus queued. False when the connection broke. */
+static bool WsFlush(ShipConn* conn) {
+  WriteMessage wr = {0};
+  while (EEBUS_QUEUE_RECEIVE(conn->wr_queue, &wr, 0) == kEebusErrorOk) {
+    const bool ok = WsSendFrame(conn, WS_OP_BINARY, wr.data + WS_HEADER_MAX, wr.size);
+    EEBUS_FREE(wr.data);
+    if (!ok) {
+      return false;
+    }
+  }
+  return true;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Connection thread
+//-------------------------------------------------------------------------------------------//
+
+static int32_t ConnCloseCode(ShipConn* conn) {
+  EEBUS_MUTEX_LOCK(conn->mutex);
+  const int32_t code = (conn->ws != NULL) ? conn->ws->close_error : 0;
+  EEBUS_MUTEX_UNLOCK(conn->mutex);
+  return code;
+}
+
+/** Outgoing connection: resolve the host and connect. */
+static bool ConnConnect(ShipConn* conn, int64_t deadline) {
+  struct sockaddr_in addr;
+  memset(&addr, 0, sizeof(addr));
+  addr.sin_family = AF_INET;
+  addr.sin_port   = htons((uint16_t)conn->port);
+
+  if (inet_pton(AF_INET, conn->host, &addr.sin_addr) != 1) {
+    bool resolved = false;
+#ifdef ESP_PLATFORM
+    // The resolver of lwIP does not ask mDNS for ".local" names.
+    const size_t host_len = strlen(conn->host);
+    if ((host_len > 6) && (strcasecmp(conn->host + host_len - 6, ".local") == 0)) {
+      char name[64];
+      if (host_len - 6 < sizeof(name)) {
+        memcpy(name, conn->host, host_len - 6);
+        name[host_len - 6] = '\0';
+        esp_ip4_addr_t ip  = {0};
+        if (mdns_query_a(name, 2000, &ip) == ESP_OK) {
+          addr.sin_addr.s_addr = ip.addr;
+          resolved             = true;
+        }
+      }
+    }
+#endif
+    if (!resolved) {
+      struct addrinfo hints;
+      memset(&hints, 0, sizeof(hints));
+      hints.ai_family       = AF_INET;
+      hints.ai_socktype     = SOCK_STREAM;
+      struct addrinfo* info = NULL;
+      if ((getaddrinfo(conn->host, NULL, &hints, &info) != 0) || (info == NULL)) {
+        return false;
+      }
+      addr.sin_addr = ((struct sockaddr_in*)info->ai_addr)->sin_addr;
+      freeaddrinfo(info);
+    }
+  }
+
+  conn->fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (conn->fd < 0) {
+    return false;
+  }
+  SocketSetup(conn->fd);
+  if (connect(conn->fd, (struct sockaddr*)&addr, sizeof(addr)) != 0) {
+    if (errno != EINPROGRESS) {
+      return false;
+    }
+    while (!conn->cancel) {
+      const int64_t left = deadline - NowMs();
+      if (left <= 0) {
+        return false;
+      }
+      const int ready = WaitFd(conn->fd, true, left > 250 ? 250 : (int)left);
+      if (ready < 0) {
+        return false;
+      }
+      if (ready > 0) {
+        break;
+      }
+    }
+    int err       = 0;
+    socklen_t len = sizeof(err);
+    if (conn->cancel || (getsockopt(conn->fd, SOL_SOCKET, SO_ERROR, &err, &len) != 0) || (err != 0)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+/** Websocket creator handed to openeebus for an incoming connection (lives on the thread's stack). */
+typedef struct ServerCreator {
+  WebsocketCreatorObject obj;
+  ShipConn* conn;
+} ServerCreator;
+
+static void ServerCreatorDestruct(WebsocketCreatorObject* self) {
+  (void)self;
+}
+
+static WebsocketObject* ServerCreatorCreateWebsocket(WebsocketCreatorObject* self, WebsocketCallback cb, void* ctx) {
+  ShipConn* const conn = ((ServerCreator*)self)->conn;
+  if (conn->ws != NULL) {
+    return NULL;
+  }
+  return (WebsocketObject*)WsCreate(conn, cb, ctx);
+}
+
+static const WebsocketCreatorInterface server_creator_methods = {
+    .destruct         = ServerCreatorDestruct,
+    .create_websocket = ServerCreatorCreateWebsocket,
+};
+
+/** Everything up to the point where messages can flow. */
+static bool ConnEstablish(ShipConn* conn) {
+  const int64_t deadline = NowMs() + kHandshakeTimeoutMs;
+  if (!conn->is_server && !ConnConnect(conn, deadline)) {
+    TRANSPORT_DEBUG_PRINTF("ship transport: cannot connect to %s:%d\n", conn->host, conn->port);
+    return false;
+  }
+  if (!TlsSetup(conn) || !TlsHandshake(conn, deadline)) {
+    TRANSPORT_DEBUG_PRINTF("ship transport: TLS handshake failed (%s)\n", conn->is_server ? "incoming" : "outgoing");
+    return false;
+  }
+  char* const ski = TlsPeerSki(conn);
+  if (ski == NULL) {
+    TRANSPORT_DEBUG_PRINTF("ship transport: peer sent no certificate\n");
+    return false;
+  }
+
+  bool ok = false;
+  if (conn->is_server) {
+    ShipServer* const srv = conn->server;
+    if (WsServerHandshake(conn, deadline) && !conn->cancel && (srv->conn_establish_cb != NULL)) {
+      ServerCreator creator = {.obj = {.interface_ = &server_creator_methods}, .conn = conn};
+      // openeebus decides here whether it takes the connection; if so it has
+      // created its websocket through `creator`.
+      const int ret = srv->conn_establish_cb(ski, &creator.obj, srv->conn_establish_ctx);
+      EEBUS_MUTEX_LOCK(conn->mutex);
+      ok = (ret == 0) && (conn->ws != NULL);
+      EEBUS_MUTEX_UNLOCK(conn->mutex);
+      TRANSPORT_DEBUG_PRINTF("ship transport: incoming connection from %s %s\n", ski, ok ? "accepted" : "turned down");
+    } else {
+      TRANSPORT_DEBUG_PRINTF("ship transport: websocket handshake with %s failed\n", ski);
+    }
+  } else {
+    // Only the node openeebus wants to reach may answer.
+    ok = (conn->remote_ski != NULL) && (strcasecmp(ski, conn->remote_ski) == 0) && WsClientHandshake(conn, deadline);
+    TRANSPORT_DEBUG_PRINTF("ship transport: outgoing connection to %s %s\n", ski, ok ? "established" : "failed");
+  }
+  EEBUS_FREE(ski);
+  return ok;
+}
+
+static void* ConnThread(void* arg) {
+  ShipConn* const conn = (ShipConn*)arg;
+
+  const bool established = ConnEstablish(conn);
+  conn->established      = true;
+  if (!established) {
+    // An outgoing attempt is reported; an incoming one openeebus has not seen
+    // (or it turned it down itself).
+    ConnNotify(conn, kWebsocketCallbackTypeError, "", 0);
+  } else {
+    bool alive = true;
+    while (alive && !conn->cancel) {
+      alive = WsFlush(conn) && (WsReadFrame(conn) >= 0);
+    }
+    if (alive) {
+      // Closed by openeebus: send what it queued (the SHIP close message), then say goodbye.
+      WsFlush(conn);
+      WsSendClose(conn, ConnCloseCode(conn));
+    } else {
+      ConnNotify(conn, kWebsocketCallbackTypeClose, "", 0);
+    }
+  }
+
+  if (conn->tls_ready) {
+    mbedtls_ssl_close_notify(&conn->ssl);
+  }
+  TlsFree(conn);
+  if (conn->fd >= 0) {
+    close(conn->fd);
+    conn->fd = -1;
+  }
+  RxRelease(conn);
+  EEBUS_QUEUE_CLEAR(conn->wr_queue);
+  conn->done = true;
+  return NULL;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Outgoing connections: websocket client creator
+//-------------------------------------------------------------------------------------------//
+
+typedef struct ClientCreator {
+  WebsocketCreatorObject obj;
+  char* uri;
+  char* remote_ski;
+  const TlsCertificateObject* tls_cert;
+} ClientCreator;
+
+static void ClientCreatorDestruct(WebsocketCreatorObject* self) {
+  ClientCreator* const creator = (ClientCreator*)self;
+  EEBUS_FREE(creator->uri);
+  creator->uri = NULL;
+  EEBUS_FREE(creator->remote_ski);
+  creator->remote_ski = NULL;
+}
+
+/** Split "wss://host:port/path" into the fields of `conn`. */
+static bool ConnParseUri(ShipConn* conn, const char* uri) {
+  static const char kScheme[] = "wss://";
+  if ((uri == NULL) || (strncmp(uri, kScheme, sizeof(kScheme) - 1) != 0)) {
+    return false;
+  }
+  const char* const host = uri + sizeof(kScheme) - 1;
+  const char* const path = strchr(host, '/');
+  const char* const end  = (path != NULL) ? path : host + strlen(host);
+  const char* colon      = NULL;
+  for (const char* p = host; p < end; ++p) {
+    if (*p == ':') {
+      colon = p;
+    }
+  }
+  if ((colon == NULL) || (colon == host)) {
+    return false;
+  }
+  conn->port = atoi(colon + 1);
+  conn->host = StrDup(host, (size_t)(colon - host));
+  conn->path = (path != NULL) ? StrDup(path, strlen(path)) : StrDup("/", 1);
+  return (conn->port > 0) && (conn->port <= 65535) && (conn->host != NULL) && (conn->path != NULL);
+}
+
+static WebsocketObject* ClientCreatorCreateWebsocket(WebsocketCreatorObject* self, WebsocketCallback cb, void* ctx) {
+  const ClientCreator* const creator = (const ClientCreator*)self;
+  if ((creator->remote_ski == NULL) || (creator->tls_cert == NULL)) {
+    return NULL;
+  }
+  ShipConn* const conn = ConnCreate(false, creator->tls_cert);
+  if (conn == NULL) {
+    return NULL;
+  }
+  conn->remote_ski = StrDup(creator->remote_ski, strlen(creator->remote_ski));
+  if ((conn->remote_ski == NULL) || !ConnParseUri(conn, creator->uri)) {
+    ConnFree(conn);
+    return NULL;
+  }
+  ShipWebsocket* const ws = WsCreate(conn, cb, ctx);
+  if (ws == NULL) {
+    ConnFree(conn);
+    return NULL;
+  }
+  if (!ConnStart(conn)) {
+    ConnFree(conn);
+    EEBUS_FREE(ws);
+    return NULL;
+  }
+  return &ws->obj;
+}
+
+static const WebsocketCreatorInterface client_creator_methods = {
+    .destruct         = ClientCreatorDestruct,
+    .create_websocket = ClientCreatorCreateWebsocket,
+};
+
+WebsocketCreatorObject*
+WebsocketClientCreatorCreate(const char* uri, const TlsCertificateObject* tls_cert, const char* remote_ski) {
+  if ((uri == NULL) || (remote_ski == NULL)) {
+    return NULL;
+  }
+  ClientCreator* const creator = (ClientCreator*)EEBUS_MALLOC(sizeof(ClientCreator));
+  if (creator == NULL) {
+    return NULL;
+  }
+  creator->obj.interface_ = &client_creator_methods;
+  creator->uri            = StrDup(uri, strlen(uri));
+  creator->remote_ski     = StrDup(remote_ski, strlen(remote_ski));
+  creator->tls_cert       = tls_cert;
+  if ((creator->uri == NULL) || (creator->remote_ski == NULL)) {
+    ClientCreatorDestruct(&creator->obj);
+    EEBUS_FREE(creator);
+    return NULL;
+  }
+  return &creator->obj;
+}
+
+//-------------------------------------------------------------------------------------------//
+// Incoming connections: "HTTP server"
+//-------------------------------------------------------------------------------------------//
+
+#define SHIP_SERVER(obj) ((ShipServer*)(obj))
+
+/** Connections of this server; with `pending_only` those openeebus has not taken over yet. */
+static size_t ServerCountConns(ShipServer* srv, bool pending_only) {
+  size_t count = 0;
+  if (!ConnsLock()) {
+    return 0;
+  }
+  for (ShipConn* conn = conns; conn != NULL; conn = conn->next) {
+    if ((conn->server == srv) && !conn->done && (!pending_only || !conn->established)) {
+      ++count;
+    }
+  }
+  ConnsUnlock();
+  return count;
+}
+
+static void ServerAccept(ShipServer* srv) {
+  const int fd = accept(srv->listen_fd, NULL, NULL);
+  if (fd < 0) {
+    return;
+  }
+  if (ServerCountConns(srv, false) >= SHIP_TRANSPORT_MAX_SERVER_CONNECTIONS) {
+    close(fd);
+    return;
+  }
+  ShipConn* const conn = ConnCreate(true, srv->tls_cert);
+  if (conn == NULL) {
+    close(fd);
+    return;
+  }
+  SocketSetup(fd);
+  conn->fd     = fd;
+  conn->server = srv;
+  if (!ConnStart(conn)) {
+    close(fd);
+    ConnFree(conn);
+  }
+}
+
+static void* ServerThread(void* arg) {
+  ShipServer* const srv = (ShipServer*)arg;
+  int ticks             = 0;
+  while (!srv->cancel) {
+    if (WaitFd(srv->listen_fd, false, kAcceptPollMs) > 0) {
+      ServerAccept(srv);
+    }
+    if (++ticks >= 8) {
+      ticks = 0;
+      Reap();
+    }
+  }
+  return NULL;
+}
+
+/** Listening socket for IPv4 and, where the network stack has it, IPv6. */
+static int ServerListen(int port) {
+  const int on  = 1;
+  const int off = 0;
+#ifdef AF_INET6
+  int fd = socket(AF_INET6, SOCK_STREAM, 0);
+  if (fd >= 0) {
+    struct sockaddr_in6 addr6;
+    memset(&addr6, 0, sizeof(addr6));
+    addr6.sin6_family = AF_INET6;
+    addr6.sin6_addr   = in6addr_any;
+    addr6.sin6_port   = htons((uint16_t)port);
+    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+    // One socket for both: peers reach us over either protocol
+    if ((setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &off, sizeof(off)) == 0)
+        && (bind(fd, (struct sockaddr*)&addr6, sizeof(addr6)) == 0) && (listen(fd, 2) == 0)) {
+      return fd;
+    }
+    close(fd);
+  }
+#else
+  (void)off;
+#endif
+  const int fd4 = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd4 < 0) {
+    return -1;
+  }
+  struct sockaddr_in addr;
+  memset(&addr, 0, sizeof(addr));
+  addr.sin_family      = AF_INET;
+  addr.sin_addr.s_addr = htonl(INADDR_ANY);
+  addr.sin_port        = htons((uint16_t)port);
+  setsockopt(fd4, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+  if ((bind(fd4, (struct sockaddr*)&addr, sizeof(addr)) != 0) || (listen(fd4, 2) != 0)) {
+    close(fd4);
+    return -1;
+  }
+  return fd4;
+}
+
+static EebusError ServerStart(HttpServerObject* self) {
+  ShipServer* const srv = SHIP_SERVER(self);
+  srv->listen_fd        = ServerListen(srv->port);
+  if (srv->listen_fd < 0) {
+    return kEebusErrorInit;
+  }
+  fcntl(srv->listen_fd, F_SETFL, fcntl(srv->listen_fd, F_GETFL, 0) | O_NONBLOCK);
+  srv->cancel = false;
+  srv->thread = EebusThreadCreate(ServerThread, srv, 4 * 1024);
+  if (srv->thread == NULL) {
+    close(srv->listen_fd);
+    srv->listen_fd = -1;
+    return kEebusErrorThread;
+  }
+  return kEebusErrorOk;
+}
+
+static void ServerStop(HttpServerObject* self) {
+  ShipServer* const srv = SHIP_SERVER(self);
+  srv->cancel           = true;
+  if (srv->thread != NULL) {
+    EEBUS_THREAD_JOIN(srv->thread);
+    EebusThreadDelete(srv->thread);
+    srv->thread = NULL;
+  }
+  if (srv->listen_fd >= 0) {
+    close(srv->listen_fd);
+    srv->listen_fd = -1;
+  }
+  // Connections still in their handshake would call back into openeebus:
+  // stop them and wait until they are through.
+  if (ConnsLock()) {
+    for (ShipConn* conn = conns; conn != NULL; conn = conn->next) {
+      if ((conn->server == srv) && !conn->established) {
+        conn->cancel = true;
+      }
+    }
+    ConnsUnlock();
+  }
+  const int64_t deadline = NowMs() + kHandshakeTimeoutMs + kIoTimeoutMs;
+  while ((ServerCountConns(srv, true) > 0) && (NowMs() < deadline)) {
+    EebusThreadUsleep(20 * 1000);
+  }
+  // The connections openeebus took over live on without their server
+  if (ConnsLock()) {
+    for (ShipConn* conn = conns; conn != NULL; conn = conn->next) {
+      if ((conn->server == srv) && conn->established) {
+        conn->server = NULL;
+      }
+    }
+    ConnsUnlock();
+  }
+  Reap();
+}
+
+static void ServerDestruct(HttpServerObject* self) {
+  ServerStop(self);
+}
+
+static const HttpServerInterface ship_server_methods = {
+    .destruct = ServerDestruct,
+    .start    = ServerStart,
+    .stop     = ServerStop,
+};
+
+HttpServerObject* HttpServerCreate(
+    int port,
+    const TlsCertificateObject* tls_cert,
+    WebsocketServerCallbackType conn_establish_cb,
+    void* conn_establish_ctx
+) {
+  ShipServer* const srv = (ShipServer*)EEBUS_MALLOC(sizeof(ShipServer));
+  if (srv == NULL) {
+    return NULL;
+  }
+  srv->obj.interface_     = &ship_server_methods;
+  srv->port               = port;
+  srv->tls_cert           = tls_cert;
+  srv->conn_establish_cb  = conn_establish_cb;
+  srv->conn_establish_ctx = conn_establish_ctx;
+  srv->listen_fd          = -1;
+  srv->cancel             = false;
+  srv->thread             = NULL;
+  return &srv->obj;
+}
diff --git a/eebus/test/build-host.sh b/eebus/test/build-host.sh
new file mode 100755
index 00000000..acee35d6
--- /dev/null
+++ b/eebus/test/build-host.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# Build the EEBUS node of the wallbox as a host program: the pinned openeebus,
+# our transport (mbedTLS instead of libwebsockets) and the application, with
+# the same sources the firmware uses. For the interop test, see interop.py.
+#
+#   eebus/test/build-host.sh <out-dir>
+#
+# Needs: a C compiler, python3, patch and the development files of mbedTLS
+# (2.28 or 3.x) and cJSON. MBEDTLS_PREFIX / CJSON_PREFIX name their install
+# prefix if they are not in the default search path. Linux also needs
+# libavahi-compat-libdnssd-dev (mDNS).
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+EEBUS="$(dirname "$HERE")"
+OUT="${1:?usage: build-host.sh <out-dir>}"
+mkdir -p "$OUT/obj"
+SRC="$(python3 "$EEBUS/openeebus.py" "$OUT")"
+
+CC="${CC:-cc}"
+CFLAGS=(-O1 -g -DEEBUS_DEBUG_STDOUT ${EEBUS_EXTRA_CFLAGS:-}
+        -I"$SRC" -I"$EEBUS/port" -I"$EEBUS/app")
+LIBS=()
+for prefix in "${MBEDTLS_PREFIX:-}" "${CJSON_PREFIX:-}"; do
+  [ -n "$prefix" ] || continue
+  CFLAGS+=(-I"$prefix/include" -I"$prefix/include/cjson")
+  LIBS+=(-L"$prefix/lib")
+done
+LIBS+=(-lmbedtls -lmbedx509 -lmbedcrypto -lcjson -lm -lpthread)
+
+case "$(uname -s)" in
+  Darwin) PLATFORM=(src/common/eebus_timer/eebus_timer_apple.c) ;;
+  *)      PLATFORM=(src/common/eebus_timer/eebus_timer_linux.c); LIBS+=(-ldns_sd) ;;
+esac
+
+# openeebus as listed in its sources.cmake, without what the wallbox replaces
+# (libwebsockets transport, OpenSSL certificate, debug output) or does not use
+# (command line interface, the FreeRTOS variants).
+mapfile_sources() {
+  {
+    grep -oE 'src/[A-Za-z0-9_/]+\.c' "$SRC/sources.cmake" | grep -v '_sources\.c$'
+    for cmake in src/common/eebus_data/eebus_data_sources.cmake src/common/eebus_date_time/eebus_date_time_sources.cmake; do
+      dir="$(dirname "$cmake")"
+      grep -oE '[A-Za-z0-9_/]+\.c' "$SRC/$cmake" | while read -r f; do
+        if [ -f "$SRC/$f" ]; then echo "$f"; else echo "$dir/$f"; fi
+      done
+    done
+  } | sort -u | grep -v -E 'freertos|avahi|windows|eebus_timer_|tls_certificate|openssl_util|applink|/websocket/|src/cli/|common/debug\.c'
+}
+
+SOURCES=()
+while read -r f; do SOURCES+=("$SRC/$f"); done < <(mapfile_sources)
+for f in "${PLATFORM[@]}" src/ship/tls_certificate/tls_certificate_mbedtls.c; do
+  SOURCES+=("$SRC/$f")
+done
+SOURCES+=("$EEBUS"/port/*.c "$EEBUS"/app/*.c "$HERE/host_main.c")
+
+OBJECTS=()
+for f in "${SOURCES[@]}"; do
+  obj="$OUT/obj/$(echo "${f%.c}" | tr '/' '_').o"
+  OBJECTS+=("$obj")
+  if [ ! -f "$obj" ] || [ "$f" -nt "$obj" ]; then
+    "$CC" "${CFLAGS[@]}" -c "$f" -o "$obj" &
+    # a handful of compilers at a time
+    while [ "$(jobs -r | wc -l)" -ge 8 ]; do sleep 0.05; done
+  fi
+done
+wait
+"$CC" ${EEBUS_EXTRA_CFLAGS:-} "${OBJECTS[@]}" "${LIBS[@]}" -o "$OUT/wallbox-eebus"
+echo "eebus: $OUT/wallbox-eebus"
diff --git a/eebus/test/host_main.c b/eebus/test/host_main.c
new file mode 100644
index 00000000..f5cf2d43
--- /dev/null
+++ b/eebus/test/host_main.c
@@ -0,0 +1,170 @@
+/*
+ * The EEBUS node of the wallbox as a host program, for the interop test
+ * against the openeebus reference programs (see interop.py).
+ *
+ *   wallbox-eebus --gen-cert <cert.pem> <key.pem> <common-name>
+ *   wallbox-eebus <port> <cert.pem> <key.pem> [--meter] [--frequency] [--guard <ski>] [--trust <ski>]...
+ *
+ * Like the firmware, the node creates its certificate on the first start (when
+ * the two files do not exist yet) and keeps it.
+ *
+ * Commands on stdin, one per line:
+ *   trust <ski> | untrust <ski>
+ *   power <W> [<Wh>]       measurements (with --meter spread over three phases)
+ *   status                 prints one "status ..." line and one "peer ..." line per node
+ *   quit
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "eebus_app.h"
+#include "eebus_cert.h"
+
+static char* ReadFile(const char* path) {
+  FILE* const f = fopen(path, "rb");
+  if (f == NULL) {
+    return NULL;
+  }
+  static char buf[2][4096];
+  static int next   = 0;
+  char* const out   = buf[next++ & 1];
+  const size_t size = fread(out, 1, sizeof(buf[0]) - 1, f);
+  out[size]         = '\0';
+  fclose(f);
+  return out;
+}
+
+static int WriteFile(const char* path, const char* text) {
+  FILE* const f = fopen(path, "w");
+  if (f == NULL) {
+    return -1;
+  }
+  fputs(text, f);
+  return fclose(f);
+}
+
+static void PrintStatus(void) {
+  EebusAppStatus s;
+  EebusAppGetStatus(&s);
+  printf(
+      "status running=%d ski=%s state=%s limited=%d limit_w=%.0f remaining_s=%lld heartbeat=%d failsafe_w=%.0f "
+      "failsafe_duration_s=%d guard=%s persist=%u\n",
+      s.running,
+      s.ski,
+      EebusLimitStateName(s.limit_state),
+      s.limited,
+      s.limit_w,
+      (long long)s.limit_remaining_s,
+      s.heartbeat_ok,
+      s.failsafe_w,
+      (int)s.failsafe_duration_s,
+      s.guard_ski[0] ? s.guard_ski : "-",
+      (unsigned)s.persist_seq
+  );
+  EebusAppPeer peers[EEBUS_APP_MAX_PEERS];
+  const size_t count = EebusAppGetPeers(peers, EEBUS_APP_MAX_PEERS);
+  for (size_t i = 0; i < count; ++i) {
+    printf(
+        "peer ski=%s trusted=%d discovered=%d connected=%d waiting=%d guard=%d name=%s\n",
+        peers[i].ski,
+        peers[i].trusted,
+        peers[i].discovered,
+        peers[i].connected,
+        peers[i].waiting_trust,
+        peers[i].guard,
+        peers[i].name
+    );
+  }
+  fflush(stdout);
+}
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, NULL, _IOLBF, 0);
+
+  if ((argc == 5) && (strcmp(argv[1], "--gen-cert") == 0)) {
+    char cert[EEBUS_CERT_PEM_MAX];
+    char key[EEBUS_CERT_PEM_MAX];
+    if ((EebusCertGenerate(argv[4], cert, sizeof(cert), key, sizeof(key)) != 0) || (WriteFile(argv[2], cert) != 0)
+        || (WriteFile(argv[3], key) != 0)) {
+      fprintf(stderr, "certificate generation failed\n");
+      return 1;
+    }
+    return 0;
+  }
+  if (argc < 4) {
+    fprintf(stderr, "usage: %s <port> <cert.pem> <key.pem> [--meter] [--frequency] [--guard <ski>] [--trust <ski>]...\n", argv[0]);
+    return 2;
+  }
+
+  char trusted[EEBUS_APP_MAX_PEERS * (EEBUS_APP_SKI_LEN + 1) + 1] = "";
+  EebusAppConfig cfg = {
+      .port                = atoi(argv[1]),
+      .cert_pem            = ReadFile(argv[2]),
+      .key_pem             = ReadFile(argv[3]),
+      .brand               = "OpenEVSE",
+      .model               = "Kinetos",
+      .serial              = "interop",
+      .trusted             = trusted,
+      .nominal_max_w       = 11000,
+      .failsafe_w          = 4200,
+      .failsafe_duration_s = 7200,
+  };
+  for (int i = 4; i < argc; ++i) {
+    if (strcmp(argv[i], "--meter") == 0) {
+      cfg.per_phase = true;
+    } else if (strcmp(argv[i], "--frequency") == 0) {
+      cfg.frequency = true;
+    } else if ((strcmp(argv[i], "--guard") == 0) && (i + 1 < argc)) {
+      cfg.guard_ski = argv[++i];
+    } else if ((strcmp(argv[i], "--trust") == 0) && (i + 1 < argc)) {
+      if (strlen(trusted) + strlen(argv[i + 1]) + 2 < sizeof(trusted)) {
+        strcat(trusted, argv[i + 1]);
+        strcat(trusted, ",");
+      }
+      ++i;
+    }
+  }
+  if (!EebusAppStart(&cfg)) {
+    fprintf(stderr, "start failed\n");
+    return 1;
+  }
+  bool identity_stored = false;
+
+  char line[256];
+  while (fgets(line, sizeof(line), stdin) != NULL) {
+    char arg[128]  = "";
+    double value   = 0.0;
+    double value2  = 0.0;
+    if (sscanf(line, "trust %127s", arg) == 1) {
+      printf("trust %s\n", EebusAppTrust(arg, true) ? "ok" : "failed");
+    } else if (sscanf(line, "untrust %127s", arg) == 1) {
+      printf("untrust %s\n", EebusAppTrust(arg, false) ? "ok" : "failed");
+    } else if (sscanf(line, "power %lf %lf", &value, &value2) >= 1) {
+      EebusAppMeasurements m = {.power_w = value, .energy_wh = value2, .frequency_hz = 50.0};
+      for (int i = 0; i < 3; ++i) {
+        m.phase_power_w[i] = value / 3.0;
+        m.voltage_v[i]     = 230.0;
+        m.current_a[i]     = value / 3.0 / 230.0;
+      }
+      EebusAppSetMeasurements(&m);
+    } else if (strncmp(line, "status", 6) == 0) {
+      EebusAppStatus status;
+      EebusAppGetStatus(&status);
+      if (status.identity_generated && !identity_stored) {
+        char cert[EEBUS_CERT_PEM_MAX];
+        char key[EEBUS_CERT_PEM_MAX];
+        identity_stored = EebusAppGetIdentity(cert, sizeof(cert), key, sizeof(key)) && (WriteFile(argv[2], cert) == 0)
+                          && (WriteFile(argv[3], key) == 0);
+        printf("identity %s\n", identity_stored ? "stored" : "not stored");
+      }
+      PrintStatus();
+    } else if (strncmp(line, "quit", 4) == 0) {
+      break;
+    }
+  }
+
+  EebusAppStop();
+  printf("stopped\n");
+  return 0;
+}
diff --git a/eebus/test/interop.py b/eebus/test/interop.py
new file mode 100644
index 00000000..d7facdc6
--- /dev/null
+++ b/eebus/test/interop.py
@@ -0,0 +1,295 @@
+#!/usr/bin/env python3
+"""Interop test of the wallbox's EEBUS node against openeebus' reference programs.
+
+    interop.py <wallbox-eebus> <openeebus-build-dir> [--keep-logs DIR] [--quick]
+
+<wallbox-eebus> comes from build-host.sh: the code of the firmware (openeebus,
+our transport without libwebsockets, the application) as a host program.
+<openeebus-build-dir> holds `hems` built from unmodified openeebus
+(libwebsockets, OpenSSL); it plays the control box / energy manager:
+Energy Guard for LPC, Monitoring Appliance for MPC.
+
+The test runs three times, so that the wallbox is once connected to, once
+connects itself and once both sides try. `--quick` skips the part that waits
+120 s for the failsafe state. Every check prints PASS/FAIL; exit code 0 only
+if all pass. Needs openssl and a network with multicast (mDNS).
+"""
+import os
+import pty
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+WALLBOX, OEB = sys.argv[1], sys.argv[2]
+KEEP = sys.argv[sys.argv.index("--keep-logs") + 1] if "--keep-logs" in sys.argv else None
+QUICK = "--quick" in sys.argv
+WORK = tempfile.mkdtemp(prefix="eebus-interop-")
+results = []
+
+
+def check(name, ok, detail=""):
+    results.append(bool(ok))
+    print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  - {detail}" if detail else ""), flush=True)
+
+
+def ski_of(cert):
+    out = subprocess.check_output(["openssl", "x509", "-in", cert, "-noout", "-ext", "subjectKeyIdentifier"], text=True)
+    return out.strip().splitlines()[-1].strip().replace(":", "").lower()
+
+
+def make_cert(name):
+    crt, key = f"{WORK}/{name}.crt", f"{WORK}/{name}.key"
+    subprocess.check_call(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
+                           "-keyout", key, "-out", crt, "-days", "30", "-subj", f"/CN={name}", "-addext",
+                           "subjectKeyIdentifier=hash"], stderr=subprocess.DEVNULL)
+    return crt, key
+
+
+class Proc:
+    """Child process on a pseudo terminal (so its output is not block-buffered), output collected line by line."""
+
+    def __init__(self, name, argv):
+        self.name = name
+        self.log = open(f"{WORK}/{name}.log", "a")
+        self.master, slave = pty.openpty()
+        self.p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=slave, stderr=slave, text=True, bufsize=1)
+        os.close(slave)
+        self.lines = []
+        threading.Thread(target=self._read, daemon=True).start()
+
+    def _read(self):
+        buf = b""
+        while True:
+            try:
+                chunk = os.read(self.master, 4096)
+            except OSError:
+                break
+            if not chunk:
+                break
+            buf += chunk
+            while b"\n" in buf:
+                raw, buf = buf.split(b"\n", 1)
+                line = raw.decode(errors="replace").rstrip("\r")
+                self.log.write(line + "\n")
+                self.log.flush()
+                self.lines.append(line)
+
+    def send(self, line):
+        self.log.write("> " + line + "\n")
+        self.p.stdin.write(line + "\n")
+        self.p.stdin.flush()
+
+    def wait_line(self, pattern, timeout=30, start=0):
+        rx = re.compile(pattern)
+        end = time.time() + timeout
+        while time.time() < end:
+            for line in self.lines[start:]:
+                if rx.search(line):
+                    return line
+            time.sleep(0.1)
+        return None
+
+    def stop(self):
+        try:
+            self.p.stdin.close()
+        except Exception:
+            pass
+        try:
+            self.p.terminate()
+            self.p.wait(timeout=10)
+        except Exception:
+            self.p.kill()
+
+
+class Wallbox(Proc):
+    def status(self):
+        """Current status as a dict, plus the list of nodes."""
+        start = len(self.lines)
+        self.send("status")
+        line = self.wait_line(r"^status ", 5, start)
+        if not line:
+            return {}, []
+        time.sleep(0.2)
+        fields = dict(kv.split("=", 1) for kv in line.split()[1:])
+        peers = [dict(kv.split("=", 1) for kv in l.split()[1:] if "=" in kv)
+                 for l in self.lines[start:] if l.startswith("peer ")]
+        return fields, peers
+
+    def wait_status(self, pred, timeout=30):
+        end = time.time() + timeout
+        last = ({}, [])
+        while time.time() < end:
+            last = self.status()
+            if last[0] and pred(*last):
+                return last
+            time.sleep(0.5)
+        return None
+
+
+def peer(peers, ski):
+    return next((p for p in peers if p.get("ski") == ski), {})
+
+
+# What the wallbox measures in each pass: with a meter that also knows the
+# frequency, with a meter that does not, without a meter.
+METER = {
+    "auto": (["--meter", "--frequency"],
+             ["power_phase_a", "energy_consumed = 12345", "current_phase_c", "voltage_phase_b = 230", "frequency = 50"], []),
+    "server": (["--meter"], ["power_phase_a", "energy_consumed = 12345", "current_phase_c", "voltage_phase_b = 230"],
+               ["frequency"]),
+    "client": ([], ["energy_consumed = 12345"], ["power_phase_a", "current_phase_c", "voltage_phase_b", "frequency"]),
+}
+
+
+def run(role, port, failsafe):
+    """One pass. `role` is the SHIP role of hems: with "server" the wallbox has to connect, with "client" it is connected to."""
+    meter_args, expected, absent = METER[role]
+    tag = f"[hems {role}]"
+    wb_crt, wb_key = f"{WORK}/wallbox.crt", f"{WORK}/wallbox.key"
+    ski_wb, ski_hems, ski_other = ski_of(wb_crt), ski_of(hems_crt), ski_of(other_crt)
+    procs = []
+    try:
+        wb = Wallbox(f"wallbox-{role}", [WALLBOX, str(port), wb_crt, wb_key, *meter_args, "--trust", ski_hems])
+        procs.append(wb)
+        st = wb.wait_status(lambda s, p: s.get("running") == "1", 15)
+        check(f"{tag} Wallbox startet mit der SKI ihres Zertifikats", bool(st) and st[0].get("ski") == ski_wb, str(st and st[0]))
+        check(f"{tag} Ohne Energy Guard: keine Begrenzung, Zustand disabled",
+              bool(st) and st[0].get("state") == "disabled" and st[0].get("limited") == "0")
+
+        hems = Proc(f"hems-{role}", [f"{OEB}/hems", str(port + 1), ski_wb, hems_crt, hems_key, role])
+        procs.append(hems)
+        other = Proc(f"other-{role}", [f"{OEB}/hems", str(port + 2), ski_wb, other_crt, other_key, "client"])
+        procs.append(other)
+
+        st = wb.wait_status(lambda s, p: peer(p, ski_hems).get("connected") == "1", 90)
+        check(f"{tag} SHIP-Verbindung zum gekoppelten Energiemanager", bool(st))
+        st = wb.wait_status(lambda s, p: s.get("guard") == ski_hems and s.get("heartbeat") == "1"
+                            and s.get("state") == "unlimited_controlled", 60)
+        check(f"{tag} Energiemanager als Energy Guard erkannt, Heartbeat da, keine Begrenzung", bool(st), str(wb.status()[0]))
+        line = hems.wait_line(r"EG LPC Power Nominal Max received: 11000W", 30)
+        check(f"{tag} Energiemanager liest Nennleistung 11000 W", bool(line))
+        line = hems.wait_line(r"EG LPC Failsafe Active Power Limit received:\s+4200W", 30)
+        check(f"{tag} Energiemanager liest Failsafe-Grenze 4200 W", bool(line))
+        time.sleep(2)
+
+        # --- limit ------------------------------------------------------------
+        start = len(hems.lines)
+        hems.send("eg_lpc set power_limit 4200 PT2H true")
+        ok = hems.wait_line(r"EG LPC setting Active Power Limit succeeded", 20, start)
+        st = wb.wait_status(lambda s, p: s.get("state") == "limited" and s.get("limit_w") == "4200", 20)
+        check(f"{tag} Grenze 4200 W / 2 h wird angenommen und gilt",
+              bool(ok) and bool(st) and 7100 <= int(st[0]["remaining_s"]) <= 7200, str(st and st[0]))
+
+        start = len(hems.lines)
+        hems.send("eg_lpc set power_limit -5 PT1H true")
+        err = hems.wait_line(r"Active Power Limit result error", 20, start)
+        st = wb.status()
+        check(f"{tag} Negative Grenze wird abgelehnt, die alte gilt weiter",
+              bool(err) and st[0].get("limit_w") == "4200", f"{err} {st[0]}")
+
+        hems.send("eg_lpc set power_limit 4200 PT2H false")
+        st = wb.wait_status(lambda s, p: s.get("state") == "unlimited_controlled" and s.get("limited") == "0", 20)
+        check(f"{tag} Grenze aufgehoben", bool(st))
+
+        # --- a limit that runs out ---------------------------------------------
+        start = len(hems.lines)
+        hems.send("eg_lpc set power_limit 6000 PT6S true")
+        st = wb.wait_status(lambda s, p: s.get("state") == "limited" and s.get("limit_w") == "6000", 10)
+        check(f"{tag} Grenze 6000 W für 6 s gilt", bool(st), str(st and st[0]))
+        st = wb.wait_status(lambda s, p: s.get("state") == "unlimited_controlled", 15)
+        check(f"{tag} Grenze endet nach Ablauf ihrer Dauer von selbst", bool(st))
+        line = hems.wait_line(r"EG LPC Power Limit received 6000W.*active = false", 15, start)
+        check(f"{tag} Energiemanager sieht die abgelaufene Grenze als inaktiv", bool(line))
+
+        # --- failsafe values ---------------------------------------------------
+        before = wb.status()[0].get("persist")
+        hems.send("eg_lpc set failsafe_limit 3000")
+        hems.send("eg_lpc set failsafe_duration PT3H")
+        st = wb.wait_status(lambda s, p: s.get("failsafe_w") == "3000" and s.get("failsafe_duration_s") == "10800", 20)
+        check(f"{tag} Failsafe-Werte des Energiemanagers übernommen (3000 W, 3 h) und zum Speichern gemeldet",
+              bool(st) and st[0].get("persist") != before, str(st and st[0]))
+
+        # --- measurements -----------------------------------------------------
+        start = len(hems.lines)
+        wb.send("power 3450 12345")
+        line = hems.wait_line(r"MA MPC Measurement received: power_total = 3450", 30, start)
+        check(f"{tag} Leistung (MPC) kommt beim Energiemanager an", bool(line))
+        got = [n for n in expected if hems.wait_line(rf"MA MPC Measurement received: {n}", 10, start)]
+        extra = [n for n in absent if hems.wait_line(rf"MA MPC Measurement received: {n}", 1, start)]
+        check(f"{tag} Messwerte kommen an wie angeboten ({', '.join(n.split(' ')[0] for n in expected)})",
+              got == expected and not extra, f"{got} {extra}")
+
+        # --- pairing ----------------------------------------------------------
+        st = wb.status()
+        check(f"{tag} Nicht gekoppelter Knoten bekommt keine Verbindung", peer(st[1], ski_other).get("connected") != "1",
+              str(peer(st[1], ski_other)))
+        wb.send(f"untrust {ski_hems}")
+        st = wb.wait_status(lambda s, p: peer(p, ski_hems).get("connected") != "1" and s.get("guard") == "-"
+                            and s.get("state") == "disabled", 30)
+        check(f"{tag} Kopplung gelöst: Verbindung getrennt, Energy Guard vergessen, keine Begrenzung mehr", bool(st),
+              str(wb.status()))
+        wb.send(f"trust {ski_hems}")
+        st = wb.wait_status(lambda s, p: peer(p, ski_hems).get("connected") == "1" and s.get("guard") == ski_hems, 120)
+        check(f"{tag} Erneut gekoppelt: Verbindung und Energy Guard wieder da", bool(st), str(wb.status()))
+
+        # --- energy guard gone -> failsafe -------------------------------------
+        if failsafe:
+            hems.send("eg_lpc set power_limit 5000 PT1H true")
+            st = wb.wait_status(lambda s, p: s.get("state") == "limited", 20)
+            hems.stop()
+            st = wb.wait_status(lambda s, p: peer(p, ski_hems).get("connected") != "1", 30)
+            check(f"{tag} Verbindungsabbau erkannt", bool(st))
+            st = wb.status()[0]
+            check(f"{tag} Kurz nach dem Abbruch gilt noch die Grenze des Energiemanagers",
+                  st.get("state") == "limited" and st.get("limit_w") == "5000", str(st))
+            st = wb.wait_status(lambda s, p: s.get("state") == "failsafe", 150)
+            check(f"{tag} 120 s ohne Heartbeat: Failsafe mit den Werten des Energiemanagers",
+                  bool(st) and st[0].get("limit_w") == "3000" and 10700 <= int(st[0]["remaining_s"]) <= 10800,
+                  str(st and st[0]))
+
+            hems = Proc(f"hems-{role}", [f"{OEB}/hems", str(port + 1), ski_wb, hems_crt, hems_key, role])
+            procs.append(hems)
+            st = wb.wait_status(lambda s, p: peer(p, ski_hems).get("connected") == "1" and s.get("heartbeat") == "1", 120)
+            check(f"{tag} Energiemanager wieder da: Verbindung und Heartbeat", bool(st))
+            st = wb.status()[0]
+            check(f"{tag} Failsafe bleibt, bis der Energiemanager eine neue Grenze schreibt", st.get("state") == "failsafe", str(st))
+            time.sleep(3)
+            hems.send("eg_lpc set power_limit 7000 PT1H true")
+            st = wb.wait_status(lambda s, p: s.get("state") == "limited" and s.get("limit_w") == "7000", 30)
+            check(f"{tag} Neue Grenze beendet den Failsafe", bool(st), str(wb.status()[0]))
+
+        start = len(wb.lines)
+        wb.send("quit")
+        check(f"{tag} Wallbox beendet sich sauber", bool(wb.wait_line(r"^stopped", 30, start)))
+    finally:
+        for p in procs:
+            p.stop()
+
+
+hems_crt, hems_key = make_cert("hems")
+other_crt, other_key = make_cert("other")
+try:
+    # First start without certificate: the node creates its identity and it is kept.
+    crt, key = f"{WORK}/wallbox.crt", f"{WORK}/wallbox.key"
+    first = Wallbox("wallbox-first", [WALLBOX, "4739", crt, key])
+    st = first.wait_status(lambda s, p: s.get("running") == "1", 20)
+    first.send("quit")
+    first.wait_line(r"^stopped", 30)
+    first.stop()
+    verify = subprocess.run(["openssl", "verify", "-CAfile", crt, crt], capture_output=True)
+    check("Erster Start: Wallbox erzeugt ihr Zertifikat (selbstsigniert, mit SKI) und behält es",
+          bool(st) and os.path.isfile(key) and verify.returncode == 0 and ski_of(crt) == st[0].get("ski"), str(st and st[0]))
+    run("auto", 4740, failsafe=not QUICK)
+    run("server", 4750, failsafe=False)
+    run("client", 4760, failsafe=False)
+finally:
+    if KEEP:
+        shutil.copytree(WORK, KEEP, dirs_exist_ok=True)
+    shutil.rmtree(WORK, ignore_errors=True)
+
+print(f"\n{sum(results)}/{len(results)} checks passed")
+sys.exit(0 if all(results) else 1)
