diff --git a/scripts/eebus_build.py b/scripts/eebus_build.py
new file mode 100644
index 00000000..7f850e67
--- /dev/null
+++ b/scripts/eebus_build.py
@@ -0,0 +1,57 @@
+"""Build openeebus and the EEBUS node of the wallbox into the firmware.
+
+PRE-type extra script of the EEBUS environments (platformio.ini). Fetches the
+pinned openeebus sources (eebus/openeebus.pin, patched with eebus/patches) and
+compiles them together with eebus/port (transport without libwebsockets,
+certificate) and eebus/app (the node itself) as part of the firmware.
+
+"""
+import os
+import re
+import sys
+
+Import("env")  # noqa: F821  (provided by PlatformIO)
+
+PROJECT_DIR = env["PROJECT_DIR"]  # noqa: F821
+EEBUS_DIR = os.path.join(PROJECT_DIR, "eebus")
+sys.path.insert(0, EEBUS_DIR)
+import openeebus  # noqa: E402
+
+SRC = openeebus.prepare(os.path.join(PROJECT_DIR, ".pio", "eebus"))
+
+env.Append(  # noqa: F821
+    # openeebus includes its headers as "src/...", relative to its root
+    CPPPATH=[SRC, os.path.join(EEBUS_DIR, "port"), os.path.join(EEBUS_DIR, "app")],
+    CPPDEFINES=[
+        "__freertos__",  # openeebus: FreeRTOS variants (memory, cJSON include)
+        "EEBUS_MDNS_KEEP_HOSTNAME",  # mDNS and its host name belong to the firmware
+    ],
+)
+
+# openeebus as listed in its sources.cmake (FreeRTOS variant), without what
+# the wallbox replaces (libwebsockets transport, OpenSSL certificate, debug
+# output) or does not use (command line interface, other platforms).
+EXCLUDE = re.compile(
+    r"avahi|bonjour|windows|eebus_timer_(apple|linux)|/websocket/|^src/cli/|^src/common/debug\.c$"
+    r"|tls_certificate/(tls_certificate|openssl_util|applink)\.c$"
+    r"|eebus_(mutex|queue|thread)/eebus_(mutex|queue|thread)\.c$"
+)
+
+
+def sources():
+    found = set()
+    with open(os.path.join(SRC, "sources.cmake")) as f:
+        found.update(m for m in re.findall(r"src/[A-Za-z0-9_/]+\.c", f.read()) if not m.endswith("_sources.c"))
+    for cmake in ("src/common/eebus_data/eebus_data_sources.cmake", "src/common/eebus_date_time/eebus_date_time_sources.cmake"):
+        with open(os.path.join(SRC, cmake)) as f:
+            for name in re.findall(r"[A-Za-z0-9_/]+\.c", f.read()):
+                found.add(name if os.path.isfile(os.path.join(SRC, name)) else os.path.dirname(cmake) + "/" + name)
+    return sorted(name for name in found if not EXCLUDE.search(name))
+
+
+env.BuildSources(  # noqa: F821
+    os.path.join("$BUILD_DIR", "openeebus"), SRC, src_filter=["-<*>"] + ["+<%s>" % name for name in sources()]
+)
+env.BuildSources(  # noqa: F821
+    os.path.join("$BUILD_DIR", "eebus"), EEBUS_DIR, src_filter=["-<*>", "+<port/*.c>", "+<app/*.c>"]
