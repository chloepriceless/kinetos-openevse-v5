+static const MuMpcMeasurementConfig kMeasured = {.value_source = kMeasurementValueSourceTypeMeasuredValue};
+
+static const MuMpcMonitorEnergyConfig kEnergyConfig = {.energy_consumption_cfg = &kMeasured};
+
+static const MuMpcMonitorCurrentConfig kCurrentConfig = {
+    .current_phase_a_cfg = &kMeasured,
+    .current_phase_b_cfg = &kMeasured,
+    .current_phase_c_cfg = &kMeasured,
+};
+
+static const MuMpcMonitorVoltageConfig kVoltageConfig = {
