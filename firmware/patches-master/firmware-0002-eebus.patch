+
+static void CsDestruct(CsLpListenerObject* self) {
+  (void)self;
+}
+
+static void CsOnRemoteEgAdded(CsLpListenerObject* self, const EntityAddressType* addr) {
+  (void)self;
+  if ((app.service == NULL) || (addr == NULL) || (addr->device == NULL)) {
+    return;
+  }
+  DeviceLocalObject* const local     = EEBUS_SERVICE_GET_LOCAL_DEVICE(app.service);
+  DeviceRemoteObject* const remote   = DEVICE_LOCAL_GET_REMOTE_DEVICE_WITH_ADDRESS(local, addr->device);
+  const char* const ski              = (remote != NULL) ? DEVICE_REMOTE_GET_SKI(remote) : NULL;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  GuardSetIfTrusted(ski);
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static void CsOnRemoteEgRemoved(CsLpListenerObject* self, const EntityAddressType* addr) {
+  (void)self;
+  (void)addr;  // the heartbeat tells whether the energy guard is still there
+}
+
+static void CsOnPowerLimitReceive(
+    CsLpListenerObject* self,
+    const ScaledValue* limit,
+    const DurationType* duration,
+    bool is_active
+) {
+  (void)self;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusLimitStateOnLimit(&app.limit, ScaledToDouble(limit), DurationSeconds(duration), is_active, NowMs());
+  app.limit_announced_active = is_active;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static void CsOnFailsafePowerLimitReceive(CsLpListenerObject* self, const ScaledValue* limit) {
+  (void)self;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusLimitStateOnFailsafeLimit(&app.limit, ScaledToDouble(limit));
+  ++app.status.persist_seq;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static void CsOnFailsafeDurationReceive(CsLpListenerObject* self, const DurationType* duration) {
+  (void)self;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusLimitStateOnFailsafeDuration(&app.limit, DurationSeconds(duration));
+  ++app.status.persist_seq;
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static void CsOnHeartbeatReceive(CsLpListenerObject* self, uint64_t counter) {
+  (void)self;
+  (void)counter;  // the worker asks openeebus whether the heartbeat is in time
+}
+
+static const CsLpListenerInterface cs_listener_methods = {
+    .destruct                        = CsDestruct,
+    .on_remote_eg_added              = CsOnRemoteEgAdded,
+    .on_remote_eg_removed            = CsOnRemoteEgRemoved,
+    .on_power_limit_receive          = CsOnPowerLimitReceive,
+    .on_failsafe_power_limit_receive = CsOnFailsafePowerLimitReceive,
+    .on_failsafe_duration_receive    = CsOnFailsafeDurationReceive,
+    .on_heartbeat_receive            = CsOnHeartbeatReceive,
+};
+
+static CsLpListenerObject cs_listener = {&cs_listener_methods};
+
+// Writes are answered right here: valid ones are approved, what the charger
+// does with the limit is decided by the state machine. Only paired nodes get
+// this far (SHIP).
+static void Answer(bool valid, const char* ski, MsgCounterType msg_cnt, const char* reason) {
+  if (valid) {
+    CsLpApproveWrite(app.cs_lpc, ski, msg_cnt);
+    EEBUS_MUTEX_LOCK(app.mutex);
+    GuardSetIfTrusted(ski);
+    EEBUS_MUTEX_UNLOCK(app.mutex);
+  } else {
+    const ErrorType err = {.error_number = kErrorNumberTypeCommandRejected, .description = reason};
+    CsLpDenyWrite(app.cs_lpc, ski, msg_cnt, &err);
+  }
+}
+
+static void ApproverDestruct(CsLpcApproverObject* self) {
+  (void)self;
+}
+
+static void ApproverOnPowerLimit(
+    CsLpcApproverObject* self,
+    const char* ski,
+    MsgCounterType msg_cnt,
+    const ScaledValue* limit,
+    const DurationType* duration,
+    bool is_active
+) {
+  (void)self;
+  (void)is_active;
+  Answer(CsLpIsLimitValid(ScaledToDouble(limit), (int32_t)DurationSeconds(duration)), ski, msg_cnt, "invalid limit or duration");
+}
+
+static void
+ApproverOnFailsafeValue(CsLpcApproverObject* self, const char* ski, MsgCounterType msg_cnt, const ScaledValue* value) {
+  (void)self;
+  Answer(CsLpIsFailsafeValueValid(ScaledToDouble(value)), ski, msg_cnt, "invalid failsafe value");
+}
+
+static void ApproverOnFailsafeDuration(
+    CsLpcApproverObject* self,
+    const char* ski,
+    MsgCounterType msg_cnt,
+    const DurationType* duration
+) {
+  (void)self;
+  Answer(CsLpIsFailsafeDurationValid((int32_t)DurationSeconds(duration)), ski, msg_cnt, "invalid failsafe duration");
+}
+
+static void ApproverOnExpired(CsLpcApproverObject* self, const char* ski, MsgCounterType msg_cnt) {
+  (void)self;
+  (void)ski;
+  (void)msg_cnt;
+}
+
+static const CsLpcApproverInterface approver_methods = {
+    .destruct                                = ApproverDestruct,
+    .on_power_limit_approval_requested       = ApproverOnPowerLimit,
+    .on_failsafe_value_approval_requested    = ApproverOnFailsafeValue,
+    .on_failsafe_duration_approval_requested = ApproverOnFailsafeDuration,
+    .on_approval_request_expired             = ApproverOnExpired,
+};
+
+static CsLpcApproverObject approver = {&approver_methods};
