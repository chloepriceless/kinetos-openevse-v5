diff --git a/src/eebus.cpp b/src/eebus.cpp
new file mode 100644
index 00000000..10a3da25
--- /dev/null
+++ b/src/eebus.cpp
@@ -0,0 +1,412 @@
+#if defined(ENABLE_DEBUG) && !defined(ENABLE_DEBUG_EEBUS)
+#undef ENABLE_DEBUG
+#endif
+
+#include "eebus.h"
+
+#ifdef ENABLE_EEBUS
+
+#include <LittleFS.h>
+
+#include "app_config.h"
+#include "debug.h"
+#include "espal.h"
+#include "event.h"
+#include "grid_dimming.h"
+#include "grid_dimming_calc.h"
+#include "net_manager.h"
+#ifdef ENABLE_SDM_METER
+#include "sdm_meter.h"
+#endif
+
+#include "eebus_app.h"
+#include "eebus_cert.h"
+
+// The identity of this node: the other side pairs with the SKI of this
+// certificate. Kept in files, not in the config, so the key is never part of
+// a config download.
+static const char EEBUS_CERT_FILE[] = "/eebus_cert.pem";
+static const char EEBUS_KEY_FILE[] = "/eebus_key.pem";
+
+EebusTask eebus;
+
+static String readFile(const char *path)
+{
+  String text;
+  if(LittleFS.exists(path)) {
+    File file = LittleFS.open(path, "r");
+    if(file) {
+      text = file.readString();
+      file.close();
+    }
+  }
+  return text;
+}
+
+static bool writeFile(const char *path, const char *text)
+{
+  File file = LittleFS.open(path, "w");
+  if(!file) {
+    return false;
+  }
+  size_t written = file.print(text);
+  file.close();
+  return written == strlen(text);
+}
+
+EebusTask::EebusTask() :
+  MicroTasks::Task(),
+  _evse(nullptr),
+  _state(Idle),
+  _restart(false),
+  _identity_stored(false),
+  _persist_seq(0),
+  _failsafe_limit(0),
+  _failsafe_duration(0),
+  _started_at(0),
+  _retry_at(0),
+  _measured_at(0),
+  _limit_state(kEebusLimitDisabled),
+  _limited(false),
+  _limit_w(0)
+{
+}
+
+void EebusTask::begin(EvseManager &evse)
+{
+  _evse = &evse;
+  MicroTask.startTask(this);
+}
+
+void EebusTask::setup()
+{
+}
+
+void EebusTask::notifyConfigChanged()
+{
+  MicroTask.wakeTask(this);
+}
+
+const char *EebusTask::getStateName()
+{
+  return EebusLimitStateName((EebusLimitStateId)_limit_state);
+}
+
+void EebusTask::start()
+{
+  String cert = readFile(EEBUS_CERT_FILE);
+  String key = readFile(EEBUS_KEY_FILE);
+  // Only a complete pair is an identity; otherwise the node makes a new one
+  _identity_stored = cert.length() > 0 && key.length() > 0;
+  if(!_identity_stored) {
+    cert = "";
+    key = "";
+  }
+
+  String serial = ESPAL.getLongId();
+  uint8_t phases = config_threephase_enabled() ? 3 : 1;
+
+  EebusAppConfig cfg = {};
+  cfg.port = EEBUS_PORT;
+  cfg.cert_pem = cert.c_str();
+  cfg.key_pem = key.c_str();
+  cfg.brand = EEBUS_BRAND;
+  cfg.model = EEBUS_MODEL;
+  cfg.serial = serial.c_str();
+  cfg.trusted = eebus_trusted.c_str();
+  cfg.guard_ski = eebus_guard.c_str();
+  cfg.nominal_max_w = (double)_evse->getMaxConfiguredCurrent() * GRID_DIMMING_NOMINAL_VOLTAGE * phases;
+  cfg.failsafe_w = eebus_failsafe_limit;
+  cfg.failsafe_duration_s = eebus_failsafe_duration;
+#ifdef ENABLE_SDM_METER
+  // The meter measures per phase; it does not report the frequency
+  cfg.per_phase = sdmMeter.isPresent() && sdmMeter.isValid();
+#endif
+
+  _failsafe_limit = eebus_failsafe_limit;
+  _failsafe_duration = eebus_failsafe_duration;
+  _persist_seq = 0;
+  _restart = false;
+  _started_at = millis();
+  _measured_at = 0;
+
+  if(EebusAppStart(&cfg)) {
+    DBUGLN("EEBUS: node started");
+    _state = Running;
+  } else {
+    DBUGLN("EEBUS: start failed");
+    _retry_at = millis() + EEBUS_RETRY_TIME;
+  }
+}
+
+void EebusTask::measure()
+{
+  EebusAppMeasurements m = {};
+#ifdef ENABLE_SDM_METER
+  if(sdmMeter.isPresent())
+  {
+    if(!sdmMeter.isValid()) {
+      return; // keep the last values until the meter answers again
+    }
+    m.power_w = sdmMeter.get(SdmMeter::PowerTotal);
+    m.energy_wh = (double)sdmMeter.get(SdmMeter::ImportEnergy) * 1000.0;
+    for(uint8_t i = 0; i < 3; i++) {
+      m.phase_power_w[i] = sdmMeter.get((SdmMeter::Value)(SdmMeter::PowerL1 + i));
+      m.current_a[i] = sdmMeter.get((SdmMeter::Value)(SdmMeter::CurrentL1 + i));
+      m.voltage_v[i] = sdmMeter.get((SdmMeter::Value)(SdmMeter::VoltageL1 + i));
+    }
+    EebusAppSetMeasurements(&m);
+    return;
+  }
+#endif
+  m.power_w = _evse->getPower();
+  m.energy_wh = _evse->getTotalEnergy() * 1000.0;
+  EebusAppSetMeasurements(&m);
+}
+
+void EebusTask::update()
+{
+  EebusAppStatus status;
+  EebusAppGetStatus(&status);
+
+  if(!status.running)
+  {
+    // The node needs a moment to come up; if it does not, try again later
+    if(millis() - _started_at > 15000) {
+      DBUGLN("EEBUS: node did not come up");
+      _retry_at = millis() + EEBUS_RETRY_TIME;
+      _restart = true;
+    }
+    return;
+  }
+
+  if(status.identity_generated && !_identity_stored)
+  {
+    char *cert = (char *)malloc(EEBUS_CERT_PEM_MAX);
+    char *key = (char *)malloc(EEBUS_CERT_PEM_MAX);
+    if(cert && key && EebusAppGetIdentity(cert, EEBUS_CERT_PEM_MAX, key, EEBUS_CERT_PEM_MAX)) {
+      _identity_stored = writeFile(EEBUS_CERT_FILE, cert) && writeFile(EEBUS_KEY_FILE, key);
+      DBUGF("EEBUS: identity %s", _identity_stored ? "stored" : "not stored");
+    }
+    free(cert);
+    free(key);
+  }
+
+  uint32_t limit_w = status.limited ? (uint32_t)status.limit_w : 0;
+  gridDimming.setEebusLimit(status.limited, limit_w);
+
+  if((uint8_t)status.limit_state != _limit_state || status.limited != _limited || limit_w != _limit_w)
+  {
+    _limit_state = (uint8_t)status.limit_state;
+    _limited = status.limited;
+    _limit_w = limit_w;
+    DBUGF("EEBUS: %s, limit %u W", getStateName(), _limit_w);
+
+    StaticJsonDocument<128> event;
+    event["eebus_state"] = getStateName();
+    event["eebus_limited"] = _limited;
+    event["eebus_limit"] = _limit_w;
+    event_send(event);
+  }
+
+  // The energy guard and the failsafe values it wrote have to survive a restart
+  if(status.persist_seq != _persist_seq)
+  {
+    _persist_seq = status.persist_seq;
+    bool changed = false;
+    if(!eebus_guard.equalsIgnoreCase(status.guard_ski)) {
+      config_set("eebus_guard", String(status.guard_ski));
+      changed = true;
+    }
+    uint32_t failsafe_limit = (uint32_t)status.failsafe_w;
+    uint32_t failsafe_duration = (uint32_t)status.failsafe_duration_s;
+    if(failsafe_limit != eebus_failsafe_limit) {
+      _failsafe_limit = failsafe_limit;
+      config_set("eebus_failsafe_limit", failsafe_limit);
+      changed = true;
+    }
+    if(failsafe_duration != eebus_failsafe_duration) {
+      _failsafe_duration = failsafe_duration;
+      config_set("eebus_failsafe_duration", failsafe_duration);
+      changed = true;
+    }
+    if(changed) {
+      config_commit();
+    }
+  }
+
+  if(0 == _measured_at || millis() - _measured_at >= EEBUS_MEASUREMENT_TIME) {
+    _measured_at = millis();
+    measure();
+  }
+}
+
+unsigned long EebusTask::loop(MicroTasks::WakeReason reason)
+{
+  if(!_evse) {
+    return MicroTask.Infinate;
+  }
+
+  switch(_state)
+  {
+    case Idle:
+      if(!eebus_enabled) {
+        // notifyConfigChanged() wakes us when it is turned on
+        return MicroTask.Infinate;
+      }
+      if(net.isConnected() && (long)(millis() - _retry_at) >= 0) {
+        start();
+      }
+      return EEBUS_LOOP_TIME;
+
+    case Running:
+      // Failsafe values changed by the user (not the ones we stored ourselves)
+      if(eebus_failsafe_limit != _failsafe_limit || eebus_failsafe_duration != _failsafe_duration) {
+        _restart = true;
+      }
+      if(eebus_enabled && !_restart) {
+        update();
+      }
+      if(!eebus_enabled || _restart)
+      {
+        // Shutting down takes a moment and must not hold up the main loop
+        EebusAppRequestStop();
+        _state = Stopping;
+        // A node that is switched off does not limit any more
+        gridDimming.setEebusLimit(false, 0);
+        _limit_state = kEebusLimitDisabled;
+        _limited = false;
+        _limit_w = 0;
+        return 250;
+      }
+      return EEBUS_LOOP_TIME;
+
+    case Stopping:
+      if(EebusAppFinished()) {
+        EebusAppStop();
+        DBUGLN("EEBUS: node stopped");
+        _state = Idle;
+      }
+      return 250;
+  }
+
+  return EEBUS_LOOP_TIME;
+}
+
+bool EebusTask::trust(const String &ski_in, bool trust)
+{
+  String ski = ski_in;
+  ski.trim();
+  ski.toLowerCase();
+  if(!EebusAppSkiValid(ski.c_str())) {
+    return false;
+  }
+
+  // "ski,ski,..." without the one in question
+  String list;
+  uint8_t count = 0;
+  int start = 0;
+  while(start < (int)eebus_trusted.length())
+  {
+    int end = eebus_trusted.indexOf(',', start);
+    if(end < 0) {
+      end = eebus_trusted.length();
+    }
+    String entry = eebus_trusted.substring(start, end);
+    entry.trim();
+    entry.toLowerCase();
+    if(EebusAppSkiValid(entry.c_str()) && entry != ski) {
+      if(list.length() > 0) {
+        list += ',';
+      }
+      list += entry;
+      count++;
+    }
+    start = end + 1;
+  }
+
+  if(trust)
+  {
+    if(count >= EEBUS_APP_MAX_PEERS) {
+      return false;
+    }
+    if(list.length() > 0) {
+      list += ',';
+    }
+    list += ski;
+  }
+
+  config_set("eebus_trusted", list);
+  if(!trust && eebus_guard.equalsIgnoreCase(ski)) {
+    config_set("eebus_guard", String(""));
+  }
+  config_commit();
+
+  if(Running == _state) {
+    EebusAppTrust(ski.c_str(), trust);
+  }
+  return true;
+}
+
+void EebusTask::serialize(JsonDocument &doc)
+{
+  EebusAppStatus status;
+  EebusAppGetStatus(&status);
+
+  doc["enabled"] = eebus_enabled;
+  doc["running"] = Running == _state && status.running;
+  doc["ski"] = status.ski;
+  doc["port"] = EEBUS_PORT;
+  doc["state"] = EebusLimitStateName(status.limit_state);
+  doc["limited"] = status.limited;
+  doc["limit"] = status.limited ? (uint32_t)status.limit_w : 0;
+  doc["remaining"] = (int32_t)status.limit_remaining_s;
+  doc["heartbeat"] = status.heartbeat_ok;
+  doc["failsafe_limit"] = eebus_failsafe_limit;
+  doc["failsafe_duration"] = eebus_failsafe_duration;
+
+  JsonArray list = doc.createNestedArray("peers");
+  EebusAppPeer *peers = (EebusAppPeer *)malloc(sizeof(EebusAppPeer) * EEBUS_APP_MAX_PEERS);
+  if(!peers) {
+    return;
+  }
+  size_t count = EebusAppGetPeers(peers, EEBUS_APP_MAX_PEERS);
+  for(size_t i = 0; i < count; i++)
+  {
+    JsonObject peer = list.createNestedObject();
+    peer["ski"] = String(peers[i].ski);
+    peer["name"] = String(peers[i].name);
+    peer["brand"] = String(peers[i].brand);
+    peer["model"] = String(peers[i].model);
+    peer["type"] = String(peers[i].type);
+    peer["trusted"] = peers[i].trusted;
+    peer["discovered"] = peers[i].discovered;
+    peer["connected"] = peers[i].connected;
+    peer["waiting"] = peers[i].waiting_trust;
+    peer["guard"] = peers[i].guard;
+  }
+  free(peers);
+
+  // Paired nodes are listed even while the node is not running
+  if(0 == count)
+  {
+    int start = 0;
+    while(start < (int)eebus_trusted.length())
+    {
+      int end = eebus_trusted.indexOf(',', start);
+      if(end < 0) {
+        end = eebus_trusted.length();
+      }
+      String entry = eebus_trusted.substring(start, end);
+      if(EebusAppSkiValid(entry.c_str())) {
+        JsonObject peer = list.createNestedObject();
+        peer["ski"] = entry;
+        peer["trusted"] = true;
+        peer["guard"] = eebus_guard.equalsIgnoreCase(entry);
+      }
+      start = end + 1;
+    }
+  }
+}
+
+#endif // ENABLE_EEBUS
diff --git a/src/eebus.h b/src/eebus.h
new file mode 100644
index 00000000..6ba79da4
--- /dev/null
+++ b/src/eebus.h
@@ -0,0 +1,102 @@
+#ifndef _OPENEVSE_EEBUS_H
+#define _OPENEVSE_EEBUS_H
+
+// EEBUS (SHIP/SPINE): the charger as a device a grid operator's control box
+// (German §14a EnWG) or an energy manager can limit (use case LPC) and read
+// (use case MPC). Built on openeebus by NIBE; the protocol runs in its own
+// threads (eebus/app), this task connects it to the firmware:
+//   - starts and stops the node with the `eebus_enabled` setting
+//   - passes the power limit on to GridDimming
+//   - feeds it the measurements
+//   - keeps what has to survive a restart (identity, pairings, failsafe values)
+//
+// Enable with -D ENABLE_EEBUS and the extra script scripts/eebus_build.py.
+
+#ifdef ENABLE_EEBUS
+
+#ifndef EEBUS_PORT
+#define EEBUS_PORT 4712
+#endif
+
+// Brand and model announced to other nodes
+#ifndef EEBUS_BRAND
+#define EEBUS_BRAND "OpenEVSE"
+#endif
+#ifndef EEBUS_MODEL
+#ifdef KINETOS_EXTRAS
+#define EEBUS_MODEL "Kinetos"
+#else
+#define EEBUS_MODEL "EVSE"
+#endif
+#endif
+
+#ifndef EEBUS_LOOP_TIME
+#define EEBUS_LOOP_TIME 1000
+#endif
+
+// Time between two sets of measurements
+#ifndef EEBUS_MEASUREMENT_TIME
+#define EEBUS_MEASUREMENT_TIME 5000
+#endif
+
+// Wait this long before the node is started again after it failed to come up
+#ifndef EEBUS_RETRY_TIME
+#define EEBUS_RETRY_TIME 60000
+#endif
+
+#include "emonesp.h"
+#include <MicroTasks.h>
+#include <ArduinoJson.h>
+#include "evse_man.h"
+
+class EebusTask : public MicroTasks::Task
+{
+  private:
+    enum State {
+      Idle,
+      Running,
+      Stopping
+    };
+
+    EvseManager *_evse;
+    State         _state;
+    bool          _restart;           // settings changed, start the node anew
+    bool          _identity_stored;
+    uint32_t      _persist_seq;       // EebusAppStatus.persist_seq last stored
+    uint32_t      _failsafe_limit;    // failsafe values the node runs with
+    uint32_t      _failsafe_duration;
+    unsigned long _started_at;
+    unsigned long _retry_at;
+    unsigned long _measured_at;
+    uint8_t       _limit_state;       // state last published
+    bool          _limited;
+    uint32_t      _limit_w;
+
+    void start();
+    void update();
+    void measure();
+
+  protected:
+    void setup();
+    unsigned long loop(MicroTasks::WakeReason reason);
+
+  public:
+    EebusTask();
+    void begin(EvseManager &evse);
+    void notifyConfigChanged();
+
+    // Pair with a node (40 hex characters) or remove the pairing
+    bool trust(const String &ski, bool trust);
+
+    bool isLimited() { return _limited; }
+    uint32_t getLimit() { return _limit_w; }
+    const char *getStateName();
+
+    void serialize(JsonDocument &doc);
+};
+
+extern EebusTask eebus;
+
+#endif // ENABLE_EEBUS
+
+#endif // _OPENEVSE_EEBUS_H
