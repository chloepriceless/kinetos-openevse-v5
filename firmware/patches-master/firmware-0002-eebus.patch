+
+static void SetConnected(const char* ski, bool connected) {
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusAppPeer* const peer = PeerGet(ski);
+  if (peer != NULL) {
+    peer->connected = connected;
+    if (!connected) {
+      peer->waiting_trust = false;
+      PeersCleanup();
+    }
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static void OnRemoteSkiConnected(ServiceReaderObject* self, EebusServiceObject* service, const char* ski) {
+  (void)self;
+  (void)service;
+  SetConnected(ski, true);
+}
+
+static void OnRemoteSkiDisconnected(ServiceReaderObject* self, EebusServiceObject* service, const char* ski) {
+  (void)self;
+  (void)service;
+  SetConnected(ski, false);
+}
+
+static void OnRemoteServicesUpdate(ServiceReaderObject* self, EebusServiceObject* service, const Vector* entries) {
+  (void)self;
+  (void)service;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  for (size_t i = 0; i < app.peer_count; ++i) {
+    app.peers[i].discovered = false;
+  }
+  for (size_t i = 0; (entries != NULL) && (i < VectorGetSize(entries)); ++i) {
+    const MdnsEntry* const entry = (const MdnsEntry*)VectorGetElement(entries, i);
+    EebusAppPeer* const peer     = (entry != NULL) ? PeerGet(entry->ski) : NULL;
+    if (peer == NULL) {
+      continue;
+    }
+    peer->discovered = true;
+    CopyField(peer->name, sizeof(peer->name), entry->name);
+    CopyField(peer->brand, sizeof(peer->brand), entry->brand);
+    CopyField(peer->model, sizeof(peer->model), entry->model);
+    CopyField(peer->type, sizeof(peer->type), entry->type);
+  }
+  PeersCleanup();
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static void OnShipIdUpdate(ServiceReaderObject* self, const char* ski, const char* ship_id) {
+  (void)self;
+  (void)ski;
+  (void)ship_id;
+}
+
+static void OnShipStateUpdate(ServiceReaderObject* self, const char* ski, SmeState state) {
+  (void)self;
+  EEBUS_MUTEX_LOCK(app.mutex);
+  EebusAppPeer* const peer = PeerFind((ski != NULL) ? ski : "");
+  if (peer != NULL) {
+    // "Pending": our side trusts, the other side has not confirmed yet
+    peer->waiting_trust = (state == kSmeHelloStatePendingInit) || (state == kSmeHelloStatePendingListen);
+  }
+  EEBUS_MUTEX_UNLOCK(app.mutex);
+}
+
+static bool IsWaitingForTrustAllowed(const ServiceReaderObject* self, const char* ski) {
+  (void)self;
+  (void)ski;
+  return true;  // the service decides (pairing is not open, see Setup)
+}
