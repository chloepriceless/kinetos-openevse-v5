+// Same selection as evaluateClaims(): the highest-priority claim that sets a
+// max_current wins.
+uint32_t EvseManager::getMaxCurrentExcluding(EvseClient exclude)
+{
+  uint32_t max_current = UINT32_MAX;
+  int priority = 0;
+
+  for(size_t i = 0; i < EVSE_MANAGER_MAX_CLIENT_CLAIMS; i++)
+  {
+    Claim &claim = _clients[i];
+    if(claim.isValid() &&
+       claim.getClient() != exclude &&
+       claim.getPriority() > priority &&
+       claim.getMaxCurrent() != UINT32_MAX)
+    {
+      max_current = claim.getMaxCurrent();
+      priority = claim.getPriority();
+    }
+  }
+
+  return max_current;
+}
