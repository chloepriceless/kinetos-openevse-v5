diff --git a/src/kinetos/kinetos_budget.cpp b/src/kinetos/kinetos_budget.cpp
new file mode 100644
index 00000000..c54c7b46
--- /dev/null
+++ b/src/kinetos/kinetos_budget.cpp
@@ -0,0 +1,55 @@
+#ifdef KINETOS_EXTRAS
+
+#include "kinetos_budget.h"
+#include "app_config.h"
+#include "event.h"
+
+String kinetos_mqtt_ls_budget;
+
+static double s_budget = -1;
+static uint32_t s_received = 0;
+
+static bool budget_live()
+{
+  return s_budget >= 0 && millis() - s_received < KINETOS_BUDGET_TIMEOUT;
+}
+
+bool kinetos_budget_set(const String &payload)
+{
+  char *end = NULL;
+  double amps = strtod(payload.c_str(), &end);
+  if(end == payload.c_str() || amps < 0 || isnan(amps)) {
+    return false;
+  }
+  bool wasLive = budget_live();
+  s_budget = amps;
+  s_received = millis();
+
+  if(!wasLive) {
+    StaticJsonDocument<64> event;
+    event["loadsharing_budget_live"] = true;
+    event_send(event);
+  }
+  return true;
+}
+
+double kinetos_budget_effective()
+{
+  double fixed = loadsharing_group_max_current;
+  if(!budget_live()) {
+    return fixed;
+  }
+  return (fixed > 0 && fixed < s_budget) ? fixed : s_budget;
+}
+
+void kinetos_budget_status(JsonDocument &doc)
+{
+  bool live = budget_live();
+  doc["loadsharing_budget_live"] = live;
+  doc["loadsharing_budget"] = kinetos_budget_effective();
+  if(s_budget >= 0) {
+    doc["loadsharing_budget_age"] = (millis() - s_received) / 1000;
+  }
+}
+
+#endif // KINETOS_EXTRAS
diff --git a/src/kinetos/kinetos_budget.h b/src/kinetos/kinetos_budget.h
