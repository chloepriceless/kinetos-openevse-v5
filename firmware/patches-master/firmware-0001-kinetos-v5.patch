diff --git a/src/sdm_meter.cpp b/src/sdm_meter.cpp
new file mode 100644
index 00000000..b2be8c34
--- /dev/null
+++ b/src/sdm_meter.cpp
@@ -0,0 +1,195 @@
+#if defined(ENABLE_DEBUG) && !defined(ENABLE_DEBUG_SDM_METER)
+#undef ENABLE_DEBUG
+#endif
+
+#ifdef ENABLE_SDM_METER
+
+#include "sdm_meter.h"
+#include "debug.h"
+#include "event.h"
+
+#define SDM_METER_TIMEOUT     250   // ms to wait for a response
+#define SDM_METER_GAP         20    // ms between requests
+#define SDM_METER_VALID_AGE   10000 // ms a value stays valid
+#define SDM_METER_PUBLISH     10000 // ms between MQTT/websocket updates
+#define SDM_METER_ABSENT_AFTER 30000 // ms without any answer -> no meter fitted
+#define SDM_METER_PROBE       60000 // ms between probes while absent
+
+// SDM630 input registers (FC 0x04, IEEE-754 float, big-endian)
+const uint16_t SdmMeter::_registers[SdmMeter::ValueCount] = {
+  0x0000, 0x0002, 0x0004, // voltage L1-L3
+  0x0006, 0x0008, 0x000A, // current L1-L3
+  0x000C, 0x000E, 0x0010, // active power L1-L3
+  0x0034,                 // total system power
+  0x0048,                 // import active energy kWh
+  0x0156                  // total active energy kWh
+};
+
+SdmMeter::SdmMeter() :
+  MicroTasks::Task(),
+  _index(0),
+  _rxLen(0),
+  _sentAt(0),
+  _waiting(false),
+  _published(0),
+  _lastResponse(0),
+  _absent(false),
+  _requests(0),
+  _responses(0),
+  _errors(0)
+{
+  for(int i = 0; i < ValueCount; i++) {
+    _values[i] = 0;
+    _updated[i] = 0;
+  }
+}
+
+void SdmMeter::begin()
+{
+  MicroTask.startTask(this);
+}
+
+void SdmMeter::setup()
+{
+  _lastResponse = millis();
+  SDM_METER_SERIAL.begin(SDM_METER_BAUD, SERIAL_8N1, SDM_METER_RX, SDM_METER_TX);
+}
+
+uint16_t SdmMeter::crc16(const uint8_t *data, size_t len)
+{
+  uint16_t crc = 0xFFFF;
+  for(size_t i = 0; i < len; i++)
+  {
+    crc ^= data[i];
+    for(int b = 0; b < 8; b++) {
+      crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : crc >> 1;
+    }
+  }
+  return crc;
+}
+
+void SdmMeter::sendRequest()
+{
+  uint16_t reg = _registers[_index];
+  uint8_t req[8] = {
+    SDM_METER_ADDRESS, 0x04,
+    (uint8_t)(reg >> 8), (uint8_t)(reg & 0xFF),
+    0x00, 0x02,
+    0, 0
+  };
+  uint16_t crc = crc16(req, 6);
+  req[6] = crc & 0xFF;
+  req[7] = crc >> 8;
+
+  while(SDM_METER_SERIAL.available()) {
+    SDM_METER_SERIAL.read();
+  }
+  SDM_METER_SERIAL.write(req, sizeof(req));
+  _rxLen = 0;
+  _sentAt = millis();
+  _waiting = true;
+  _requests++;
+}
+
+// Response: slave, 0x04, 0x04, 4 data bytes (big-endian float), CRC lo, CRC hi
+bool SdmMeter::handleResponse()
+{
+  while(SDM_METER_SERIAL.available() && _rxLen < sizeof(_rx)) {
+    _rx[_rxLen++] = SDM_METER_SERIAL.read();
+  }
+  if(_rxLen < sizeof(_rx)) {
+    return false;
+  }
+
+  uint16_t crc = crc16(_rx, 7);
+  if(_rx[0] != SDM_METER_ADDRESS || _rx[1] != 0x04 || _rx[2] != 0x04 ||
+     _rx[7] != (crc & 0xFF) || _rx[8] != (crc >> 8))
+  {
+    DBUGF("SdmMeter: bad response for reg 0x%04x", _registers[_index]);
+    _errors++;
+    return true;
+  }
+
+  uint32_t raw = ((uint32_t)_rx[3] << 24) | ((uint32_t)_rx[4] << 16) | ((uint32_t)_rx[5] << 8) | _rx[6];
+  float value;
+  memcpy(&value, &raw, sizeof(value));
+  if(!isnan(value)) {
+    _values[_index] = value;
+    _updated[_index] = millis();
+    _responses++;
+    _lastResponse = millis();
+    _absent = false;
+  }
+  return true;
+}
+
+unsigned long SdmMeter::loop(MicroTasks::WakeReason reason)
+{
+  if(_waiting)
+  {
+    bool done = handleResponse();
+    if(!done && millis() - _sentAt < SDM_METER_TIMEOUT) {
+      return 5;
+    }
+    if(!done) {
+      _errors++;
+    }
+    _waiting = false;
+    if(!_absent && millis() - _lastResponse >= SDM_METER_ABSENT_AFTER) {
+      DBUGLN("SdmMeter: no answer, assuming no meter fitted");
+      _absent = true;
+    }
+    if(_absent) {
+      _index = 0;
+      return SDM_METER_PROBE;
+    }
+    _index = (_index + 1) % ValueCount;
+    if(0 == _index && isValid() && millis() - _published >= SDM_METER_PUBLISH) {
+      publish();
+    }
+    return SDM_METER_GAP;
+  }
+
+  sendRequest();
+  return 5;
+}
+
+// Per-phase values are not part of the monitor events, so send them to MQTT / websocket here
+void SdmMeter::publish()
+{
+  StaticJsonDocument<256> event;
+  event["amp2"] = _values[CurrentL2];
+  event["amp3"] = _values[CurrentL3];
+  event["voltage2"] = _values[VoltageL2];
+  event["voltage3"] = _values[VoltageL3];
+    event["phases"] = activePhases();
+  event["meter_import_kwh"] = _values[ImportEnergy];
+  event_send(event);
+  _published = millis();
+}
+
+bool SdmMeter::isValid()
+{
+  uint32_t now = millis();
+  for(int i = 0; i < ValueCount; i++) {
+    if(0 == _updated[i] || now - _updated[i] > SDM_METER_VALID_AGE) {
+      return false;
+    }
+  }
+  return true;
+}
+
+uint8_t SdmMeter::activePhases()
+{
+  uint8_t phases = 0;
+  for(int i = CurrentL1; i <= CurrentL3; i++) {
+    if(_values[i] > 1.0) {
+      phases++;
+    }
+  }
+  return phases;
+}
+
+SdmMeter sdmMeter;
+
+#endif // ENABLE_SDM_METER
diff --git a/src/sdm_meter.h b/src/sdm_meter.h
new file mode 100644
index 00000000..d1d6bd83
--- /dev/null
+++ b/src/sdm_meter.h
@@ -0,0 +1,82 @@
+// Eastron SDM630 / SDM72D-M (or compatible) energy meter over Modbus RTU.
+// Reads voltage, current and power per phase plus total power and energy, so boards with a
+// three-phase MID meter report real values instead of V x A x 3 from the controller's single CT.
+// Enable with -D ENABLE_SDM_METER; the RS485 transceiver must switch direction automatically.
+#ifndef SDM_METER_H
+#define SDM_METER_H
+
+#include <Arduino.h>
+#include <MicroTasks.h>
+
+#ifndef SDM_METER_SERIAL
+#define SDM_METER_SERIAL Serial2
+#endif
+#ifndef SDM_METER_RX
+#define SDM_METER_RX -1
+#endif
+#ifndef SDM_METER_TX
+#define SDM_METER_TX -1
+#endif
+#ifndef SDM_METER_BAUD
+#define SDM_METER_BAUD 9600
+#endif
+#ifndef SDM_METER_ADDRESS
+#define SDM_METER_ADDRESS 1
+#endif
+
+class SdmMeter : public MicroTasks::Task
+{
+  public:
+    enum Value {
+      VoltageL1, VoltageL2, VoltageL3,
+      CurrentL1, CurrentL2, CurrentL3,
+      PowerL1, PowerL2, PowerL3,
+      PowerTotal, ImportEnergy, TotalEnergy,
+      ValueCount
+    };
+
+  private:
+    static const uint16_t _registers[ValueCount];
+    float _values[ValueCount];
+    uint32_t _updated[ValueCount];
+    uint8_t _index;
+    uint8_t _rx[9];
+    uint8_t _rxLen;
+    uint32_t _sentAt;
+    bool _waiting;
+    uint32_t _published;
+    uint32_t _lastResponse;
+    bool _absent;
+    uint32_t _requests;
+    uint32_t _responses;
+    uint32_t _errors;
+
+    static uint16_t crc16(const uint8_t *data, size_t len);
+    void sendRequest();
+    bool handleResponse();
+    void publish();
+
+  protected:
+    void setup();
+    unsigned long loop(MicroTasks::WakeReason reason);
+
+  public:
+    SdmMeter();
+    void begin();
+
+    // True when every value was refreshed within the last 10 s
+    bool isValid();
+    // false once the meter has not answered for 30 s (no meter fitted); probed once a minute
+    bool isPresent() { return !_absent; }
+    float get(Value v) { return _values[v]; }
+    // Number of phases currently carrying more than 1 A
+    uint8_t activePhases();
+
+    uint32_t getRequests() { return _requests; }
+    uint32_t getResponses() { return _responses; }
+    uint32_t getErrors() { return _errors; }
+};
+
+extern SdmMeter sdmMeter;
+
+#endif // SDM_METER_H
