@@ -0,0 +1,95 @@
+#ifndef _OPENEVSE_MODBUS_TCP_PROTOCOL_H
+#define _OPENEVSE_MODBUS_TCP_PROTOCOL_H
+
+// Pure Modbus TCP frame handling and the smart1-compatible register map.
+// No Arduino/Mongoose includes, so it is host-testable (test/test_modbus_tcp).
+// The network side and the EvseManager glue live in modbus_tcp.cpp.
+
+#include <stdint.h>
+#include <stddef.h>
+
+#define MODBUS_TCP_MBAP_SIZE            7     // transaction, protocol, length, unit
+#define MODBUS_TCP_MAX_FRAME            260   // MBAP + max PDU (253)
+
+#define MODBUS_FC_READ_HOLDING          0x03
+#define MODBUS_FC_READ_INPUT            0x04
+#define MODBUS_FC_WRITE_SINGLE          0x06
+#define MODBUS_FC_WRITE_MULTIPLE        0x10
+
+#define MODBUS_EX_ILLEGAL_FUNCTION      0x01
+#define MODBUS_EX_ILLEGAL_ADDRESS       0x02
+#define MODBUS_EX_ILLEGAL_VALUE         0x03
+#define MODBUS_EX_GATEWAY_TARGET_FAILED 0x0B
+
+#define MODBUS_TCP_MAX_READ             125
+#define MODBUS_TCP_MAX_WRITE            123
+
+// Register blocks of the smart1 layout
+#define MODBUS_SMART1_POWER_CONTROL     1599  // 1599..1602
+#define MODBUS_SMART1_CURRENT_CONTROL   1999  // 1999..2002
+#define MODBUS_SMART1_CONTROL_SIZE      4
+
+#define MODBUS_SMART1_MIN_CURRENT_CA    600   // 6.00 A
+#define MODBUS_SMART1_MAX_CURRENT_CA    8000  // 80.00 A
+
+class ModbusRegisterHandler
+{
+  public:
+    virtual ~ModbusRegisterHandler() {}
+    // Returns false if the address is not readable (exception 2)
+    virtual bool readRegister(uint16_t addr, uint16_t &value) = 0;
+    // Writes count consecutive registers; returns 0 or a Modbus exception code
+    virtual uint8_t writeRegisters(uint16_t start, uint16_t count, const uint16_t *values) = 0;
+};
+
+// Handles one Modbus TCP request at the start of buf.
+//   > 0  bytes consumed; response written to resp (MODBUS_TCP_MAX_FRAME bytes), length in resp_len
+//   0    incomplete frame, wait for more data
+//   < 0  malformed frame, the connection should be closed
+// Requests for unit_id, 0 or 255 are served, any other unit gets exception 0x0B.
+int modbus_tcp_process(const uint8_t *buf, size_t len, uint8_t unit_id,
+                       ModbusRegisterHandler &handler, uint8_t *resp, size_t &resp_len);
+
+// One control block (1599..1602 power in W, 1999..2002 current in 0.01 A)
+struct ModbusSmart1Control
+{
+  uint16_t setpoint;
+  uint16_t pause;       // 1 = pause while charging
+  uint16_t start_stop;  // 1 = enable, 2 = disable
+  uint16_t timeout;     // watchdog in s, 0 = off
+};
+
+// Snapshot of everything the read side of the register map needs
+struct ModbusSmart1Data
+{
+  uint8_t evse_state;          // OPENEVSE_STATE_*
+  bool fault;
+  bool session;                // a charge started since the vehicle was plugged in
+  bool waiting_for_auth;       // RFID enabled and no tag authenticated
+  uint16_t max_hardware_current;
+  uint16_t max_configured_current;
+  uint16_t charge_current;
+  uint16_t min_current;
+  uint32_t power;              // W
+  uint32_t power_l1;           // W, 0 if unknown
+  uint32_t power_l2;
+  uint32_t power_l3;
+  uint32_t total_energy;       // kWh
+  uint32_t session_energy;     // Wh
+  uint32_t session_elapsed;    // s
+  uint32_t start_time;         // hhmmss local time, 0 = none
+  uint32_t stop_time;          // hhmmss local time, 0 = none
+  ModbusSmart1Control power_control;
+  ModbusSmart1Control current_control;
+};
+
+// Returns false if addr is not part of the register map
+bool modbus_smart1_read(uint16_t addr, const ModbusSmart1Data &data, uint16_t &value);
+
+// Power setpoint (W) to whole amps, 0 if it cannot be converted
+uint32_t modbus_smart1_power_to_amps(uint16_t watts, double volts, uint8_t phases);
+
+// Current setpoint (0.01 A) to whole amps, 0 if out of range
+uint32_t modbus_smart1_current_to_amps(uint16_t centiamps);
+
+#endif // _OPENEVSE_MODBUS_TCP_PROTOCOL_H
