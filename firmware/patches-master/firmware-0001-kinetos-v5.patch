diff --git a/src/modbus_tcp.cpp b/src/modbus_tcp.cpp
new file mode 100644
index 00000000..64482fd1
--- /dev/null
+++ b/src/modbus_tcp.cpp
@@ -0,0 +1,324 @@
+#if defined(ENABLE_DEBUG) && !defined(ENABLE_DEBUG_MODBUS_TCP)
+#undef ENABLE_DEBUG
+#endif
+
+#include <time.h>
+#include <openevse.h>
+
+#include "modbus_tcp.h"
+#include "app_config.h"
+#include "rfid.h"
+#include "debug.h"
+
+// modbus_tcp_protocol.cpp mirrors these values
+static_assert(OPENEVSE_STATE_STARTING == 0 && OPENEVSE_STATE_NOT_CONNECTED == 1 &&
+              OPENEVSE_STATE_CONNECTED == 2 && OPENEVSE_STATE_CHARGING == 3 &&
+              OPENEVSE_STATE_VENT_REQUIRED == 4 && OPENEVSE_STATE_DIODE_CHECK_FAILED == 5 &&
+              OPENEVSE_STATE_GFI_FAULT == 6 && OPENEVSE_STATE_SLEEPING == 254,
+              "modbus_tcp_protocol.cpp state values out of sync with openevse.h");
+
+ModbusTcpServer modbusTcp;
+
+ModbusTcpServer::ModbusTcpServer() :
+  MicroTasks::Task(),
+  _evse(NULL),
+  _listener(NULL),
+  _port(0),
+  _clients(0),
+  _last_state(OPENEVSE_STATE_STARTING),
+  _session(false),
+  _start_time(0),
+  _stop_time(0),
+  _power(),
+  _current(),
+  _props(EvseState::None),
+  _data()
+{
+}
+
+void ModbusTcpServer::begin(EvseManager &evse)
+{
+  _evse = &evse;
+  MicroTask.startTask(this);
+}
+
+void ModbusTcpServer::notifyConfigChanged()
+{
+  MicroTask.wakeTask(this);
+}
+
+void ModbusTcpServer::setup()
+{
+}
+
+unsigned long ModbusTcpServer::loop(MicroTasks::WakeReason reason)
+{
+  if(modbus_tcp_enabled)
+  {
+    if(NULL != _listener && _port != modbus_tcp_port) {
+      stopListener();
+    }
+    if(NULL == _listener) {
+      startListener();
+    }
+  }
+  else if(NULL != _listener)
+  {
+    stopListener();
+    releaseControl();
+  }
+
+  trackSession();
+
+  // Watchdog: no fresh setpoint within the timeout pauses charging
+  if(_evse->isCharging() && (watchdogExpired(_power) || watchdogExpired(_current)))
+  {
+    DBUGLN("ModbusTcp: watchdog expired, pausing");
+    _power.watchdog = false;
+    _current.watchdog = false;
+    pause();
+  }
+
+  return MODBUS_TCP_LOOP_TIME;
+}
+
+bool ModbusTcpServer::startListener()
+{
+  char address[8];
+  snprintf(address, sizeof(address), "%u", (unsigned int)(modbus_tcp_port & 0xFFFF));
+  _listener = mg_bind(Mongoose.getMgr(), address, handler, this);
+  _port = modbus_tcp_port;
+  DBUGF("ModbusTcp: listener on port %s %s", address, _listener ? "started" : "failed");
+  return NULL != _listener;
+}
+
+void ModbusTcpServer::stopListener()
+{
+  // Close the listener and every client accepted from it
+  mg_mgr *mgr = Mongoose.getMgr();
+  for(struct mg_connection *c = mg_next(mgr, NULL); NULL != c; c = mg_next(mgr, c))
+  {
+    if(c == _listener || (NULL != _listener && c->listener == _listener)) {
+      c->flags |= MG_F_CLOSE_IMMEDIATELY;
+    }
+  }
+  _listener = NULL;
+  DBUGLN("ModbusTcp: listener stopped");
+}
+
+void ModbusTcpServer::handler(struct mg_connection *nc, int ev, void *p, void *u)
+{
+  ModbusTcpServer *self = (ModbusTcpServer *)u;
+  switch(ev)
+  {
+    case MG_EV_ACCEPT:
+      if(++self->_clients > MODBUS_TCP_MAX_CLIENTS) {
+        DBUGLN("ModbusTcp: too many clients");
+        nc->flags |= MG_F_CLOSE_IMMEDIATELY;
+      }
+      break;
+
+    case MG_EV_RECV:
+      self->onReceive(nc);
+      break;
+
+    case MG_EV_POLL:
+      if(NULL != nc->listener && mg_time() - nc->last_io_time > MODBUS_TCP_IDLE_TIMEOUT) {
+        nc->flags |= MG_F_CLOSE_IMMEDIATELY;
+      }
+      break;
+
+    case MG_EV_CLOSE:
+      if(NULL != nc->listener && self->_clients > 0) {
+        self->_clients--;
+      }
+      break;
+  }
+}
+
+void ModbusTcpServer::onReceive(struct mg_connection *nc)
+{
+  struct mbuf *io = &nc->recv_mbuf;
+  uint8_t resp[MODBUS_TCP_MAX_FRAME];
+
+  while(io->len > 0)
+  {
+    size_t resp_len = 0;
+    refreshData();
+    int used = modbus_tcp_process((const uint8_t *)io->buf, io->len, MODBUS_TCP_UNIT_ID, *this, resp, resp_len);
+    if(0 == used) {
+      break;
+    }
+    if(used < 0) {
+      DBUGLN("ModbusTcp: malformed frame, closing");
+      nc->flags |= MG_F_CLOSE_IMMEDIATELY;
+      break;
+    }
+    mg_send(nc, resp, resp_len);
+    mbuf_remove(io, used);
+  }
+}
+
+uint32_t ModbusTcpServer::timeOfDay()
+{
+  time_t t = time(NULL);
+  if(t < 1000000000) { // clock not set yet
+    return 0;
+  }
+  struct tm lt;
+  localtime_r(&t, &lt);
+  return lt.tm_hour * 10000 + lt.tm_min * 100 + lt.tm_sec;
+}
+
+void ModbusTcpServer::trackSession()
+{
+  uint8_t state = _evse->getEvseState();
+  if(state == _last_state) {
+    return;
+  }
+  if(OPENEVSE_STATE_CHARGING == state && !_session) {
+    _session = true;
+    _start_time = timeOfDay();
+    _stop_time = 0;
+  } else if(OPENEVSE_STATE_CONNECTED == state && _session) {
+    _stop_time = timeOfDay();
+  } else if(OPENEVSE_STATE_NOT_CONNECTED == state) {
+    _session = false;
+    _power.watchdog = false;
+    _current.watchdog = false;
+  }
+  _last_state = state;
+}
+
+void ModbusTcpServer::refreshData()
+{
+  _data.evse_state = _evse->getEvseState();
+  _data.fault = _evse->isError();
+  _data.session = _session;
+  _data.waiting_for_auth = config_rfid_enabled() && rfid.getAuthenticatedTag().isEmpty();
+  _data.max_hardware_current = _evse->getMaxHardwareCurrent();
+  _data.max_configured_current = _evse->getMaxConfiguredCurrent();
+  _data.charge_current = _evse->getChargeCurrent();
+  _data.min_current = _evse->getMinCurrent();
+  _data.power = (uint32_t)_evse->getPower();
+  // No per-phase measurement source yet, registers 1102..1107 read 0
+  _data.power_l1 = 0;
+  _data.power_l2 = 0;
+  _data.power_l3 = 0;
+  _data.total_energy = (uint32_t)_evse->getTotalEnergy();
+  _data.session_energy = (uint32_t)_evse->getSessionEnergy();
+  _data.session_elapsed = _evse->getSessionElapsed();
+  _data.start_time = _start_time;
+  _data.stop_time = _stop_time;
+  _data.power_control = _power.regs;
+  _data.current_control = _current.regs;
+}
+
+bool ModbusTcpServer::readRegister(uint16_t addr, uint16_t &value)
+{
+  return modbus_smart1_read(addr, _data, value);
+}
+
+uint8_t ModbusTcpServer::writeRegisters(uint16_t start, uint16_t count, const uint16_t *values)
+{
+  Control *c = NULL;
+  uint16_t base = 0;
+  uint32_t end = (uint32_t)start + count;
+  if(start >= MODBUS_SMART1_POWER_CONTROL && end <= MODBUS_SMART1_POWER_CONTROL + MODBUS_SMART1_CONTROL_SIZE) {
+    c = &_power;
+    base = MODBUS_SMART1_POWER_CONTROL;
+  } else if(start >= MODBUS_SMART1_CURRENT_CONTROL && end <= MODBUS_SMART1_CURRENT_CONTROL + MODBUS_SMART1_CONTROL_SIZE) {
+    c = &_current;
+    base = MODBUS_SMART1_CURRENT_CONTROL;
+  } else {
+    return MODBUS_EX_ILLEGAL_ADDRESS;
+  }
+
+  for(uint16_t i = 0; i < count; i++)
+  {
+    switch(start - base + i)
+    {
+      case 0: c->regs.setpoint = values[i]; break;
+      case 1: c->regs.pause = values[i]; break;
+      case 2: c->regs.start_stop = values[i]; break;
+      case 3: c->regs.timeout = values[i]; break;
+    }
+  }
+
+  // Apply once per request, so a block written with FC 16 acts as one command
+  applyControl(*c, c == &_power);
+  return 0;
+}
+
+void ModbusTcpServer::applyControl(Control &c, bool is_power)
+{
+  if(0 == c.regs.timeout) {
+    c.watchdog = false;
+  }
+
+  if(0 != c.regs.setpoint)
+  {
+    uint32_t amps = is_power ?
+      modbus_smart1_power_to_amps(c.regs.setpoint, _evse->getVoltage(), config_threephase_enabled() ? 3 : 1) :
+      modbus_smart1_current_to_amps(c.regs.setpoint);
+    DBUGF("ModbusTcp: %s setpoint %u -> %uA", is_power ? "power" : "current", c.regs.setpoint, amps);
+    if(amps > 0)
+    {
+      _props.setChargeCurrent(amps);
+      claim();
+      if(c.regs.timeout) {
+        c.watchdog = true;
+        c.deadline = millis() + c.regs.timeout * 1000UL;
+      }
+    }
+  }
+
+  if(1 == c.regs.pause && _evse->isCharging()) {
+    pause();
+  }
+
+  if(1 == c.regs.start_stop) {
+    enable();
+  } else if(2 == c.regs.start_stop) {
+    pause();
+  } else if(0 == _power.regs.setpoint && 0 == _power.regs.pause && 0 == _power.regs.start_stop &&
+            0 == _current.regs.setpoint && 0 == _current.regs.pause && 0 == _current.regs.start_stop)
+  {
+    // Extension: all control registers 0 hands control back
+    releaseControl();
+  }
+}
+
+bool ModbusTcpServer::watchdogExpired(Control &c)
+{
+  return c.watchdog && (long)(millis() - c.deadline) >= 0;
+}
+
+void ModbusTcpServer::claim()
+{
+  _evse->claim(EvseClient_OpenEVSE_ModbusTcp, EvseManager_Priority_API, _props);
+}
+
+void ModbusTcpServer::pause()
+{
+  _props.setState(EvseState::Disabled);
+  claim();
+}
+
+void ModbusTcpServer::enable()
+{
+  _props.setState(EvseState::Active);
+  claim();
+}
+
+void ModbusTcpServer::releaseControl()
+{
+  if(_evse->clientHasClaim(EvseClient_OpenEVSE_ModbusTcp)) {
+    DBUGLN("ModbusTcp: releasing claim");
+    _evse->release(EvseClient_OpenEVSE_ModbusTcp);
+  }
+  EvseProperties none(EvseState::None);
+  _props = none;
+  _power = Control();
+  _current = Control();
+}
diff --git a/src/modbus_tcp.h b/src/modbus_tcp.h
new file mode 100644
index 00000000..df2da747
--- /dev/null
+++ b/src/modbus_tcp.h
@@ -0,0 +1,91 @@
+#ifndef _OPENEVSE_MODBUS_TCP_H
+#define _OPENEVSE_MODBUS_TCP_H
+
+// Modbus TCP server for energy management systems. The register map follows
+// the smart1 EMS layout used by Kinetos wallboxes (see docs/user/modbus-tcp.md).
+// Control writes go through an EvseManager claim (EvseClient_OpenEVSE_ModbusTcp,
+// API priority), so they coexist with the other clients.
+//
+// There is no authentication: the server is off by default (modbus_tcp_enabled).
+
+#ifndef MODBUS_TCP_LOOP_TIME
+#define MODBUS_TCP_LOOP_TIME 500
+#endif
+
+#ifndef MODBUS_TCP_UNIT_ID
+#define MODBUS_TCP_UNIT_ID 1
+#endif
+
+#ifndef MODBUS_TCP_MAX_CLIENTS
+#define MODBUS_TCP_MAX_CLIENTS 4
+#endif
+
+// Close client connections without traffic for this long (s)
+#ifndef MODBUS_TCP_IDLE_TIMEOUT
+#define MODBUS_TCP_IDLE_TIMEOUT 300
+#endif
+
+#include <Arduino.h>
+#include <MicroTasks.h>
+#include <MongooseCore.h>
+
+#include "evse_man.h"
+#include "modbus_tcp_protocol.h"
+
+class ModbusTcpServer : public MicroTasks::Task, public ModbusRegisterHandler
+{
+  private:
+    struct Control {
+      ModbusSmart1Control regs;
+      bool watchdog;
+      uint32_t deadline;   // millis()
+    };
+
+    EvseManager *_evse;
+    struct mg_connection *_listener;
+    uint32_t _port;
+    uint8_t _clients;
+    uint8_t _last_state;
+    bool _session;
+    uint32_t _start_time;
+    uint32_t _stop_time;
+    Control _power;
+    Control _current;
+    EvseProperties _props;
+    ModbusSmart1Data _data;
+
+    static void handler(struct mg_connection *nc, int ev, void *p, void *u);
+    void onReceive(struct mg_connection *nc);
+    bool startListener();
+    void stopListener();
+    void refreshData();
+    void trackSession();
+    void applyControl(Control &c, bool is_power);
+    bool watchdogExpired(Control &c);
+    void claim();
+    void pause();
+    void enable();
+    void releaseControl();
+    static uint32_t timeOfDay();
+
+  protected:
+    void setup();
+    unsigned long loop(MicroTasks::WakeReason reason);
+
+  public:
+    ModbusTcpServer();
+    void begin(EvseManager &evse);
+    void notifyConfigChanged();
+
+    bool isListening() {
+      return NULL != _listener;
+    }
+
+    // ModbusRegisterHandler
+    bool readRegister(uint16_t addr, uint16_t &value);
+    uint8_t writeRegisters(uint16_t start, uint16_t count, const uint16_t *values);
+};
+
+extern ModbusTcpServer modbusTcp;
+
+#endif // _OPENEVSE_MODBUS_TCP_H
diff --git a/src/modbus_tcp_protocol.cpp b/src/modbus_tcp_protocol.cpp
new file mode 100644
index 00000000..73aa4c07
--- /dev/null
+++ b/src/modbus_tcp_protocol.cpp
@@ -0,0 +1,225 @@
+#include <string.h>
+
+#include "modbus_tcp_protocol.h"
+
+// Mirror of the OPENEVSE_STATE_* values used below (openevse.h is not
+// available to host tests); modbus_tcp.cpp static_asserts that they match.
+#define STATE_STARTING            0
+#define STATE_NOT_CONNECTED       1
+#define STATE_CONNECTED           2
+#define STATE_CHARGING            3
+#define STATE_VENT_REQUIRED       4
+#define STATE_DIODE_CHECK_FAILED  5
+#define STATE_GFI_FAULT           6
+#define STATE_SLEEPING            254
+
+static inline uint16_t get_u16(const uint8_t *p)
+{
+  return (uint16_t)((p[0] << 8) | p[1]);
+}
+
+static inline void put_u16(uint8_t *p, uint16_t v)
+{
+  p[0] = v >> 8;
+  p[1] = v & 0xFF;
+}
+
+int modbus_tcp_process(const uint8_t *buf, size_t len, uint8_t unit_id,
+                       ModbusRegisterHandler &handler, uint8_t *resp, size_t &resp_len)
+{
+  resp_len = 0;
+  if(len < MODBUS_TCP_MBAP_SIZE + 1) {
+    return 0;
+  }
+
+  uint16_t protocol = get_u16(buf + 2);
+  uint16_t length = get_u16(buf + 4); // unit + PDU
+  if(0 != protocol || length < 2 || length > MODBUS_TCP_MAX_FRAME - 6) {
+    return -1;
+  }
+  size_t frame = 6 + length;
+  if(len < frame) {
+    return 0;
+  }
+
+  uint8_t unit = buf[6];
+  uint8_t fc = buf[7];
+  const uint8_t *pdu = buf + 8;
+  size_t pdu_len = length - 2; // data after the function code
+  uint8_t exception = 0;
+  size_t n = 8;
+
+  if(unit != unit_id && unit != 0 && unit != 0xFF)
+  {
+    exception = MODBUS_EX_GATEWAY_TARGET_FAILED;
+  }
+  else if(MODBUS_FC_READ_HOLDING == fc || MODBUS_FC_READ_INPUT == fc)
+  {
+    uint16_t start = pdu_len >= 4 ? get_u16(pdu) : 0;
+    uint16_t count = pdu_len >= 4 ? get_u16(pdu + 2) : 0;
+    if(count < 1 || count > MODBUS_TCP_MAX_READ) {
+      exception = MODBUS_EX_ILLEGAL_VALUE;
+    } else {
+      resp[n++] = count * 2;
+      for(uint16_t i = 0; i < count; i++)
+      {
+        uint16_t value;
+        if(!handler.readRegister(start + i, value)) {
+          exception = MODBUS_EX_ILLEGAL_ADDRESS;
+          break;
+        }
+        put_u16(resp + n, value);
+        n += 2;
+      }
+    }
+  }
+  else if(MODBUS_FC_WRITE_SINGLE == fc)
+  {
+    if(pdu_len < 4) {
+      exception = MODBUS_EX_ILLEGAL_VALUE;
+    } else {
+      uint16_t value = get_u16(pdu + 2);
+      exception = handler.writeRegisters(get_u16(pdu), 1, &value);
+      if(!exception) {
+        memcpy(resp + n, pdu, 4); // echo address and value
+        n += 4;
+      }
+    }
+  }
+  else if(MODBUS_FC_WRITE_MULTIPLE == fc)
+  {
+    uint16_t count = pdu_len >= 5 ? get_u16(pdu + 2) : 0;
+    uint8_t bytes = pdu_len >= 5 ? pdu[4] : 0;
+    if(count < 1 || count > MODBUS_TCP_MAX_WRITE || bytes != count * 2 || pdu_len < 5u + bytes) {
+      exception = MODBUS_EX_ILLEGAL_VALUE;
+    } else {
+      uint16_t values[MODBUS_TCP_MAX_WRITE];
+      for(uint16_t i = 0; i < count; i++) {
+        values[i] = get_u16(pdu + 5 + i * 2);
+      }
+      exception = handler.writeRegisters(get_u16(pdu), count, values);
+      if(!exception) {
+        memcpy(resp + n, pdu, 4); // echo start address and count
+        n += 4;
+      }
+    }
+  }
+  else
+  {
+    exception = MODBUS_EX_ILLEGAL_FUNCTION;
+  }
+
+  memcpy(resp, buf, 4); // transaction and protocol id
+  resp[6] = unit;
+  if(exception) {
+    resp[7] = fc | 0x80;
+    resp[8] = exception;
+    n = 9;
+  } else {
+    resp[7] = fc;
+  }
+  put_u16(resp + 4, (uint16_t)(n - 6));
+  resp_len = n;
+  return (int)frame;
+}
+
+static bool read_control(uint16_t offset, const ModbusSmart1Control &c, uint16_t &value)
+{
+  switch(offset)
+  {
+    case 0: value = c.setpoint; return true;
+    case 1: value = c.pause; return true;
+    case 2: value = c.start_stop; return true;
+    case 3: value = c.timeout; return true;
+  }
+  return false;
+}
+
+bool modbus_smart1_read(uint16_t addr, const ModbusSmart1Data &d, uint16_t &value)
+{
+  uint8_t state = d.evse_state;
+  bool off = state >= STATE_SLEEPING || STATE_STARTING == state;
+  uint32_t u32 = 0;
+
+  value = 0;
+  switch(addr)
+  {
+    // Charge point status, 999..1006
+    case 999: return true;
+    case 1000:
+      switch(state) {
+        case STATE_NOT_CONNECTED:      value = 2; break;
+        case STATE_CONNECTED:          value = d.session ? 12 : 7; break;
+        case STATE_CHARGING:           value = 9; break;
+        case STATE_VENT_REQUIRED:      value = d.session ? 11 : 10; break;
+        case STATE_DIODE_CHECK_FAILED: value = 13; break;
+        case STATE_GFI_FAULT:          value = 14; break;
+        default:                       value = d.fault ? 13 : 0; break;
+      }
+      return true;
+    case 1001:
+      if(STATE_CONNECTED == state && d.session) value = 5;
+      else if(STATE_CHARGING == state) value = 2;
+      else if(d.fault) value = 7;
+      else if(off) value = d.waiting_for_auth ? 1 : (d.session ? 4 : 0);
+      return true;
+    case 1002: value = off ? 0 : 1; return true;
+    case 1003: value = d.waiting_for_auth ? (off ? 3 : 2) : 1; return true;
+    case 1004: value = d.max_hardware_current; return true;
+    case 1005: value = d.max_configured_current; return true;
+    case 1006: value = d.charge_current; return true;
+
+    // Measurements, 1099..1111 (32 bit values low word first)
+    case 1099: return true;
+    case 1100: case 1101: u32 = d.power; break;
+    case 1102: case 1103: u32 = d.power_l1; break;
+    case 1104: case 1105: u32 = d.power_l2; break;
+    case 1106: case 1107: u32 = d.power_l3; break;
+    case 1108: case 1109: u32 = d.total_energy; break;
+    case 1110: value = d.min_current; return true;
+    case 1111: value = d.fault ? state : 0; return true;
+
+    // Charging session, 1199..1228
+    case 1220: case 1221: u32 = d.session_energy; break;
+    case 1222: value = d.session_elapsed > 0xFFFF ? 0xFFFF : (uint16_t)d.session_elapsed; return true;
+    case 1224: case 1225: u32 = d.start_time; break;
+    case 1226: case 1227: u32 = d.stop_time; break;
+    case 1228:
+      if(!d.session) value = 0;
+      else if(STATE_CHARGING == state) value = 1;
+      else if(off) value = 2;
+      else value = 3;
+      return true;
+
+    default:
+      if(addr >= MODBUS_SMART1_POWER_CONTROL && addr < MODBUS_SMART1_POWER_CONTROL + MODBUS_SMART1_CONTROL_SIZE) {
+        return read_control(addr - MODBUS_SMART1_POWER_CONTROL, d.power_control, value);
+      }
+      if(addr >= MODBUS_SMART1_CURRENT_CONTROL && addr < MODBUS_SMART1_CURRENT_CONTROL + MODBUS_SMART1_CONTROL_SIZE) {
+        return read_control(addr - MODBUS_SMART1_CURRENT_CONTROL, d.current_control, value);
+      }
+      // Unused addresses in the session blocks read 0 (1299..1327 is the
+      // second charge point of the layout, always empty here)
+      return (addr >= 1199 && addr <= 1228) || (addr >= 1299 && addr <= 1327);
+  }
+
+  // 32 bit value: even address = low word
+  value = (addr % 2 == 0) ? (u32 & 0xFFFF) : (u32 >> 16);
+  return true;
+}
+
+uint32_t modbus_smart1_power_to_amps(uint16_t watts, double volts, uint8_t phases)
+{
+  if(volts <= 0 || 0 == phases) {
+    return 0;
+  }
+  return (uint32_t)(watts / (volts * phases));
+}
+
+uint32_t modbus_smart1_current_to_amps(uint16_t centiamps)
+{
+  if(centiamps < MODBUS_SMART1_MIN_CURRENT_CA || centiamps > MODBUS_SMART1_MAX_CURRENT_CA) {
+    return 0;
+  }
+  return centiamps / 100;
+}
