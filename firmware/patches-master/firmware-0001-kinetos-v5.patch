+++ b/src/kinetos/kinetos_budget.h
@@ -0,0 +1,27 @@
+// Live group budget for load sharing: an energy manager or a grid meter script publishes the
+// current the whole group may draw right now (A). The controller then shares
+// min(live budget, loadsharing_group_max_current) instead of the fixed value.
+// Topics: "<mqtt_topic>/loadsharing/budget/set" and, if set, config "mqtt_ls_budget".
+// No update for KINETOS_BUDGET_TIMEOUT -> back to the fixed loadsharing_group_max_current.
+#ifndef KINETOS_BUDGET_H
+#define KINETOS_BUDGET_H
+
+#ifdef KINETOS_EXTRAS
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+
+#define KINETOS_BUDGET_TIMEOUT (120UL * 1000UL)
+
+extern String kinetos_mqtt_ls_budget;
+
+// Returns false if the payload is not a number >= 0
+bool kinetos_budget_set(const String &payload);
+
+// Budget to share now (A)
+double kinetos_budget_effective();
+
+void kinetos_budget_status(JsonDocument &doc);
+
+#endif // KINETOS_EXTRAS
+#endif // KINETOS_BUDGET_H
diff --git a/src/kinetos/kinetos_crash.cpp b/src/kinetos/kinetos_crash.cpp
new file mode 100644
index 00000000..34cbd321
--- /dev/null
+++ b/src/kinetos/kinetos_crash.cpp
@@ -0,0 +1,66 @@
+// Crash trap: the Kinetos board has UART0 wired to the EVSE controller, so panic output is never
+// visible. The panic handler is wrapped (-Wl,--wrap=esp_panic_handler) to keep the exception
+// cause, reason and a backtrace in RTC memory, which survives the reboot. /status reports it as
+// "last_panic"; decode the addresses with xtensa-esp32-elf-addr2line against firmware.elf.
+#ifdef KINETOS_EXTRAS
+
+#include <Arduino.h>
+#include <string.h>
+#include <esp_attr.h>
+#include <esp_debug_helpers.h>
+#include <esp_private/panic_internal.h>
+#include <freertos/xtensa_context.h>
+#include "kinetos_crash.h"
+
+#define KINETOS_CRASH_MAGIC 0x4B434F52 // "KCOR"
+
+RTC_NOINIT_ATTR static KinetosCrash s_crash;
+
+extern "C" void __real_esp_panic_handler(panic_info_t *info);
+
+extern "C" void IRAM_ATTR __wrap_esp_panic_handler(panic_info_t *info)
+{
+  memset(&s_crash, 0, sizeof(s_crash));
+  s_crash.core = info->core;
+  s_crash.exception = info->exception;
+  if(info->reason) {
+    strncpy(s_crash.reason, info->reason, sizeof(s_crash.reason) - 1);
+  }
+  if(info->description) {
+    strncpy(s_crash.description, info->description, sizeof(s_crash.description) - 1);
+  }
+
+  const XtExcFrame *frame = (const XtExcFrame *)info->frame;
+  if(frame)
+  {
+    s_crash.pc = frame->pc;
+    s_crash.exccause = frame->exccause;
+    s_crash.excvaddr = frame->excvaddr;
+
+    esp_backtrace_frame_t bt = {
+      .pc = (uint32_t)frame->pc,
+      .sp = (uint32_t)frame->a1,
+      .next_pc = (uint32_t)frame->a0
+    };
+    s_crash.backtrace[0] = esp_cpu_process_stack_pc(bt.pc);
+    s_crash.depth = 1;
+    while(s_crash.depth < KINETOS_CRASH_DEPTH && bt.next_pc != 0 && esp_backtrace_get_next_frame(&bt)) {
+      s_crash.backtrace[s_crash.depth++] = esp_cpu_process_stack_pc(bt.pc);
+    }
+  }
+  s_crash.magic = KINETOS_CRASH_MAGIC;
+
+  __real_esp_panic_handler(info);
+}
+
+const KinetosCrash *kinetos_last_crash()
+{
+  return KINETOS_CRASH_MAGIC == s_crash.magic ? &s_crash : NULL;
+}
+
+void kinetos_clear_crash()
+{
+  s_crash.magic = 0;
+}
+
+#endif // KINETOS_EXTRAS
diff --git a/src/kinetos/kinetos_crash.h b/src/kinetos/kinetos_crash.h
new file mode 100644
index 00000000..ad62e13a
--- /dev/null
+++ b/src/kinetos/kinetos_crash.h
@@ -0,0 +1,25 @@
+#ifndef KINETOS_CRASH_H
+#define KINETOS_CRASH_H
+
+#include <stdint.h>
+
+#define KINETOS_CRASH_DEPTH 16
+
+struct KinetosCrash {
+  uint32_t magic;
+  int core;
+  int exception;
+  uint32_t pc;
+  uint32_t exccause;
+  uint32_t excvaddr;
+  char reason[48];
+  char description[48];
+  uint32_t depth;
+  uint32_t backtrace[KINETOS_CRASH_DEPTH];
+};
+
+// Last panic recorded before the current boot, or NULL
+const KinetosCrash *kinetos_last_crash();
+void kinetos_clear_crash();
+
+#endif // KINETOS_CRASH_H
diff --git a/src/kinetos/kinetos_extras.cpp b/src/kinetos/kinetos_extras.cpp
new file mode 100644
index 00000000..7ed060d3
--- /dev/null
+++ b/src/kinetos/kinetos_extras.cpp
@@ -0,0 +1,202 @@
+#ifdef KINETOS_EXTRAS
+
+#include <esp_system.h>
+
+#include "kinetos_extras.h"
+#include "kinetos_crash.h"
+#include "kinetos_led.h"
+#include "app_config.h"
+#include "grid_dimming.h"
+#include "kinetos_budget.h"
+#include "sdm_meter.h"
+#include "input.h"
+#include "evse_man.h"
+#include "debug.h"
+#include <MicroTasks.h>
+
+extern EvseManager evse;
+
+bool kinetos_led_pv_enabled;
+uint8_t kinetos_led_fx_charge;
+bool kinetos_ha_enabled;
+String kinetos_lcd_splash;
+bool kinetos_lightshow_enabled;
+uint8_t kinetos_config_ver;
+uint8_t kinetos_legacy_p14a_pin;
+uint32_t kinetos_legacy_p14a_limit;
+uint32_t kinetos_legacy_charge_count;
+String kinetos_legacy_evse_id;
+
+#define KINETOS_CONFIG_VER 2
+
+// Kinetos V5 up to rev 8 kept its switches in flag bits 27-31. Upstream now uses all of them
+// (temperature throttle, LCD network info, $SYS probe, 12h clock, SNTP without DHCP).
+#define OLD_LED_PV    (1u << 27)
+#define OLD_SMART1    (1u << 28)
+#define OLD_P14A      (1u << 29)
+#define OLD_P14A_HIGH (1u << 30)
+#define OLD_HA        (1u << 31)
+#define OLD_MASK      (OLD_LED_PV | OLD_SMART1 | OLD_P14A | OLD_P14A_HIGH | OLD_HA)
+#define OLD_DEFAULT   (OLD_SMART1 | OLD_LED_PV | OLD_HA)
+
+// The original Kinetos firmware 4.1.4 (based on OpenEVSE 4.1.5) used bits 21-23 for
+// uLM (0x200000), smart1 (0x400000) and the LED light show (0x800000). Upstream now uses them for
+// factory write lock and OCPP auto/offline authorisation.
+#define STOCK_ULM       (1u << 21)
+#define STOCK_SMART1    (1u << 22)
+#define STOCK_LIGHTSHOW (1u << 23)
+#define STOCK_MASK      (STOCK_ULM | STOCK_SMART1 | STOCK_LIGHTSHOW)
+
+bool kinetos_config_migrate(uint32_t &flags_changed, uint32_t default_flags)
+{
+  if(kinetos_config_ver >= KINETOS_CONFIG_VER) {
+    return false;
+  }
+
+  // Bits never set by the user still had the old default
+  uint32_t old = ((flags & flags_changed) | (OLD_DEFAULT & ~flags_changed)) & OLD_MASK;
+
+  // Settings straight from the original Kinetos firmware (no flags_changed, Kinetos-only keys)
+  if(0 == flags_changed && (kinetos_legacy_charge_count > 0 || kinetos_legacy_evse_id.length() > 0))
+  {
+    old = (old & ~OLD_SMART1) | ((flags & STOCK_SMART1) ? OLD_SMART1 : 0);
+    flags = (flags & ~STOCK_MASK) | (default_flags & STOCK_MASK);
+  }
+
+  kinetos_led_pv_enabled = old & OLD_LED_PV;
+  kinetos_ha_enabled = old & OLD_HA;
+  modbus_tcp_enabled = old & OLD_SMART1;
+  dimming_enabled = old & OLD_P14A;
+  dimming_input_active_high = old & OLD_P14A_HIGH;
+  dimming_input_pin = kinetos_legacy_p14a_pin < 40 ? kinetos_legacy_p14a_pin : GRID_DIMMING_PIN_NONE;
+  dimming_limit = kinetos_legacy_p14a_limit;
+
+  // Hand the bits back to upstream as "not changed, default value"
+  flags = (flags & ~OLD_MASK) | (default_flags & OLD_MASK);
+  flags_changed &= ~OLD_MASK;
+
+  kinetos_legacy_p14a_pin = 14;
+  kinetos_legacy_p14a_limit = 4200;
+  kinetos_config_ver = KINETOS_CONFIG_VER;
+  return true;
+}
+
+// The Kinetos controller (8.x.PR) has no current sensor of its own on MID boxes: the original
+// ESP firmware switched it to external values with "$F2 0" and then fed it the meter's phase
+// currents ("$T0 <mA L1> <mA L2> <mA L3>") and import energy ("$T1 <Wh>"). Without that the
+// controller's own current reading ($GG) and energy counter stay at zero.
+class KinetosControllerFeed : public MicroTasks::Task
+{
+  private:
+    uint8_t _tries = 0;
+    bool _enabled = false;
+    bool _busy = false;
+    uint32_t _lastWh = 0;
+
+  protected:
+    void setup() {}
+
+    unsigned long loop(MicroTasks::WakeReason reason)
+    {
+      if(_busy || !evse.isConnected()) {
+        return 1000;
+      }
+      if(0 != strncmp(evse.getFirmwareVersion(), "8.", 2)) {
+        return 10 * 1000; // only the Kinetos controller knows these commands
+      }
+
+      if(!_enabled)
+      {
+        if(_tries >= 6) {
+          return MicroTask.Infinate;
+        }
+        _tries++;
+        _busy = true;
+        rapiSender.sendCmd("$F2 0", [this](int ret) {
+          _busy = false;
+          _enabled = (RAPI_RESPONSE_OK == ret);
+          DBUGF("kinetos: $F2 0 -> %d", ret);
+        });
+        return 1000;
+      }
+
+      if(!sdmMeter.isValid()) {
+        return 2000;
+      }
+
+      char cmd[48];
+      snprintf(cmd, sizeof(cmd), "$T0 %lu %lu %lu",
+        (unsigned long)(sdmMeter.get(SdmMeter::CurrentL1) * 1000),
+        (unsigned long)(sdmMeter.get(SdmMeter::CurrentL2) * 1000),
+        (unsigned long)(sdmMeter.get(SdmMeter::CurrentL3) * 1000));
+      _busy = true;
+      rapiSender.sendCmd(cmd, [this](int ret) { _busy = false; });
+
+      uint32_t wh = (uint32_t)(sdmMeter.get(SdmMeter::ImportEnergy) * 1000);
+      if(wh != _lastWh)
+      {
+        _lastWh = wh;
+        snprintf(cmd, sizeof(cmd), "$T1 %lu", (unsigned long)wh);
+        rapiSender.sendCmd(cmd, [](int ret) {});
+      }
+      return 2000;
+    }
+
+  public:
+    bool isEnabled() { return _enabled; }
+};
+
+static KinetosControllerFeed controllerFeed;
+
+void kinetos_begin()
+{
+  MicroTask.startTask(controllerFeed);
+
+  // A panic record is only meaningful right after the panic reboot
+  if(ESP_RST_PANIC != esp_reset_reason()) {
+    kinetos_clear_crash();
+  }
+
+  // Free terminals IO14/IO15 and the button GPIO39, shown on the diagnostics page.
+  // Grid dimming sets its own pull-up/down later on the pin it uses.
+  pinMode(14, INPUT);
+  pinMode(15, INPUT);
+  pinMode(39, INPUT);
+}
+
+void kinetos_status(JsonDocument &doc)
+{
+  doc["dimming_active"] = gridDimming.isActive();
+  doc["dimming_limit_a"] = gridDimming.getLimitAmps();
+  doc["pv_share"] = kinetos_pv_share();
+  doc["powersum"] = doc["power"]; // name used by the Kinetos firmware
+  doc["controller_meter_feed"] = controllerFeed.isEnabled();
+  kinetos_budget_status(doc);
+  doc["gpio14"] = digitalRead(14);
+  doc["gpio15"] = digitalRead(15);
+  doc["gpio39"] = digitalRead(39);
+
+  const KinetosCrash *crash = kinetos_last_crash();
+  if(crash)
+  {
+    JsonObject p = doc.createNestedObject("last_panic");
+    char buf[16];
+    p["core"] = crash->core;
+    p["exception"] = crash->exception;
+    p["reason"] = crash->reason;
+    p["description"] = crash->description;
+    snprintf(buf, sizeof(buf), "0x%08x", crash->pc);
+    p["pc"] = String(buf);
+    p["exccause"] = crash->exccause;
+    snprintf(buf, sizeof(buf), "0x%08x", crash->excvaddr);
+    p["excvaddr"] = String(buf);
+    String bt;
+    for(uint32_t i = 0; i < crash->depth; i++) {
+      snprintf(buf, sizeof(buf), "0x%08x ", crash->backtrace[i]);
+      bt += buf;
+    }
+    p["backtrace"] = bt;
+  }
+}
+
+#endif // KINETOS_EXTRAS
diff --git a/src/kinetos/kinetos_extras.h b/src/kinetos/kinetos_extras.h
new file mode 100644
index 00000000..2fdb5ea5
--- /dev/null
+++ b/src/kinetos/kinetos_extras.h
@@ -0,0 +1,49 @@
+// Kinetos OpenEVSE V5 extras on top of the upstream firmware and the Kinetos board support
+// (SDM meter, grid dimming, Modbus TCP): PV share on the LED ring, Home Assistant discovery,
+// panic trap and the migration of settings written by Kinetos V5 up to rev 8 (v5.1.5 based).
+#ifndef KINETOS_EXTRAS_H
+#define KINETOS_EXTRAS_H
+
+#ifdef KINETOS_EXTRAS
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+
+extern bool kinetos_led_pv_enabled;
+extern uint8_t kinetos_led_fx_charge;
+extern bool kinetos_ha_enabled;
+extern String kinetos_lcd_splash;
+extern bool kinetos_lightshow_enabled;
+extern String kinetos_mqtt_ls_budget;
+extern uint8_t kinetos_config_ver;
+extern uint8_t kinetos_legacy_p14a_pin;
+extern uint32_t kinetos_legacy_p14a_limit;
+extern uint32_t kinetos_legacy_charge_count;
+extern String kinetos_legacy_evse_id;
+
+// Entries for the opts[] table in app_config.cpp
+#define KINETOS_CONFIG_OPTS \
+  new ConfigOptDefinition<bool>(kinetos_led_pv_enabled, true, "led_pv_enabled", "lpv"), \
+  new ConfigOptDefinition<uint8_t>(kinetos_led_fx_charge, 3, "led_fx_charge", "lfx"), \
+  new ConfigOptDefinition<bool>(kinetos_ha_enabled, true, "ha_discovery_enabled", "had"), \
+  new ConfigOptDefinition<String>(kinetos_lcd_splash, "Kinetos ETH/WiFi", "lcd_splash", "lsp"), \
+  new ConfigOptDefinition<bool>(kinetos_lightshow_enabled, false, "lightshow_enabled", "lsh"), \
+  new ConfigOptDefinition<String>(kinetos_mqtt_ls_budget, "", "mqtt_ls_budget", "mlb"), \
+  new ConfigOptDefinition<uint8_t>(kinetos_config_ver, 0, "kinetos_config_ver", "kcv"), \
+  new ConfigOptDefinition<uint8_t>(kinetos_legacy_p14a_pin, 14, "kinetos_legacy_p14a_pin", "p4p"), \
+  new ConfigOptDefinition<uint32_t>(kinetos_legacy_p14a_limit, 4200, "kinetos_legacy_p14a_limit", "p4l"), \
+  new ConfigOptDefinition<uint32_t>(kinetos_legacy_charge_count, 0, "kinetos_legacy_charge_count", "cc"), \
+  new ConfigOptDefinition<String>(kinetos_legacy_evse_id, "", "kinetos_legacy_evse_id", "ei"),
+
+// Call after the user config is loaded, before the default flags are applied.
+// Returns true if settings were changed and need a commit.
+bool kinetos_config_migrate(uint32_t &flags_changed, uint32_t default_flags);
+
+// Start-up: panic record, diagnostic inputs
+void kinetos_begin();
+
+// Extra /status fields
+void kinetos_status(JsonDocument &doc);
+
+#endif // KINETOS_EXTRAS
+#endif // KINETOS_EXTRAS_H
diff --git a/src/kinetos/kinetos_ha.cpp b/src/kinetos/kinetos_ha.cpp
new file mode 100644
index 00000000..86c20ada
--- /dev/null
+++ b/src/kinetos/kinetos_ha.cpp
@@ -0,0 +1,171 @@
+#ifdef KINETOS_EXTRAS
+
+#include <ArduinoJson.h>
+#include <espal.h>
+
+#include "kinetos_ha.h"
+#include "kinetos_extras.h"
+#include "app_config.h"
+#include "emonesp.h"
+
+namespace {
+
+struct HaEntity {
+  const char *component;   // sensor, binary_sensor, switch, number, button
+  const char *key;         // status key = state topic suffix
+  const char *name;
+  const char *deviceClass;
+  const char *unit;
+  const char *stateClass;
+  const char *valueTemplate;
+};
+
+// Status keys published by OpenEVSE (+ Kinetos additions). amp/voltage/power are A/V/W in v5,
+// temperatures are x10, session_energy is Wh, total_energy kWh.
+const HaEntity entities[] = {
+  { "sensor", "power",          "Ladeleistung",        "power",       "W",   "measurement",      NULL },
+  { "sensor", "amp",            "Strom L1",            "current",     "A",   "measurement",      NULL },
+  { "sensor", "amp2",           "Strom L2",            "current",     "A",   "measurement",      NULL },
+  { "sensor", "amp3",           "Strom L3",            "current",     "A",   "measurement",      NULL },
+  { "sensor", "voltage",        "Spannung L1",         "voltage",     "V",   "measurement",      NULL },
+  { "sensor", "voltage2",       "Spannung L2",         "voltage",     "V",   "measurement",      NULL },
+  { "sensor", "voltage3",       "Spannung L3",         "voltage",     "V",   "measurement",      NULL },
+  { "sensor", "phases",         "Aktive Phasen",       NULL,          NULL,  "measurement",      NULL },
+  { "sensor", "session_energy", "Energie Ladevorgang", "energy",      "Wh",  "total",            NULL },
+  { "sensor", "total_energy",   "Energie gesamt",      "energy",      "kWh", "total_increasing", NULL },
+  { "sensor", "meter_import_kwh", "MID-Zählerstand",     "energy",      "kWh", "total_increasing", NULL },
+  { "sensor", "pilot",          "Ladestrom-Vorgabe",   "current",     "A",   "measurement",      NULL },
+  { "sensor", "temp",           "Temperatur",          "temperature", "°C",  "measurement",      "{{ value | float / 10 }}" },
+  { "sensor", "elapsed",        "Ladedauer",           "duration",    "s",   "measurement",      NULL },
+  { "sensor", "battery_level",  "Fahrzeug-SoC",        "battery",     "%",   "measurement",      NULL },
+  { "sensor", "battery_range",  "Fahrzeug-Reichweite", "distance",    "km",  "measurement",      NULL },
+  { "sensor", "state",          "Zustand",             NULL,          NULL,  NULL,
+    "{% set s = value | int %}{{ {1:'Bereit',2:'Fahrzeug verbunden',3:'Lädt',4:'Lüftung nötig',"
+    "5:'Diodenfehler',6:'FI-Fehler',7:'Kein Schutzleiter',8:'Relais klebt',9:'FI-Selbsttest',"
+    "10:'Übertemperatur',11:'Überstrom',254:'Pausiert',255:'Deaktiviert'}.get(s, 'Unbekannt') }}" },
+  { "binary_sensor", "vehicle",   "Fahrzeug verbunden", "plug",        NULL,  NULL, "{{ 'ON' if value | int == 1 else 'OFF' }}" },
+  { "binary_sensor", "dimming_active","§14a Dimmung",      "running",     NULL,  NULL, "{{ 'ON' if value in ['true','1'] else 'OFF' }}" },
+};
+
+void addDevice(JsonDocument &doc, const String &id)
+{
+  JsonObject dev = doc.createNestedObject("dev");
+  dev.createNestedArray("ids").add("kinetos_" + id);
+  dev["name"] = esp_hostname;
+  dev["mf"] = "Kinetos / Bond Electronics";
+  dev["mdl"] = "Kinetos OpenEVSE V5";
+  dev["sw"] = currentfirmware;
+  dev["cu"] = "http://" + esp_hostname + ".local/";
+}
+
+String discoveryTopic(const char *component, const String &id, const char *key)
+{
+  return String("homeassistant/") + component + "/kinetos_" + id + "/" + key + "/config";
+}
+
+// Entity ids from Kinetos V5 rev <= 8, kept so Home Assistant keeps its entities and history
+const char *entityId(const char *key)
+{
+  if(0 == strcmp(key, "meter_import_kwh")) return "mid_import_kwh";
+  if(0 == strcmp(key, "dimming_active")) return "p14a_active";
+  return key;
+}
+
+} // namespace
+
+void kinetos_ha_discovery(KinetosHaPublish publish)
+{
+  if(!kinetos_ha_enabled) {
+    return;
+  }
+
+  String id = ESPAL.getLongId();
+  String base = mqtt_topic;
+  String payload;
+
+  for(const HaEntity &e : entities)
+  {
+    DynamicJsonDocument doc(1024);
+    doc["name"] = e.name;
+    doc["uniq_id"] = "kinetos_" + id + "_" + entityId(e.key);
+    doc["stat_t"] = base + "/" + e.key;
+    if(e.deviceClass) doc["dev_cla"] = e.deviceClass;
+    if(e.unit) doc["unit_of_meas"] = e.unit;
+    if(e.stateClass) doc["stat_cla"] = e.stateClass;
+    if(e.valueTemplate) doc["val_tpl"] = e.valueTemplate;
+    addDevice(doc, id);
+    payload = "";
+    serializeJson(doc, payload);
+    publish(discoveryTopic(e.component, id, entityId(e.key)), payload, true);
+  }
+
+  // Charging allowed: manual override active/disabled, state from the numeric EVSE state
+  {
+    DynamicJsonDocument doc(1024);
+    doc["name"] = "Laden erlaubt";
+    doc["uniq_id"] = "kinetos_" + id + "_charge_enable";
+    doc["stat_t"] = base + "/state";
+    doc["val_tpl"] = "{{ 'OFF' if value | int >= 254 else 'ON' }}";
+    doc["cmd_t"] = base + "/override/set";
+    doc["pl_on"] = "{\"state\":\"active\"}";
+    doc["pl_off"] = "{\"state\":\"disabled\"}";
+    doc["icon"] = "mdi:ev-station";
+    addDevice(doc, id);
+    payload = "";
+    serializeJson(doc, payload);
+    publish(discoveryTopic("switch", id, "charge_enable"), payload, true);
+  }
+
+  // Charge current via manual override
+  {
+    DynamicJsonDocument doc(1024);
+    doc["name"] = "Ladestrom";
+    doc["uniq_id"] = "kinetos_" + id + "_charge_current";
+    doc["stat_t"] = base + "/pilot";
+    doc["cmd_t"] = base + "/override/set";
+    doc["cmd_tpl"] = "{\"charge_current\": {{ value | int }} }";
+    doc["min"] = 6;
+    doc["max"] = 32;
+    doc["step"] = 1;
+    doc["unit_of_meas"] = "A";
+    doc["dev_cla"] = "current";
+    doc["mode"] = "slider";
+    addDevice(doc, id);
+    payload = "";
+    serializeJson(doc, payload);
+    publish(discoveryTopic("number", id, "charge_current"), payload, true);
+  }
+
+  // Hand control back (clear manual override)
+  {
+    DynamicJsonDocument doc(1024);
+    doc["name"] = "Übersteuerung aufheben";
+    doc["uniq_id"] = "kinetos_" + id + "_override_clear";
+    doc["cmd_t"] = base + "/override/set";
+    doc["pl_prs"] = "clear";
+    doc["icon"] = "mdi:restore";
+    addDevice(doc, id);
+    payload = "";
+    serializeJson(doc, payload);
+    publish(discoveryTopic("button", id, "override_clear"), payload, true);
+  }
+
+  // §14a remote dimming (for EMS / control box via MQTT)
+  {
+    DynamicJsonDocument doc(1024);
+    doc["name"] = "§14a Dimmung (Fernsteuerung)";
+    doc["uniq_id"] = "kinetos_" + id + "_p14a_remote";
+    doc["stat_t"] = base + "/dimming_active";
+    doc["val_tpl"] = "{{ 'ON' if value in ['true','1'] else 'OFF' }}";
+    doc["cmd_t"] = base + "/dimming/set";
+    doc["pl_on"] = "1";
+    doc["pl_off"] = "0";
+    doc["icon"] = "mdi:transmission-tower-export";
+    addDevice(doc, id);
+    payload = "";
+    serializeJson(doc, payload);
+    publish(discoveryTopic("switch", id, "p14a_remote"), payload, true);
+  }
+}
+
+#endif // KINETOS_EXTRAS
