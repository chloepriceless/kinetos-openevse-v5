diff --git a/src/web_server_dimming.cpp b/src/web_server_dimming.cpp
new file mode 100644
index 00000000..1544dcaa
--- /dev/null
+++ b/src/web_server_dimming.cpp
@@ -0,0 +1,55 @@
+#if defined(ENABLE_DEBUG) && !defined(ENABLE_DEBUG_WEB)
+#undef ENABLE_DEBUG
+#endif
+
+#include "debug.h"
+#include "web_server.h"
+#include "grid_dimming.h"
+#include "grid_dimming_calc.h"
+
+// -------------------------------------------------------------------
+// Grid operator dimming state
+//
+// url: GET /dimming   current state
+//      POST /dimming  body "1"/"0" (also on/off, true/false) sets the
+//                     remote dimming request
+// -------------------------------------------------------------------
+void handleDimming(MongooseHttpServerRequest *request)
+{
+  MongooseHttpServerResponseStream *response;
+  if(false == requestPreProcess(request, response)) {
+    return;
+  }
+
+  if(HTTP_POST == request->method())
+  {
+    bool active;
+    String body = request->body().toString();
+    if(!grid_dimming_parse_state(body.c_str(), active)) {
+      response->setCode(400);
+      response->print("{\"msg\":\"expected 1 or 0\"}");
+      request->send(response);
+      return;
+    }
+    if(!gridDimming.setRemote(active)) {
+      response->setCode(409);
+      response->print("{\"msg\":\"dimming is disabled\"}");
+      request->send(response);
+      return;
+    }
+    DBUGF("Dimming remote request: %d", active);
+  }
+  else if(HTTP_GET != request->method())
+  {
+    response->setCode(405);
+    response->print("{\"msg\":\"Method not allowed\"}");
+    request->send(response);
+    return;
+  }
+
+  StaticJsonDocument<192> doc;
+  gridDimming.serialize(doc);
+  response->setCode(200);
+  serializeJson(doc, *response);
+  request->send(response);
+}
diff --git a/test/test_grid_dimming/test_grid_dimming.cpp b/test/test_grid_dimming/test_grid_dimming.cpp
new file mode 100644
index 00000000..704b3144
--- /dev/null
+++ b/test/test_grid_dimming/test_grid_dimming.cpp
@@ -0,0 +1,51 @@
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include "doctest.h"
+#include "grid_dimming_calc.h"
+
+TEST_CASE("4200 W limit: single phase and three phase") {
+  // floor(4200 / 230) = 18, floor(4200 / 690) = 6
+  CHECK(grid_dimming_limit_amps(4200, 1, 6) == 18);
+  CHECK(grid_dimming_limit_amps(4200, 3, 6) == 6);
+}
+
+TEST_CASE("result rounds down so the limit is never exceeded") {
+  CHECK(grid_dimming_limit_amps(4139, 1, 6) == 17);   // 4139 / 230 = 17.99
+  CHECK(grid_dimming_limit_amps(4140, 1, 6) == 18);
+  CHECK(grid_dimming_limit_amps(11000, 3, 6) == 15);  // 11000 / 690 = 15.94
+}
+
+TEST_CASE("never below the EVSE minimum current") {
+  CHECK(grid_dimming_limit_amps(4000, 3, 6) == 6);    // 5.79 A -> min 6 A
+  CHECK(grid_dimming_limit_amps(0, 1, 6) == 6);
+  CHECK(grid_dimming_limit_amps(4200, 3, 8) == 8);
+}
+
+TEST_CASE("zero phases is treated as single phase") {
+  CHECK(grid_dimming_limit_amps(4200, 0, 6) == 18);
+}
+
+TEST_CASE("parse accepts 1/0, on/off, true/false") {
+  bool active = false;
+  CHECK(grid_dimming_parse_state("1", active));
+  CHECK(active);
+  CHECK(grid_dimming_parse_state("0", active));
+  CHECK_FALSE(active);
+  CHECK(grid_dimming_parse_state("ON", active));
+  CHECK(active);
+  CHECK(grid_dimming_parse_state("off", active));
+  CHECK_FALSE(active);
+  CHECK(grid_dimming_parse_state(" True\n", active));
+  CHECK(active);
+  CHECK(grid_dimming_parse_state("false", active));
+  CHECK_FALSE(active);
+}
+
+TEST_CASE("parse rejects anything else and leaves the state alone") {
+  bool active = true;
+  CHECK_FALSE(grid_dimming_parse_state("", active));
+  CHECK_FALSE(grid_dimming_parse_state("2", active));
+  CHECK_FALSE(grid_dimming_parse_state("onn", active));
+  CHECK_FALSE(grid_dimming_parse_state("{\"active\":false}", active));
+  CHECK_FALSE(grid_dimming_parse_state(nullptr, active));
+  CHECK(active);
+}
diff --git a/test/test_modbus_tcp/test_modbus_tcp.cpp b/test/test_modbus_tcp/test_modbus_tcp.cpp
new file mode 100644
index 00000000..da6f8b8c
--- /dev/null
+++ b/test/test_modbus_tcp/test_modbus_tcp.cpp
@@ -0,0 +1,213 @@
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include "doctest.h"
+#include <string.h>
+#include <vector>
+#include "modbus_tcp_protocol.h"
+
+// Serves the smart1 register map from a data snapshot and records writes
+class FakeMap : public ModbusRegisterHandler
+{
+  public:
+    ModbusSmart1Data data;
+    std::vector<uint16_t> written;
+    uint16_t written_start = 0;
+
+    FakeMap() { memset(&data, 0, sizeof(data)); }
+
+    bool readRegister(uint16_t addr, uint16_t &value) override {
+      return modbus_smart1_read(addr, data, value);
+    }
+    uint8_t writeRegisters(uint16_t start, uint16_t count, const uint16_t *values) override {
+      if(start < 1599 || start + count > 1603) {
+        return MODBUS_EX_ILLEGAL_ADDRESS;
+      }
+      written_start = start;
+      written.assign(values, values + count);
+      return 0;
+    }
+};
+
+static std::vector<uint8_t> frame(uint8_t unit, std::vector<uint8_t> pdu, uint16_t tid = 0x1234)
+{
+  std::vector<uint8_t> f = { (uint8_t)(tid >> 8), (uint8_t)tid, 0, 0,
+                             (uint8_t)((pdu.size() + 1) >> 8), (uint8_t)(pdu.size() + 1), unit };
+  f.insert(f.end(), pdu.begin(), pdu.end());
+  return f;
+}
+
+struct Result {
+  int used;
+  std::vector<uint8_t> resp;
+};
+
+static Result run(FakeMap &map, const std::vector<uint8_t> &req)
+{
+  uint8_t resp[MODBUS_TCP_MAX_FRAME];
+  size_t n = 0;
+  int used = modbus_tcp_process(req.data(), req.size(), 1, map, resp, n);
+  return { used, std::vector<uint8_t>(resp, resp + n) };
+}
+
+static uint16_t reg(const Result &r, int i) {
+  return (r.resp[9 + i * 2] << 8) | r.resp[10 + i * 2];
+}
+
+TEST_CASE("FC3 read returns MBAP echo and register values") {
+  FakeMap map;
+  map.data.max_hardware_current = 32;
+  map.data.charge_current = 16;
+  auto req = frame(1, { 0x03, 0x03, 0xE7, 0x00, 0x08 }); // 999, 8 registers
+  Result r = run(map, req);
+  CHECK(r.used == (int)req.size());
+  REQUIRE(r.resp.size() == 9 + 16);
+  CHECK(r.resp[0] == 0x12); CHECK(r.resp[1] == 0x34);  // transaction id
+  CHECK(r.resp[5] == 3 + 16);                          // length
+  CHECK(r.resp[6] == 1);
+  CHECK(r.resp[7] == 0x03);
+  CHECK(r.resp[8] == 16);
+  CHECK(reg(r, 5) == 32);   // 1004
+  CHECK(reg(r, 7) == 16);   // 1006
+}
+
+TEST_CASE("32 bit values are low word first") {
+  FakeMap map;
+  map.data.power = 0x00012345;
+  Result r = run(map, frame(1, { 0x04, 0x04, 0x4C, 0x00, 0x02 })); // FC4 1100, 2
+  CHECK(r.resp[7] == 0x04);
+  CHECK(reg(r, 0) == 0x2345);
+  CHECK(reg(r, 1) == 0x0001);
+}
+
+TEST_CASE("exceptions") {
+  FakeMap map;
+  // unknown register -> 2
+  Result r = run(map, frame(1, { 0x03, 0x01, 0xF4, 0x00, 0x01 }));
+  CHECK(r.resp[7] == 0x83); CHECK(r.resp[8] == 0x02); CHECK(r.resp[5] == 3);
+  // read past the end of a block -> 2
+  r = run(map, frame(1, { 0x03, 0x04, 0x56, 0x00, 0x03 })); // 1110..1112
+  CHECK(r.resp[8] == 0x02);
+  // count 0 and 126 -> 3
+  r = run(map, frame(1, { 0x03, 0x03, 0xE7, 0x00, 0x00 }));
+  CHECK(r.resp[8] == 0x03);
+  r = run(map, frame(1, { 0x03, 0x03, 0xE7, 0x00, 0x7E }));
+  CHECK(r.resp[8] == 0x03);
+  // unsupported function -> 1
+  r = run(map, frame(1, { 0x01, 0x00, 0x00, 0x00, 0x01 }));
+  CHECK(r.resp[7] == 0x81); CHECK(r.resp[8] == 0x01);
+  // wrong unit -> 0x0B, unit 0 and 255 accepted
+  r = run(map, frame(7, { 0x03, 0x03, 0xE7, 0x00, 0x01 }));
+  CHECK(r.resp[8] == 0x0B);
+  r = run(map, frame(0, { 0x03, 0x03, 0xE7, 0x00, 0x01 }));
+  CHECK(r.resp[7] == 0x03); CHECK(r.resp[6] == 0);
+  r = run(map, frame(255, { 0x03, 0x03, 0xE7, 0x00, 0x01 }));
+  CHECK(r.resp[7] == 0x03);
+}
+
+TEST_CASE("FC6 and FC16 writes echo the request") {
+  FakeMap map;
+  Result r = run(map, frame(1, { 0x06, 0x06, 0x3F, 0x0F, 0xA0 })); // 1599 = 4000
+  CHECK(r.resp.size() == 12);
+  CHECK(r.resp[7] == 0x06);
+  CHECK(r.resp[10] == 0x0F); CHECK(r.resp[11] == 0xA0);
+  CHECK(map.written_start == 1599);
+  CHECK(map.written == std::vector<uint16_t>{ 4000 });
+
+  r = run(map, frame(1, { 0x10, 0x06, 0x3F, 0x00, 0x04, 0x08, 0x0F, 0xA0, 0x00, 0x00, 0x00, 0x01, 0x00, 0x3C }));
+  CHECK(r.resp.size() == 12);
+  CHECK(r.resp[7] == 0x10);
+  CHECK(r.resp[11] == 4);
+  CHECK(map.written == std::vector<uint16_t>{ 4000, 0, 1, 60 });
+
+  // byte count mismatch -> 3, write outside the control blocks -> 2
+  r = run(map, frame(1, { 0x10, 0x06, 0x3F, 0x00, 0x02, 0x03, 0x00, 0x00, 0x00 }));
+  CHECK(r.resp[8] == 0x03);
+  r = run(map, frame(1, { 0x06, 0x03, 0xE8, 0x00, 0x01 }));
+  CHECK(r.resp[8] == 0x02);
+}
+
+TEST_CASE("partial frames wait, bad frames close, pipelined frames are consumed one by one") {
+  FakeMap map;
+  auto req = frame(1, { 0x03, 0x03, 0xE7, 0x00, 0x01 });
+  uint8_t resp[MODBUS_TCP_MAX_FRAME];
+  size_t n = 0;
+  CHECK(modbus_tcp_process(req.data(), 5, 1, map, resp, n) == 0);
+  CHECK(modbus_tcp_process(req.data(), req.size() - 1, 1, map, resp, n) == 0);
+
+  auto bad = req;
+  bad[2] = 1; // protocol id must be 0
+  CHECK(modbus_tcp_process(bad.data(), bad.size(), 1, map, resp, n) < 0);
+  bad = req;
+  bad[5] = 1; // length too short
+  CHECK(modbus_tcp_process(bad.data(), bad.size(), 1, map, resp, n) < 0);
+
+  auto two = req;
+  two.insert(two.end(), req.begin(), req.end());
+  CHECK(modbus_tcp_process(two.data(), two.size(), 1, map, resp, n) == (int)req.size());
+}
+
+TEST_CASE("smart1 status registers") {
+  ModbusSmart1Data d;
+  memset(&d, 0, sizeof(d));
+  uint16_t v;
+
+  d.evse_state = 1; // not connected
+  modbus_smart1_read(1000, d, v); CHECK(v == 2);
+  modbus_smart1_read(1002, d, v); CHECK(v == 1);
+  modbus_smart1_read(1003, d, v); CHECK(v == 1);
+
+  d.evse_state = 2; // connected, no session yet
+  modbus_smart1_read(1000, d, v); CHECK(v == 7);
+  d.session = true; // charge finished
+  modbus_smart1_read(1000, d, v); CHECK(v == 12);
+  modbus_smart1_read(1001, d, v); CHECK(v == 5);
+  modbus_smart1_read(1228, d, v); CHECK(v == 3);
+
+  d.evse_state = 3; // charging
+  modbus_smart1_read(1000, d, v); CHECK(v == 9);
+  modbus_smart1_read(1001, d, v); CHECK(v == 2);
+  modbus_smart1_read(1228, d, v); CHECK(v == 1);
+
+  d.evse_state = 254; // sleeping (paused)
+  modbus_smart1_read(1000, d, v); CHECK(v == 0);
+  modbus_smart1_read(1001, d, v); CHECK(v == 4);
+  modbus_smart1_read(1002, d, v); CHECK(v == 0);
+  modbus_smart1_read(1228, d, v); CHECK(v == 2);
+  d.waiting_for_auth = true;
+  modbus_smart1_read(1003, d, v); CHECK(v == 3);
+
+  d.evse_state = 6; // GFI fault
+  d.fault = true;
+  modbus_smart1_read(1000, d, v); CHECK(v == 14);
+  modbus_smart1_read(1001, d, v); CHECK(v == 7);
+  modbus_smart1_read(1111, d, v); CHECK(v == 6);
+
+  d.evse_state = 15; // other fault
+  modbus_smart1_read(1000, d, v); CHECK(v == 13);
+}
+
+TEST_CASE("smart1 block ranges") {
+  ModbusSmart1Data d;
+  memset(&d, 0, sizeof(d));
+  d.current_control.setpoint = 1600;
+  d.power_control.timeout = 30;
+  uint16_t v;
+  CHECK(modbus_smart1_read(1300, d, v));
+  CHECK(modbus_smart1_read(1327, d, v));
+  CHECK_FALSE(modbus_smart1_read(1328, d, v));
+  CHECK_FALSE(modbus_smart1_read(1112, d, v));
+  CHECK_FALSE(modbus_smart1_read(1229, d, v));
+  CHECK_FALSE(modbus_smart1_read(1603, d, v));
+  CHECK(modbus_smart1_read(1999, d, v)); CHECK(v == 1600);
+  CHECK(modbus_smart1_read(1602, d, v)); CHECK(v == 30);
+  CHECK_FALSE(modbus_smart1_read(2003, d, v));
+}
+
+TEST_CASE("setpoint conversion") {
+  CHECK(modbus_smart1_power_to_amps(4140, 230, 3) == 6);
+  CHECK(modbus_smart1_power_to_amps(3680, 230, 1) == 16);
+  CHECK(modbus_smart1_power_to_amps(3680, 0, 1) == 0);
+  CHECK(modbus_smart1_current_to_amps(599) == 0);
+  CHECK(modbus_smart1_current_to_amps(600) == 6);
+  CHECK(modbus_smart1_current_to_amps(1650) == 16);
+  CHECK(modbus_smart1_current_to_amps(8001) == 0);
+}
