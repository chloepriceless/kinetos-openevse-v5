+  {
+    _pin_cfg = dimming_input_pin;
+    _pin = valid ? dimming_input_pin : GRID_DIMMING_PIN_NONE;
+    _pin_active_high = dimming_input_active_high;
+    if(valid) {
+      // Default wiring is a potential-free contact between the pin and GND:
+      // active low with the internal pull-up.
+      pinMode(_pin, _pin_active_high ? INPUT_PULLDOWN : INPUT_PULLUP);
+    }
+    _input_raw = false;
+    _input_active = false;
+    _input_changed = millis();
+    DBUGF("GridDimming: input pin %u, active %s", _pin, _pin_active_high ? "high" : "low");
+  }
+
+  if(GRID_DIMMING_PIN_NONE == _pin) {
+    _input_active = false;
+    return;
+  }
+
+  bool raw = digitalRead(_pin) == (_pin_active_high ? HIGH : LOW);
+  if(raw != _input_raw) {
+    _input_raw = raw;
+    _input_changed = millis();
+  }
+  if(raw != _input_active &&
+     (long)(millis() - (_input_changed + GRID_DIMMING_DEBOUNCE_TIME)) >= 0)
+  {
+    _input_active = raw;
+  }
+}
+
+void GridDimming::apply()
+{
+  bool active = dimming_enabled && (_input_active || _remote_active);
+  Source source = !active ? None : (_input_active ? Input : Remote);
+  uint32_t limit_amps = 0;
+
+  if(active)
+  {
+    uint8_t phases = config_threephase_enabled() ? 3 : 1;
+    limit_amps = grid_dimming_limit_amps(dimming_limit, phases, (uint32_t)_evse->getMinCurrent());
+
+    // Our claim outranks the shaper/load sharing, so keep any lower cap they set
+    uint32_t claim_amps = limit_amps;
+    uint32_t other = _evse->getMaxCurrentExcluding(EvseClient_OpenEVSE_GridDimming);
+    if(other < claim_amps) {
+      claim_amps = other;
+    }
+
+    if(!_claimed || claim_amps != _claimed_amps)
+    {
+      EvseProperties props;
+      props.setMaxCurrent(claim_amps);
+      _evse->claim(EvseClient_OpenEVSE_GridDimming, EvseManager_Priority_GridDimming, props);
+      _claimed = true;
+      _claimed_amps = claim_amps;
+    }
+  }
+  else if(_claimed)
+  {
+    _evse->release(EvseClient_OpenEVSE_GridDimming);
+    _claimed = false;
+    _claimed_amps = 0;
+  }
+
+  if(active != _active || source != _source || limit_amps != _limit_amps)
+  {
+    DBUGF("GridDimming: %s, source %d, %u A", active ? "active" : "inactive", source, limit_amps);
+    _active = active;
+    _source = source;
+    _limit_amps = limit_amps;
+
+    StaticJsonDocument<128> event;
+    event["dimming_active"] = _active;
+    event["dimming_source"] = (uint8_t)_source;
+    event["dimming_limit_a"] = _limit_amps;
+    event_send(event);
+  }
+}
+
+unsigned long GridDimming::loop(MicroTasks::WakeReason reason)
+{
+  if(!_evse) {
+    return MicroTask.Infinate;
+  }
+
+  if(!dimming_enabled)
+  {
+    _input_active = false;
+    _remote_active = false;
+    apply();
+    // notifyConfigChanged() wakes us when it is turned on
+    return MicroTask.Infinate;
+  }
+
+  updateInput();
+  apply();
+
+  // Poll the input for debouncing; while active also track the phase setting
+  // and the other max_current claims we fold in.
+  if(GRID_DIMMING_PIN_NONE != _pin || _active) {
+    return GRID_DIMMING_LOOP_TIME;
+  }
+  return MicroTask.Infinate;
+}
+
+void GridDimming::serialize(JsonDocument &doc)
+{
+  doc["enabled"] = dimming_enabled;
+  doc["active"] = _active;
+  doc["source"] = (uint8_t)_source;
+  doc["input"] = _input_active;
+  doc["remote"] = _remote_active;
+  doc["limit"] = dimming_limit;
+  doc["limit_a"] = _limit_amps;
+}
diff --git a/src/grid_dimming.h b/src/grid_dimming.h
new file mode 100644
index 00000000..5228cfc2
--- /dev/null
+++ b/src/grid_dimming.h
@@ -0,0 +1,85 @@
+#ifndef _OPENEVSE_GRID_DIMMING_H
+#define _OPENEVSE_GRID_DIMMING_H
+
+// Grid operator dimming, e.g. German §14a EnWG: while the grid operator asks
+// for it, the charger is limited to `dimming_limit` watts (4200 W by default,
+// the minimum §14a guarantees). The request comes from a digital input (the
+// operator's control box relay) or remotely over MQTT/HTTP; either one turns
+// dimming on.
+
+#ifndef GRID_DIMMING_LIMIT_DEFAULT
+#define GRID_DIMMING_LIMIT_DEFAULT 4200
+#endif
+
+// dimming_input_pin value for "no input"
+#define GRID_DIMMING_PIN_NONE 255
+
+#ifndef GRID_DIMMING_MAX_PIN
+#define GRID_DIMMING_MAX_PIN 39
+#endif
+
+#ifndef GRID_DIMMING_DEBOUNCE_TIME
+#define GRID_DIMMING_DEBOUNCE_TIME 1000
+#endif
+
+#ifndef GRID_DIMMING_LOOP_TIME
+#define GRID_DIMMING_LOOP_TIME 250
+#endif
+
+#include "emonesp.h"
+#include <MicroTasks.h>
+#include "evse_man.h"
+#include "app_config.h"
+
+class GridDimming : public MicroTasks::Task
+{
+  public:
+    enum Source {
+      None = 0,
+      Input = 1,
+      Remote = 2
+    };
+
+  private:
+    EvseManager *_evse;
+    uint8_t      _pin_cfg;          // dimming_input_pin as last seen
+    uint8_t      _pin;              // pin in use, GRID_DIMMING_PIN_NONE if none/invalid
+    bool         _pin_active_high;  // polarity the pin was configured for
+    bool         _input_raw;        // last raw (not debounced) input level, true = asserted
+    unsigned long _input_changed;   // millis() of the last raw input change
+    bool         _input_active;     // debounced input state
+    bool         _remote_active;    // state last set over MQTT/HTTP
+    bool         _active;           // state last published
+    Source       _source;           // source last published
+    uint32_t     _limit_amps;       // dimming limit last published, 0 when inactive
+    bool         _claimed;          // we hold an EvseManager claim
+    uint32_t     _claimed_amps;     // max_current of that claim
+
+    void updateInput();
+    void apply();
+
+  protected:
+    void setup();
+    unsigned long loop(MicroTasks::WakeReason reason);
+
+  public:
+    GridDimming();
+    void begin(EvseManager &evse);
+
+    // Returns false (and ignores the request) when dimming is disabled
+    bool setRemote(bool active);
+    void notifyConfigChanged();
+
+    // Applied state, as published in the status/events
+    bool isActive() { return _active; }
+    Source getSource() { return _source; }
+    bool isInputActive() { return _input_active; }
+    bool isRemoteActive() { return _remote_active; }
+    uint32_t getLimitAmps() { return _limit_amps; }
+
+    void serialize(JsonDocument &doc);
+};
+
+extern GridDimming gridDimming;
+
+#endif // _OPENEVSE_GRID_DIMMING_H
diff --git a/src/grid_dimming_calc.cpp b/src/grid_dimming_calc.cpp
new file mode 100644
index 00000000..5ccf01ff
--- /dev/null
+++ b/src/grid_dimming_calc.cpp
@@ -0,0 +1,45 @@
+#include "grid_dimming_calc.h"
+
+#include <ctype.h>
+#include <string.h>
+#include <strings.h>
+
+uint32_t grid_dimming_limit_amps(uint32_t limit_w, uint8_t phases, uint32_t min_amps)
+{
+  if(0 == phases) {
+    phases = 1;
+  }
+  uint32_t amps = limit_w / ((uint32_t)GRID_DIMMING_NOMINAL_VOLTAGE * phases);
+  return amps < min_amps ? min_amps : amps;
+}
+
+bool grid_dimming_parse_state(const char *payload, bool &active)
+{
+  if(nullptr == payload) {
+    return false;
+  }
+
+  while(isspace((unsigned char)*payload)) {
+    payload++;
+  }
+  size_t len = strlen(payload);
+  while(len > 0 && isspace((unsigned char)payload[len - 1])) {
+    len--;
+  }
+
+  static const char *const on[] = { "1", "on", "true" };
+  static const char *const off[] = { "0", "off", "false" };
+  for(size_t i = 0; i < sizeof(on) / sizeof(on[0]); i++)
+  {
+    if(strlen(on[i]) == len && 0 == strncasecmp(payload, on[i], len)) {
+      active = true;
+      return true;
+    }
+    if(strlen(off[i]) == len && 0 == strncasecmp(payload, off[i], len)) {
+      active = false;
+      return true;
+    }
+  }
+
+  return false;
+}
diff --git a/src/grid_dimming_calc.h b/src/grid_dimming_calc.h
new file mode 100644
index 00000000..2933705c
--- /dev/null
+++ b/src/grid_dimming_calc.h
@@ -0,0 +1,24 @@
+#ifndef _OPENEVSE_GRID_DIMMING_CALC_H
+#define _OPENEVSE_GRID_DIMMING_CALC_H
+
+// Pure helpers for grid operator dimming (grid_dimming.h), kept free of
+// firmware dependencies so they are host-testable (test/test_grid_dimming).
+
+#include <stdint.h>
+
+#ifndef GRID_DIMMING_NOMINAL_VOLTAGE
+#define GRID_DIMMING_NOMINAL_VOLTAGE 230
+#endif
+
+// Current per phase that keeps the charger at or below `limit_w`:
+// floor(limit_w / (GRID_DIMMING_NOMINAL_VOLTAGE * phases)), never below
+// `min_amps` (the EVSE cannot signal less than its minimum current).
+// `phases` of 0 is treated as 1.
+uint32_t grid_dimming_limit_amps(uint32_t limit_w, uint8_t phases, uint32_t min_amps);
+
+// Parses a remote on/off request: "1"/"0", "on"/"off", "true"/"false"
+// (case-insensitive, surrounding whitespace ignored). Returns false and leaves
+// `active` untouched for anything else.
+bool grid_dimming_parse_state(const char *payload, bool &active);
+
+#endif // _OPENEVSE_GRID_DIMMING_CALC_H
