+import { describe, it, expect } from 'vitest'
+import {
+  meterState, rfidState, powerSource, formatPvShare, formatUptime,
+} from '../status.js'
+
+describe('meterState', () => {
+  it('is detected when the meter reads valid', () => {
+    expect(meterState({ meter_valid: true, meter_present: true })).toBe('detected')
+  })
+  it('is not fitted when the firmware says no meter is present', () => {
+    expect(meterState({ meter_valid: false, meter_present: false })).toBe('not_fitted')
+  })
+  it('is unknown while still probing or without the fields', () => {
+    expect(meterState({ meter_valid: false, meter_present: true })).toBe('unknown')
+    expect(meterState({})).toBe('unknown')
+    expect(meterState(null)).toBe('unknown')
+  })
+})
+
+describe('rfidState', () => {
+  it('is disabled when rfid_enabled is false', () => {
+    expect(rfidState({ rfid_enabled: false }, { rfid_failure: 1 })).toBe('disabled')
+  })
+  it('reports no answer on a communication failure', () => {
+    expect(rfidState({ rfid_enabled: true }, { rfid_failure: 1 })).toBe('no_answer')
+  })
+  it('is detected otherwise', () => {
+    expect(rfidState({ rfid_enabled: true }, { rfid_failure: 0 })).toBe('detected')
+    expect(rfidState({}, {})).toBe('detected')
+  })
+})
+
+describe('powerSource', () => {
+  it('uses the MID meter when it is valid, else the controller CT', () => {
+    expect(powerSource({ meter_valid: true })).toBe('mid')
+    expect(powerSource({ meter_valid: false })).toBe('ct')
+    expect(powerSource(undefined)).toBe('ct')
+  })
+})
+
+describe('formatPvShare', () => {
+  it('shows 0..1 as a whole percent', () => {
+    expect(formatPvShare(0)).toBe('0 %')
+    expect(formatPvShare(0.456)).toBe('46 %')
+    expect(formatPvShare(1)).toBe('100 %')
+  })
+  it('shows a dash for negative (no data) or missing values', () => {
+    expect(formatPvShare(-1)).toBe('–')
+    expect(formatPvShare(undefined)).toBe('–')
+    expect(formatPvShare(null)).toBe('–')
+  })
+  it('caps above 1', () => {
+    expect(formatPvShare(1.2)).toBe('100 %')
+  })
+})
+
+describe('formatUptime', () => {
+  it('formats seconds, minutes, hours and days', () => {
+    expect(formatUptime(5)).toBe('5s')
+    expect(formatUptime(65)).toBe('1m 5s')
+    expect(formatUptime(3 * 3600 + 120)).toBe('3h 2m')
+    expect(formatUptime(2 * 86400 + 3 * 3600 + 4 * 60)).toBe('2d 3h 4m')
+  })
+  it('returns null for a missing value', () => {
+    expect(formatUptime(undefined)).toBeNull()
+  })
+})
