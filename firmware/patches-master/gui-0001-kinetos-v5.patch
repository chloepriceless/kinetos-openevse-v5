@@ -0,0 +1,35 @@
+// src/lib/kinetos/dimming.js
+// Grid operator dimming (§14a EnWG) helpers.
+
+export const DIMMING_PIN_NONE = 255
+export const DIMMING_PINS = [14, 15, DIMMING_PIN_NONE]
+export const DIMMING_LIMIT = { min: 1400, max: 22000, step: 100, default: 4200 }
+
+/** True when a limit (W) is inside the range the firmware accepts. */
+export function isValidDimmingLimit(v) {
+  return Number.isInteger(v) && v >= DIMMING_LIMIT.min && v <= DIMMING_LIMIT.max
+}
+
+/** Body for POST /dimming: the firmware accepts "1"/"0". */
+export function dimmingBody(on) {
+  return on ? '1' : '0'
+}
+
+/**
+ * Did POST /dimming succeed? The firmware answers 200 with its dimming state
+ * object ({enabled, active, ...}); failures come back as {msg} (400/409) or
+ * httpAPI's 'error' string.
+ */
+export function dimmingResponseOk(res) {
+  return !!res && typeof res === 'object' && 'active' in res
+}
+
+/** The error text to show: the firmware's msg when there is one. */
+export function dimmingResponseError(res) {
+  return res && typeof res === 'object' && typeof res.msg === 'string' ? res.msg : null
+}
+
+/** MQTT topic the firmware subscribes to for remote dimming. */
+export function dimmingTopic(mqttTopic) {
+  return `${mqttTopic || 'openevse'}/dimming/set`
+}
