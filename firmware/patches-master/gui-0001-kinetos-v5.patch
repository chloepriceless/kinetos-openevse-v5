+import { describe, it, expect } from 'vitest'
+import { LED_FX_MODES, fxOptions } from '../fx.js'
+
+const t = (k) => k
+
+describe('fxOptions', () => {
+  it('labels every mode "Name (n)" with a string value', () => {
+    const opts = fxOptions(t, 3)
+    expect(opts).toHaveLength(LED_FX_MODES.length)
+    expect(opts[0]).toEqual({ value: '0', label: 'kinetos.fx.0 (0)' })
+    expect(opts.find((o) => o.value === '56').label).toBe('kinetos.fx.56 (56)')
+  })
+
+  it('lists the 18 supported WS2812FX modes in order', () => {
