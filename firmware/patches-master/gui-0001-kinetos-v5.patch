@@ -0,0 +1,47 @@
+import { describe, it, expect } from 'vitest'
+import {
+  DIMMING_LIMIT, isValidDimmingLimit, dimmingBody,
+  dimmingResponseOk, dimmingResponseError, dimmingTopic,
+} from '../dimming.js'
+
+describe('isValidDimmingLimit', () => {
+  it('accepts the firmware range 1400..22000 W', () => {
+    expect(isValidDimmingLimit(DIMMING_LIMIT.min)).toBe(true)
+    expect(isValidDimmingLimit(4200)).toBe(true)
+    expect(isValidDimmingLimit(DIMMING_LIMIT.max)).toBe(true)
+  })
+  it('rejects out-of-range, empty and fractional values', () => {
+    expect(isValidDimmingLimit(1399)).toBe(false)
+    expect(isValidDimmingLimit(22001)).toBe(false)
+    expect(isValidDimmingLimit(null)).toBe(false)
+    expect(isValidDimmingLimit(4200.5)).toBe(false)
+  })
+})
+
+describe('dimming endpoint helpers', () => {
+  it('sends "1"/"0" as the POST body', () => {
+    expect(dimmingBody(true)).toBe('1')
+    expect(dimmingBody(false)).toBe('0')
+  })
+  it('treats the state object as success', () => {
+    expect(dimmingResponseOk({ enabled: true, active: true, limit_a: 6 })).toBe(true)
+  })
+  it('treats {msg}, "error" and empty answers as failure', () => {
+    expect(dimmingResponseOk({ msg: 'dimming is disabled' })).toBe(false)
+    expect(dimmingResponseOk('error')).toBe(false)
+    expect(dimmingResponseOk(null)).toBe(false)
+  })
+  it('surfaces the firmware message when there is one', () => {
+    expect(dimmingResponseError({ msg: 'dimming is disabled' })).toBe('dimming is disabled')
+    expect(dimmingResponseError('error')).toBeNull()
+  })
+})
+
+describe('dimmingTopic', () => {
+  it('appends /dimming/set to the base topic', () => {
+    expect(dimmingTopic('openevse-9cc0')).toBe('openevse-9cc0/dimming/set')
+  })
+  it('falls back to the default base topic', () => {
+    expect(dimmingTopic('')).toBe('openevse/dimming/set')
+  })
+})
