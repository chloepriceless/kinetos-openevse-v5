@@ -0,0 +1,21 @@
+// src/lib/kinetos/fx.js
+// WS2812FX animation modes offered for the LED ring while charging
+// (config `led_fx_charge`). The numbers are the library's mode ids; the
+// names live in en.json under kinetos.fx.<id>.
+
+export const LED_FX_MODES = [0, 2, 3, 5, 11, 12, 15, 16, 18, 21, 31, 40, 43, 44, 45, 49, 55, 56]
+
+/**
+ * Select options for the charge animation, labelled "Name (n)".
+ * An unknown current value (set from elsewhere) is kept as an extra option
+ * so the select never silently shows a different mode than the device uses.
+ * @param {(key: string) => string} t   translate function
+ * @param {number|null|undefined} current  current config value
+ */
+export function fxOptions(t, current) {
+  const opts = LED_FX_MODES.map((n) => ({ value: String(n), label: `${t('kinetos.fx.' + n)} (${n})` }))
+  if (Number.isInteger(current) && !LED_FX_MODES.includes(current)) {
+    opts.push({ value: String(current), label: `${t('kinetos.fx.other')} (${current})` })
+  }
+  return opts
+}
diff --git a/src/lib/kinetos/metrics.js b/src/lib/kinetos/metrics.js
new file mode 100644
index 0000000..3447978
--- /dev/null
+++ b/src/lib/kinetos/metrics.js
@@ -0,0 +1,66 @@
+// src/lib/kinetos/metrics.js
+// Monitoring "Data" tab groups for Kinetos firmware: detected hardware and
+// the MID (SDM) meter. Same {titleKey, rows} shape as lib/monitoring/metrics.js
+// so MetricGroup renders them unchanged. Both are gated on `meter_present`,
+// which only Kinetos firmware reports.
+import { round } from '../monitoring/metrics.js'
+import { meterState, rfidState, powerSource } from './status.js'
+
+const METER_TEXT = {
+  detected: 'kinetos.hw.detected',
+  unknown: 'kinetos.hw.probing',
+  not_fitted: 'kinetos.hw.not_fitted',
+}
+const RFID_TEXT = {
+  detected: 'kinetos.hw.detected',
+  no_answer: 'kinetos.hw.no_answer',
+  disabled: 'kinetos.hw.disabled',
+}
+
+/** Kinetos firmware reports meter_present (true or false). */
+export function showHardware(status) {
+  return typeof status?.meter_present === 'boolean'
+}
+
+/** A MID meter is fitted (it answered at least once since boot). */
+export function showMeter(status) {
+  return status?.meter_present === true
+}
+
+export function hardwareMetrics(status, config) {
+  const s = status ?? {}
+  const c = config ?? {}
+  const rows = []
+  if (showMeter(s)) {
+    rows.push({ labelKey: 'kinetos.hw.meter', textKey: METER_TEXT[meterState(s)] })
+  }
+  rows.push({ labelKey: 'kinetos.hw.rfid', textKey: RFID_TEXT[rfidState(c, s)] })
+  rows.push({ labelKey: 'kinetos.hw.max_current', value: c.max_current_hard ?? null, unit: 'units.amp' })
+  if (showMeter(s)) {
+    rows.push({
+      labelKey: 'kinetos.hw.power_source',
+      textKey: powerSource(s) === 'mid' ? 'kinetos.hw.source_mid' : 'kinetos.hw.source_ct',
+    })
+  }
+  return { titleKey: 'kinetos.hw.title', rows }
+}
+
+/**
+ * Live MID meter readings. Units follow the firmware scale factors as the
+ * dashboard reads them: amp* in mA, voltage* in V, power in W, kWh as-is.
+ * Phases 2/3 appear only when the status carries them (meter valid).
+ */
+export function meterMetrics(status) {
+  const s = status ?? {}
+  const rows = [
+    { labelKey: 'kinetos.meter.power', value: round(s.power, 0), unit: 'units.watt' },
+    { labelKey: 'kinetos.meter.phases', value: s.phases ?? null, unit: '' },
+  ]
+  for (const [n, ampKey, voltKey] of [[1, 'amp', 'voltage'], [2, 'amp2', 'voltage2'], [3, 'amp3', 'voltage3']]) {
+    if (n > 1 && s[ampKey] === undefined && s[voltKey] === undefined) continue
+    rows.push({ labelKey: `kinetos.meter.current_l${n}`, value: round(s[ampKey] / 1000, 1), unit: 'units.amp' })
+    rows.push({ labelKey: `kinetos.meter.voltage_l${n}`, value: round(s[voltKey], 0), unit: 'units.volt' })
+  }
+  rows.push({ labelKey: 'kinetos.meter.import', value: round(s.meter_import_kwh, 2), unit: 'units.kwh' })
+  return { titleKey: 'kinetos.meter.title', rows }
+}
diff --git a/src/lib/kinetos/status.js b/src/lib/kinetos/status.js
new file mode 100644
index 0000000..97ee90c
--- /dev/null
+++ b/src/lib/kinetos/status.js
@@ -0,0 +1,41 @@
+// src/lib/kinetos/status.js
+// Pure helpers turning Kinetos /status + /config fields into display state.
+
+const isNum = (v) => typeof v === 'number' && Number.isFinite(v)
+
+/** 'detected' | 'not_fitted' | 'unknown' for the MID (SDM) meter. */
+export function meterState(status) {
+  if (status?.meter_valid) return 'detected'
+  if (status?.meter_present === false) return 'not_fitted'
+  return 'unknown'
+}
+
+/** 'disabled' | 'no_answer' | 'detected' for the RFID reader. */
+export function rfidState(config, status) {
+  if (config?.rfid_enabled === false) return 'disabled'
+  return status?.rfid_failure ? 'no_answer' : 'detected'
+}
+
+/** 'mid' when the MID meter supplies power readings, else 'ct'. */
+export function powerSource(status) {
+  return status?.meter_valid ? 'mid' : 'ct'
+}
+
+/** PV share 0..1 as a whole percent string; negative/missing → '–'. */
+export function formatPvShare(share) {
+  if (!isNum(share) || share < 0) return '–'
+  return `${Math.round(Math.min(share, 1) * 100)} %`
+}
+
+/** Seconds → "2d 3h 4m" / "3h 4m" / "4m 5s" / "5s". */
+export function formatUptime(seconds) {
+  if (!isNum(seconds)) return null
+  const s = Math.max(0, Math.floor(seconds))
+  const d = Math.floor(s / 86400)
+  const h = Math.floor((s % 86400) / 3600)
+  const m = Math.floor((s % 3600) / 60)
+  if (d > 0) return `${d}d ${h}h ${m}m`
+  if (h > 0) return `${h}h ${m}m`
+  if (m > 0) return `${m}m ${s % 60}s`
+  return `${s}s`
+}
