+// src/routes/settings/__tests__/Dimming.test.js
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, fireEvent } from '@testing-library/svelte'
+
+vi.mock('svelte-i18n', () => {
+  const t = (k, opts) => (opts?.values ? `${k} ${JSON.stringify(opts.values)}` : k)
+  t.subscribe = (fn) => { fn(t); return () => {} }
+  return { _: t }
+})
+vi.mock('../../../lib/api/httpAPI.js', () => ({ httpAPI: vi.fn(() => Promise.resolve({ msg: 'done' })) }))
+
+import { httpAPI } from '../../../lib/api/httpAPI.js'
+import { config_store } from '../../../lib/stores/config.js'
+import { status_store } from '../../../lib/stores/status.js'
+import { uistates_store } from '../../../lib/stores/uistates.js'
+
+import Dimming from '../Dimming.svelte'
+
+const CONFIG = {
+  mqtt_topic: 'openevse-9cc0',
+  dimming_enabled: true,
+  dimming_input_pin: 14,
+  dimming_input_active_high: false,
+  dimming_limit: 4200,
+}
+
+const configPosts = () =>
+  httpAPI.mock.calls.filter(([m, url]) => m === 'POST' && url === '/config').map(([, , body]) => JSON.parse(body))
+
+beforeEach(() => {
+  uistates_store.resetAlertBox()
+  httpAPI.mockReset()
+  httpAPI.mockResolvedValue({ msg: 'done' })
+  config_store.set({ ...CONFIG })
+  status_store.set({ dimming_active: false, dimming_limit_a: 0 })
+})
+
+describe('Grid dimming page', () => {
+  it('shows the live state and the limit in amps while active', () => {
+    status_store.set({ dimming_active: true, dimming_limit_a: 6 })
+    const { getByText } = render(Dimming)
+    expect(getByText('kinetos.dimming.state_on')).toBeInTheDocument()
+    expect(getByText('6 units.amp')).toBeInTheDocument()
+  })
+
+  it('shows the MQTT topic in the hint', () => {
+    const { getByText } = render(Dimming)
+    expect(getByText('kinetos.dimming.mqtt_hint {"topic":"openevse-9cc0/dimming/set"}')).toBeInTheDocument()
+  })
+
+  it('saves the switch and selects as single-key writes', async () => {
+    const { getByLabelText, getAllByRole } = render(Dimming)
+    await fireEvent.click(getByLabelText('kinetos.dimming.enable'))
+    const [pin, polarity] = getAllByRole('combobox')
+    await fireEvent.change(pin, { target: { value: '255' } })
+    await fireEvent.change(polarity, { target: { value: 'true' } })
+    await vi.waitFor(() =>
+      expect(configPosts()).toEqual([
+        { dimming_enabled: false },
+        { dimming_input_pin: 255 },
+        { dimming_input_active_high: true },
+      ]),
+    )
+  })
+
+  it('saves a valid limit and rejects an out-of-range one', async () => {
+    const { getByDisplayValue, getByText } = render(Dimming)
+    const input = getByDisplayValue('4200')
+    await fireEvent.input(input, { target: { value: '900' } })
+    await fireEvent.blur(input)
+    expect(getByText('kinetos.dimming.limit_invalid')).toBeInTheDocument()
+    expect(configPosts()).toEqual([])
+    await fireEvent.input(input, { target: { value: '5000' } })
+    await fireEvent.blur(input)
+    await vi.waitFor(() => expect(configPosts()).toEqual([{ dimming_limit: 5000 }]))
+  })
+
+  it('sends the test buttons to POST /dimming', async () => {
+    httpAPI.mockResolvedValue({ enabled: true, active: true, limit_a: 6 })
+    const { getByText, queryByRole } = render(Dimming)
+    await fireEvent.click(getByText('kinetos.dimming.test_on'))
+    await vi.waitFor(() => expect(httpAPI).toHaveBeenCalledWith('POST', '/dimming', '1'))
+    await fireEvent.click(getByText('kinetos.dimming.test_off'))
+    await vi.waitFor(() => expect(httpAPI).toHaveBeenCalledWith('POST', '/dimming', '0'))
+    expect(queryByRole('alert')).not.toBeInTheDocument()
+  })
+
+  it('shows an error line when the test fails', async () => {
+    httpAPI.mockResolvedValue({ msg: 'dimming is disabled' })
+    const { getByText, findByRole } = render(Dimming)
+    await fireEvent.click(getByText('kinetos.dimming.test_on'))
+    expect(await findByRole('alert')).toHaveTextContent('kinetos.dimming.test_failed: dimming is disabled')
+  })
+
+  it('shows a generic error when the request itself fails', async () => {
+    httpAPI.mockResolvedValue('error')
+    const { getByText, findByRole } = render(Dimming)
+    await fireEvent.click(getByText('kinetos.dimming.test_off'))
+    expect(await findByRole('alert')).toHaveTextContent(/^kinetos\.dimming\.test_failed$/)
+  })
+})
