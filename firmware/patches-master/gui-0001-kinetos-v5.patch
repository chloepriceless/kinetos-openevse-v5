+  it('keeps an unknown current mode visible as an extra option', () => {
+    const opts = fxOptions(t, 7)
+    expect(opts.at(-1)).toEqual({ value: '7', label: 'kinetos.fx.other (7)' })
+  })
+
+  it('adds nothing for a missing value', () => {
+    expect(fxOptions(t, undefined)).toHaveLength(LED_FX_MODES.length)
+  })
+})
