+  ])
+  let polarityOptions = $derived([
+    { value: 'false', label: $_('kinetos.dimming.active_low') },
+    { value: 'true', label: $_('kinetos.dimming.active_high') },
+  ])
+
+  // Out-of-range limits never reach the device; bumping the local counter
+  // resyncs the input to the stored value.
+  let localRevert = $state(0)
+  let limitError = $state(false)
+  function saveLimit(v) {
+    if (!isValidDimmingLimit(v)) {
+      limitError = true
+      localRevert += 1
+      return
+    }
+    limitError = false
+    form.saveField('dimming_limit', v)
+  }
+
+  // Test buttons: POST /dimming "1"/"0" sets the remote request, exactly as
+  // the MQTT topic does (firmware src/web_server_dimming.cpp).
+  let testBusy = $state(false)
+  let testError = $state(null)
+  async function testDimming(on) {
+    if (testBusy) return
+    testBusy = true
+    testError = null
+    try {
+      const res = await serialQueue.add(() => httpAPI('POST', '/dimming', dimmingBody(on)))
+      if (!dimmingResponseOk(res)) {
+        const detail = dimmingResponseError(res)
+        testError = detail ? `${$_('kinetos.dimming.test_failed')}: ${detail}` : $_('kinetos.dimming.test_failed')
+      }
+    } finally {
+      testBusy = false
+    }
+  }
+</script>
+
+<ConfigPage title={$_('config.pages.dimming')}>
+  <ConfigSection>
+    <ReadOnlyRow
+      label={$_('kinetos.dimming.state')}
+      value={active ? $_('kinetos.dimming.state_on') : $_('kinetos.dimming.state_off')}
+      detail={active && typeof limitA === 'number' ? `${limitA} ${$_('units.amp')}` : ''}
+      tone={active ? 'warn' : 'default'}
+    />
+    <FormField
+      label={$_('kinetos.dimming.enable')}
+      description={$_('kinetos.dimming.mqtt_hint', { values: { topic: dimmingTopic($config_store?.mqtt_topic) } })}
+      status={$ss.dimming_enabled ?? 'idle'}
+    >
+      <Toggle
+        checked={enabled}
+        label={$_('kinetos.dimming.enable')}
+        onchange={(v) => form.saveField('dimming_enabled', v)}
+      />
+    </FormField>
+  </ConfigSection>
+
+  <ConfigSection title={$_('kinetos.dimming.input_section')}>
+    <FormField label={$_('kinetos.dimming.pin')} status={$ss.dimming_input_pin ?? 'idle'}>
+      <Select
+        options={pinOptions}
+        value={String($config_store?.dimming_input_pin ?? DIMMING_PIN_NONE)}
+        onchange={(v) => form.saveField('dimming_input_pin', Number(v))}
+      />
+    </FormField>
+    <FormField label={$_('kinetos.dimming.polarity')} status={$ss.dimming_input_active_high ?? 'idle'}>
+      <Select
+        options={polarityOptions}
+        value={String(!!$config_store?.dimming_input_active_high)}
+        onchange={(v) => form.saveField('dimming_input_active_high', v === 'true')}
+      />
+    </FormField>
+    <FormField
+      label={$_('kinetos.dimming.limit')}
+      description={limitError ? $_('kinetos.dimming.limit_invalid') : $_('kinetos.dimming.limit_desc')}
+      status={$ss.dimming_limit ?? 'idle'}
+    >
+      <NumberInput
+        value={$config_store?.dimming_limit ?? DIMMING_LIMIT.default}
+        min={DIMMING_LIMIT.min}
+        max={DIMMING_LIMIT.max}
+        step={DIMMING_LIMIT.step}
+        revert={form.revert + localRevert}
+        onchange={saveLimit}
+      />
+    </FormField>
+  </ConfigSection>
+
+  <ConfigSection title={$_('kinetos.dimming.test')}>
+    <p class="mb-3 text-xs text-text-dim">{$_('kinetos.dimming.test_desc')}</p>
+    <div class="grid grid-cols-2 gap-3">
+      <Button
+        label={$_('kinetos.dimming.test_on')}
+        variant="ghost"
+        disabled={testBusy}
+        onclick={() => testDimming(true)}
+      />
+      <Button
+        label={$_('kinetos.dimming.test_off')}
+        variant="ghost"
+        disabled={testBusy}
+        onclick={() => testDimming(false)}
+      />
+    </div>
+    {#if testError}
+      <p class="mt-2 text-xs text-error" role="alert">{testError}</p>
+    {/if}
+  </ConfigSection>
+</ConfigPage>
