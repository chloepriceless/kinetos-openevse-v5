+import { describe, it, expect } from 'vitest'
+import { showHardware, showMeter, hardwareMetrics, meterMetrics } from '../metrics.js'
+
+const byLabel = (group) => Object.fromEntries(group.rows.map((r) => [r.labelKey, r]))
+
+describe('gates', () => {
+  it('shows hardware only on firmware that reports meter_present', () => {
+    expect(showHardware({})).toBe(false)
+    expect(showHardware({ meter_present: false })).toBe(true)
+    expect(showHardware({ meter_present: true })).toBe(true)
+  })
+  it('shows the meter only when one is present', () => {
+    expect(showMeter({ meter_present: false })).toBe(false)
+    expect(showMeter({})).toBe(false)
+    expect(showMeter({ meter_present: true })).toBe(true)
+  })
+})
+
+describe('hardwareMetrics', () => {
+  it('lists meter, RFID, max current and power source with a meter fitted', () => {
+    const g = hardwareMetrics(
+      { meter_present: true, meter_valid: true, rfid_failure: 0 },
+      { rfid_enabled: true, max_current_hard: 16 },
+    )
+    expect(g.titleKey).toBe('kinetos.hw.title')
+    const r = byLabel(g)
+    expect(r['kinetos.hw.meter'].textKey).toBe('kinetos.hw.detected')
+    expect(r['kinetos.hw.rfid'].textKey).toBe('kinetos.hw.detected')
+    expect(r['kinetos.hw.max_current']).toMatchObject({ value: 16, unit: 'units.amp' })
+    expect(r['kinetos.hw.power_source'].textKey).toBe('kinetos.hw.source_mid')
+  })
+  it('shows the meter as probing until it reads valid', () => {
+    const r = byLabel(hardwareMetrics({ meter_present: true, meter_valid: false }, {}))
+    expect(r['kinetos.hw.meter'].textKey).toBe('kinetos.hw.probing')
+    expect(r['kinetos.hw.power_source'].textKey).toBe('kinetos.hw.source_ct')
+  })
+  it('drops the meter rows without a meter', () => {
+    const r = byLabel(hardwareMetrics({ meter_present: false, rfid_failure: 2 }, { rfid_enabled: true }))
+    expect(r['kinetos.hw.meter']).toBeUndefined()
+    expect(r['kinetos.hw.power_source']).toBeUndefined()
+    expect(r['kinetos.hw.rfid'].textKey).toBe('kinetos.hw.no_answer')
+  })
+  it('reports a disabled RFID reader', () => {
+    const r = byLabel(hardwareMetrics({ meter_present: false }, { rfid_enabled: false }))
+    expect(r['kinetos.hw.rfid'].textKey).toBe('kinetos.hw.disabled')
+  })
+})
+
+describe('meterMetrics', () => {
+  it('scales like the dashboard: mA → A, V and W as-is, kWh to 2 decimals', () => {
+    const r = byLabel(meterMetrics({
+      power: 11040, phases: 3,
+      amp: 16000, amp2: 15870, amp3: 16100,
+      voltage: 231, voltage2: 229.4, voltage3: 230,
+      meter_import_kwh: 1234.567,
+    }))
+    expect(r['kinetos.meter.power']).toMatchObject({ value: 11040, unit: 'units.watt' })
+    expect(r['kinetos.meter.phases'].value).toBe(3)
+    expect(r['kinetos.meter.current_l1']).toMatchObject({ value: 16, unit: 'units.amp' })
+    expect(r['kinetos.meter.current_l2'].value).toBe(15.9)
+    expect(r['kinetos.meter.voltage_l2']).toMatchObject({ value: 229, unit: 'units.volt' })
+    expect(r['kinetos.meter.voltage_l3'].value).toBe(230)
+    expect(r['kinetos.meter.import']).toMatchObject({ value: 1234.57, unit: 'units.kwh' })
+  })
+  it('lists only phase 1 while the meter has no per-phase readings', () => {
+    const g = meterMetrics({ amp: 6000, voltage: 230 })
+    const keys = g.rows.map((r) => r.labelKey)
+    expect(keys).toContain('kinetos.meter.current_l1')
+    expect(keys).not.toContain('kinetos.meter.current_l2')
+    expect(byLabel(g)['kinetos.meter.import'].value).toBeNull()
+  })
+})
