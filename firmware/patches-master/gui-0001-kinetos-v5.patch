@@ -0,0 +1,25 @@
+// src/lib/kinetos/teslamate.js
+// Builds the config writes that point the vehicle MQTT topics at TeslaMate.
+
+export const VEHICLE_SRC_MQTT = 2
+export const TESLAMATE_CAR_ID = { min: 1, max: 20, default: 1 }
+
+export function isValidCarId(id) {
+  return Number.isInteger(id) && id >= TESLAMATE_CAR_ID.min && id <= TESLAMATE_CAR_ID.max
+}
+
+/**
+ * Ordered [key, value] config writes for TeslaMate car `id`, or null when
+ * the id is out of range. Ordered so vehicle_data_src flips to MQTT first.
+ */
+export function teslamateWrites(id) {
+  if (!isValidCarId(id)) return null
+  const base = `teslamate/cars/${id}`
+  return [
+    ['vehicle_data_src', VEHICLE_SRC_MQTT],
+    ['mqtt_vehicle_soc', `${base}/battery_level`],
+    ['mqtt_vehicle_range', `${base}/est_battery_range_km`],
+    ['mqtt_vehicle_eta', `${base}/time_to_full_charge`],
+    ['mqtt_vehicle_range_miles', false],
+  ]
+}
