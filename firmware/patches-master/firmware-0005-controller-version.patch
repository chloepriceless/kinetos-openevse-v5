+// Major version of the EVSE controller firmware. Kinetos controllers report it in different
+// forms: "8.2.0.PR" on one box, "E532_L-8.2.0" on another (issue #2), so take the first number
+// that is directly followed by a dot instead of expecting the string to start with it.
+static int kinetos_controller_major(const char *fw)
+{
+  if(NULL == fw) {
+    return -1;
+  }
+  for(const char *p = fw; *p; p++)
+  {
+    if(!isdigit((unsigned char)*p) || (p > fw && isdigit((unsigned char)p[-1]))) {
+      continue;
+    }
+    int major = 0;
+    const char *q = p;
+    while(isdigit((unsigned char)*q) && major < 1000) {
+      major = major * 10 + (*q++ - '0');
+    }
+    if('.' == *q) {
+      return major;
+    }
+  }
+  return -1;
+}
