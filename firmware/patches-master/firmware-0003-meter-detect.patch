index 00000000..c891bdd9
--- /dev/null
+++ b/src/sdm_meter_proto.cpp
@@ -0,0 +1,133 @@
+#include "sdm_meter_proto.h"
+
+#include <string.h>
+#include <math.h>
+
+// SDM630 input registers (FC 0x04, IEEE-754 float, big-endian)
+static const uint16_t sdm630_registers[SDM_Q_COUNT] = {
+  0x0000, 0x0002, 0x0004, // voltage L1-L3
+  0x0006, 0x0008, 0x000A, // current L1-L3
+  0x000C, 0x000E, 0x0010, // active power L1-L3
+  0x0034,                 // total system power
+  0x0048,                 // import active energy kWh
+  0x0156                  // total active energy kWh
+};
+
+// DTS4921 native registers (FC 0x03/0x04, 32 bit, high word first)
+static const uint16_t dts4921_registers[SDM_Q_COUNT] = {
+  0x0100, 0x0102, 0x0104, // voltage L1-L3, uint32, 0.1 V
+  0x0106, 0x0108, 0x010A, // current L1-L3, uint32, 0.001 A
+  0x0110, 0x0112, 0x0114, // active power L1-L3, int32, 0.1 W
+  0x010E,                 // total active power, int32, 0.1 W
+  0x0027,                 // positive (import) active energy, uint32, 0.01 kWh
+  0x001D                  // total active energy, uint32, 0.01 kWh
+};
+
+uint16_t sdm_meter_crc16(const uint8_t *data, size_t len)
+{
+  uint16_t crc = 0xFFFF;
+  for(size_t i = 0; i < len; i++)
+  {
+    crc ^= data[i];
+    for(int b = 0; b < 8; b++) {
+      crc = (crc & 1) ? (crc >> 1) ^ 0xA001 : crc >> 1;
+    }
+  }
+  return crc;
+}
+
+uint16_t sdm_meter_register(SdmMeterCard card, SdmMeterQuantity q)
+{
+  return SDM_CARD_DTS4921 == card ? dts4921_registers[q] : sdm630_registers[q];
+}
+
+size_t sdm_meter_build_request(uint8_t *out, uint8_t address, uint16_t reg)
+{
+  out[0] = address;
+  out[1] = SDM_METER_FC_READ_INPUT;
+  out[2] = (uint8_t)(reg >> 8);
+  out[3] = (uint8_t)(reg & 0xFF);
+  out[4] = 0x00;
+  out[5] = 0x02;
+  uint16_t crc = sdm_meter_crc16(out, 6);
+  out[6] = crc & 0xFF;
+  out[7] = crc >> 8;
+  return SDM_METER_REQUEST_LEN;
+}
+
+size_t sdm_meter_expected_length(const uint8_t *rx, size_t len)
+{
+  if(len >= 2 && (rx[1] & 0x80)) {
+    return SDM_METER_EXCEPTION_LEN;
+  }
+  return SDM_METER_RESPONSE_LEN;
+}
+
+SdmMeterFrame sdm_meter_parse(const uint8_t *rx, size_t len, uint8_t address, uint32_t &raw)
+{
+  size_t expected = sdm_meter_expected_length(rx, len);
+  if(len < expected) {
+    return SDM_FRAME_INCOMPLETE;
+  }
+  uint16_t crc = sdm_meter_crc16(rx, expected - 2);
+  if(rx[0] != address ||
+     rx[expected - 2] != (crc & 0xFF) || rx[expected - 1] != (crc >> 8)) {
+    return SDM_FRAME_BAD;
+  }
+  if(SDM_METER_EXCEPTION_LEN == expected) {
+    return (SDM_METER_FC_READ_INPUT | 0x80) == rx[1] ? SDM_FRAME_EXCEPTION : SDM_FRAME_BAD;
+  }
+  if(rx[1] != SDM_METER_FC_READ_INPUT || rx[2] != 0x04) {
+    return SDM_FRAME_BAD;
+  }
+  raw = ((uint32_t)rx[3] << 24) | ((uint32_t)rx[4] << 16) | ((uint32_t)rx[5] << 8) | rx[6];
+  return SDM_FRAME_OK;
+}
+
+bool sdm_meter_decode(SdmMeterCard card, SdmMeterQuantity q, uint32_t raw, float &value)
+{
+  if(SDM_CARD_DTS4921 != card)
+  {
+    float f;
+    memcpy(&f, &raw, sizeof(f));
+    if(isnan(f)) {
+      return false;
+    }
+    value = f;
+    return true;
+  }
+
+  switch(q)
+  {
+    case SDM_Q_VOLTAGE_L1: case SDM_Q_VOLTAGE_L2: case SDM_Q_VOLTAGE_L3:
+      value = (float)((double)raw * 0.1);
+      break;
+    case SDM_Q_CURRENT_L1: case SDM_Q_CURRENT_L2: case SDM_Q_CURRENT_L3:
+      value = (float)((double)raw * 0.001);
+      break;
+    case SDM_Q_POWER_L1: case SDM_Q_POWER_L2: case SDM_Q_POWER_L3: case SDM_Q_POWER_TOTAL:
+      value = (float)((double)(int32_t)raw * 0.1);
+      break;
+    case SDM_Q_IMPORT_ENERGY: case SDM_Q_TOTAL_ENERGY:
+      value = (float)((double)raw * 0.01);
+      break;
+    default:
+      return false;
+  }
+  return true;
+}
+
+bool sdm_meter_voltage_plausible(float volts)
+{
+  return volts >= SDM_METER_PLAUSIBLE_MIN_V && volts <= SDM_METER_PLAUSIBLE_MAX_V;
+}
+
+const char *sdm_meter_card_name(SdmMeterCard card)
+{
+  switch(card)
+  {
+    case SDM_CARD_SDM630: return "sdm630";
+    case SDM_CARD_DTS4921: return "dts4921";
+    default: return "unknown";
+  }
+}
diff --git a/src/sdm_meter_proto.h b/src/sdm_meter_proto.h
new file mode 100644
index 00000000..ed942987
--- /dev/null
+++ b/src/sdm_meter_proto.h
@@ -0,0 +1,69 @@
+#ifndef SDM_METER_PROTO_H
+#define SDM_METER_PROTO_H
+
+// Pure Modbus RTU framing and register maps for the energy meter driver (sdm_meter.cpp).
+// No Arduino includes, so it is host-testable (test/test_sdm_meter_proto).
+//
+// Two register maps ("cards") are known on Kinetos boards:
+//   SDM630  Eastron SDM630 / SDM72D-M input registers, IEEE-754 float
+//   DTS4921 native map of the DTS4921 meter: uint32/int32 with fixed scaling
+// Both are read with function 0x04, two registers per value, high word first.
+// The driver only ever reads; it never writes a register (on the DTS4921, writes to
+// 0x0020 clear the energy counters and 0x0061-0x0063 change address/baud/parity).
+
+#include <stdint.h>
+#include <stddef.h>
+
+enum SdmMeterCard {
+  SDM_CARD_SDM630 = 0,
+  SDM_CARD_DTS4921 = 1,
+  SDM_CARD_COUNT
+};
+
+// Order of the values, the same as SdmMeter::Value
+enum SdmMeterQuantity {
+  SDM_Q_VOLTAGE_L1, SDM_Q_VOLTAGE_L2, SDM_Q_VOLTAGE_L3,
+  SDM_Q_CURRENT_L1, SDM_Q_CURRENT_L2, SDM_Q_CURRENT_L3,
+  SDM_Q_POWER_L1, SDM_Q_POWER_L2, SDM_Q_POWER_L3,
+  SDM_Q_POWER_TOTAL, SDM_Q_IMPORT_ENERGY, SDM_Q_TOTAL_ENERGY,
+  SDM_Q_COUNT
+};
+
+enum SdmMeterFrame {
+  SDM_FRAME_INCOMPLETE,  // wait for more bytes
+  SDM_FRAME_OK,          // valid answer, raw value filled in
+  SDM_FRAME_EXCEPTION,   // valid exception answer (the meter talks, but not this map)
+  SDM_FRAME_BAD          // wrong address/function/length or CRC
+};
+
+#define SDM_METER_FC_READ_INPUT   0x04
+#define SDM_METER_REQUEST_LEN     8
+#define SDM_METER_RESPONSE_LEN    9   // address, fc, 4, 4 data bytes, CRC
+#define SDM_METER_EXCEPTION_LEN   5   // address, fc | 0x80, code, CRC
+
+// Mains voltage that counts as a plausible reading of L1 during detection
+#define SDM_METER_PLAUSIBLE_MIN_V 100.0f
+#define SDM_METER_PLAUSIBLE_MAX_V 300.0f
+
+uint16_t sdm_meter_crc16(const uint8_t *data, size_t len);
+
+// Register of a value in the given map
+uint16_t sdm_meter_register(SdmMeterCard card, SdmMeterQuantity q);
+
+// Read-input-registers request for two registers at reg; out needs SDM_METER_REQUEST_LEN bytes
+size_t sdm_meter_build_request(uint8_t *out, uint8_t address, uint16_t reg);
+
+// Number of bytes the answer will have, judged from the bytes received so far
+size_t sdm_meter_expected_length(const uint8_t *rx, size_t len);
+
+// Checks a (possibly partial) answer; on SDM_FRAME_OK raw holds the 32-bit value, high word first
+SdmMeterFrame sdm_meter_parse(const uint8_t *rx, size_t len, uint8_t address, uint32_t &raw);
+
+// Converts the raw 32-bit value into V, A, W or kWh. Returns false for NaN (SDM630).
+bool sdm_meter_decode(SdmMeterCard card, SdmMeterQuantity q, uint32_t raw, float &value);
+
+bool sdm_meter_voltage_plausible(float volts);
+
+const char *sdm_meter_card_name(SdmMeterCard card);
+
+#endif // SDM_METER_PROTO_H
