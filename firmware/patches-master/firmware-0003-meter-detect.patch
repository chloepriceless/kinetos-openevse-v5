diff --git a/test/test_sdm_meter_proto/test_sdm_meter_proto.cpp b/test/test_sdm_meter_proto/test_sdm_meter_proto.cpp
new file mode 100644
index 00000000..47b325e2
--- /dev/null
+++ b/test/test_sdm_meter_proto/test_sdm_meter_proto.cpp
@@ -0,0 +1,116 @@
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include "doctest.h"
+#include <string.h>
+#include <vector>
+#include "sdm_meter_proto.h"
+
+static std::vector<uint8_t> with_crc(std::vector<uint8_t> f)
+{
+  uint16_t crc = sdm_meter_crc16(f.data(), f.size());
+  f.push_back(crc & 0xFF);
+  f.push_back(crc >> 8);
+  return f;
+}
+
+static SdmMeterFrame parse(const std::vector<uint8_t> &f, uint32_t &raw)
+{
+  return sdm_meter_parse(f.data(), f.size(), 1, raw);
+}
+
+TEST_CASE("DTS4921 example from the manufacturer: request and 238.1 V answer")
+{
+  uint8_t req[SDM_METER_REQUEST_LEN];
+  REQUIRE(sdm_meter_register(SDM_CARD_DTS4921, SDM_Q_VOLTAGE_L1) == 0x0100);
+  REQUIRE(sdm_meter_build_request(req, 1, 0x0100) == 8);
+  const uint8_t expected[8] = { 0x01, 0x04, 0x01, 0x00, 0x00, 0x02, 0x70, 0x37 };
+  CHECK(memcmp(req, expected, 8) == 0);
+
+  const std::vector<uint8_t> answer = { 0x01, 0x04, 0x04, 0x00, 0x00, 0x09, 0x4D, 0x3D, 0xE1 };
+  uint32_t raw = 0;
+  REQUIRE(parse(answer, raw) == SDM_FRAME_OK);
+  CHECK(raw == 0x094D);
+  float v = 0;
+  REQUIRE(sdm_meter_decode(SDM_CARD_DTS4921, SDM_Q_VOLTAGE_L1, raw, v));
+  CHECK(v == doctest::Approx(238.1).epsilon(1e-5));
+  CHECK(sdm_meter_voltage_plausible(v));
+}
+
+TEST_CASE("SDM630 request and float answer stay as before")
+{
+  uint8_t req[SDM_METER_REQUEST_LEN];
+  sdm_meter_build_request(req, 1, sdm_meter_register(SDM_CARD_SDM630, SDM_Q_VOLTAGE_L1));
+  const uint8_t expected[8] = { 0x01, 0x04, 0x00, 0x00, 0x00, 0x02, 0x71, 0xCB };
+  CHECK(memcmp(req, expected, 8) == 0);
+  CHECK(sdm_meter_register(SDM_CARD_SDM630, SDM_Q_POWER_TOTAL) == 0x0034);
+  CHECK(sdm_meter_register(SDM_CARD_SDM630, SDM_Q_IMPORT_ENERGY) == 0x0048);
+  CHECK(sdm_meter_register(SDM_CARD_SDM630, SDM_Q_TOTAL_ENERGY) == 0x0156);
+
+  // 230.0 V = 0x43660000
+  uint32_t raw = 0;
+  REQUIRE(parse(with_crc({ 0x01, 0x04, 0x04, 0x43, 0x66, 0x00, 0x00 }), raw) == SDM_FRAME_OK);
+  float v = 0;
+  REQUIRE(sdm_meter_decode(SDM_CARD_SDM630, SDM_Q_VOLTAGE_L1, raw, v));
+  CHECK(v == doctest::Approx(230.0));
+  CHECK(sdm_meter_voltage_plausible(v));
+
+  // NaN is not taken
+  CHECK_FALSE(sdm_meter_decode(SDM_CARD_SDM630, SDM_Q_VOLTAGE_L1, 0x7FC00000, v));
+}
+
+TEST_CASE("The wrong map gives an implausible voltage")
+{
+  float v = 0;
+  // DTS4921 integer 238.1 V read as SDM630 float: a denormal near 0 (issue #4: 1.6e-33 V)
+  REQUIRE(sdm_meter_decode(SDM_CARD_SDM630, SDM_Q_VOLTAGE_L1, 0x094D, v));
+  CHECK_FALSE(sdm_meter_voltage_plausible(v));
+  // SDM630 float 230 V read as DTS4921 integer: millions of volts
+  REQUIRE(sdm_meter_decode(SDM_CARD_DTS4921, SDM_Q_VOLTAGE_L1, 0x43660000, v));
+  CHECK_FALSE(sdm_meter_voltage_plausible(v));
+  CHECK_FALSE(sdm_meter_voltage_plausible(0.0f));
+  CHECK_FALSE(sdm_meter_voltage_plausible(99.9f));
+  CHECK_FALSE(sdm_meter_voltage_plausible(300.1f));
+  CHECK(sdm_meter_voltage_plausible(100.0f));
+  CHECK(sdm_meter_voltage_plausible(300.0f));
+}
+
+TEST_CASE("DTS4921 scaling: current, signed power, energy")
+{
+  float v = 0;
+  REQUIRE(sdm_meter_decode(SDM_CARD_DTS4921, SDM_Q_CURRENT_L2, 16123, v));
+  CHECK(v == doctest::Approx(16.123));
+  REQUIRE(sdm_meter_decode(SDM_CARD_DTS4921, SDM_Q_POWER_TOTAL, 110400, v));
+  CHECK(v == doctest::Approx(11040.0));
+  REQUIRE(sdm_meter_decode(SDM_CARD_DTS4921, SDM_Q_POWER_L1, (uint32_t)-153, v));
+  CHECK(v == doctest::Approx(-15.3));
+  REQUIRE(sdm_meter_decode(SDM_CARD_DTS4921, SDM_Q_IMPORT_ENERGY, 1234567, v));
+  CHECK(v == doctest::Approx(12345.67));
+  CHECK(sdm_meter_register(SDM_CARD_DTS4921, SDM_Q_POWER_TOTAL) == 0x010E);
+  CHECK(sdm_meter_register(SDM_CARD_DTS4921, SDM_Q_POWER_L3) == 0x0114);
+  CHECK(sdm_meter_register(SDM_CARD_DTS4921, SDM_Q_IMPORT_ENERGY) == 0x0027);
+  CHECK(sdm_meter_register(SDM_CARD_DTS4921, SDM_Q_TOTAL_ENERGY) == 0x001D);
+}
+
+TEST_CASE("Exception, CRC and partial frames")
+{
+  uint32_t raw = 0;
+  std::vector<uint8_t> ex = with_crc({ 0x01, 0x84, 0x02 });
+  CHECK(sdm_meter_expected_length(ex.data(), 1) == SDM_METER_RESPONSE_LEN);
+  CHECK(sdm_meter_expected_length(ex.data(), 2) == SDM_METER_EXCEPTION_LEN);
+  CHECK(sdm_meter_parse(ex.data(), 3, 1, raw) == SDM_FRAME_INCOMPLETE);
+  CHECK(parse(ex, raw) == SDM_FRAME_EXCEPTION);
+
+  std::vector<uint8_t> ok = { 0x01, 0x04, 0x04, 0x00, 0x00, 0x09, 0x4D, 0x3D, 0xE1 };
+  CHECK(sdm_meter_parse(ok.data(), 8, 1, raw) == SDM_FRAME_INCOMPLETE);
+  std::vector<uint8_t> bad = ok;
+  bad[6] ^= 0x01;
+  CHECK(parse(bad, raw) == SDM_FRAME_BAD);
+  CHECK(sdm_meter_parse(ok.data(), ok.size(), 2, raw) == SDM_FRAME_BAD); // other slave
+  CHECK(parse(with_crc({ 0x01, 0x03, 0x04, 0x00, 0x00, 0x09, 0x4D }), raw) == SDM_FRAME_BAD); // other function
+  CHECK(parse(with_crc({ 0x01, 0x83, 0x02 }), raw) == SDM_FRAME_BAD);
+}
+
+TEST_CASE("Names")
+{
+  CHECK(strcmp(sdm_meter_card_name(SDM_CARD_SDM630), "sdm630") == 0);
+  CHECK(strcmp(sdm_meter_card_name(SDM_CARD_DTS4921), "dts4921") == 0);
+}
