@@ -0,0 +1,213 @@
+<!-- src/routes/settings/Eebus.svelte -->
+<!-- EEBUS (firmware built with ENABLE_EEBUS). Listed in the hub only when
+     /config reports eebus_failsafe_duration (see lib/config/pages.js). -->
+<script>
+  import { _ } from 'svelte-i18n'
+  import { config_store } from '../../lib/stores/config.js'
+  import { createConfigForm } from '../../lib/config/configForm.svelte.js'
+  import { httpAPI } from '../../lib/api/httpAPI.js'
+  import { serialQueue } from '../../lib/queue.js'
+  import {
+    EEBUS_FAILSAFE_LIMIT, EEBUS_FAILSAFE_HOURS, EEBUS_STATES, isValidSki, normalizeSki, formatSki,
+    peerName, splitPeers, peerStateKey, isLimitedState, formatRemaining, eebusResponseOk,
+  } from '../../lib/kinetos/eebus.js'
+  import ConfigPage from '../../lib/components/config/ConfigPage.svelte'
+  import ConfigSection from '../../lib/components/config/ConfigSection.svelte'
+  import FormField from '../../lib/components/config/FormField.svelte'
+  import ReadOnlyRow from '../../lib/components/config/ReadOnlyRow.svelte'
+  import Toggle from '../../lib/components/ui/Toggle.svelte'
+  import NumberInput from '../../lib/components/ui/NumberInput.svelte'
+  import Button from '../../lib/components/ui/Button.svelte'
+
+  const form = createConfigForm()
+  const ss = form.saveState
+
+  let enabled = $derived(!!$config_store?.eebus_enabled)
+
+  // GET /eebus: state of the node and the nodes around it. Polled while the
+  // page is open; pairing changes show up within a few seconds.
+  let data = $state(null)
+  async function refresh() {
+    const res = await serialQueue.add(() => httpAPI('GET', '/eebus'))
+    if (res && typeof res === 'object') data = res
+  }
+  $effect(() => {
+    refresh()
+    const poll = setInterval(refresh, 3000)
+    return () => clearInterval(poll)
+  })
+
+  let peers = $derived(splitPeers(data?.peers))
+  let state = $derived(EEBUS_STATES.includes(data?.state) ? data.state : 'disabled')
+  let limited = $derived(isLimitedState(state))
+  let stateDetail = $derived.by(() => {
+    if (!limited) return ''
+    const rest = formatRemaining(data?.remaining)
+    return `${data?.limit ?? 0} ${$_('units.watt')}${rest ? ' · ' + rest : ''}`
+  })
+
+  // Pairing: POST /eebus/trust and /eebus/untrust with the SKI as the body.
+  let busy = $state(false)
+  let pairError = $state(null)
+  async function pair(ski, trust) {
+    if (busy) return
+    busy = true
+    pairError = null
+    try {
+      const res = await serialQueue.add(() =>
+        httpAPI('POST', trust ? '/eebus/trust' : '/eebus/untrust', normalizeSki(ski)))
+      if (!eebusResponseOk(res)) {
+        pairError = res && typeof res === 'object' && res.msg ? res.msg : $_('kinetos.eebus.pair_failed')
+      }
+      await refresh()
+    } finally {
+      busy = false
+    }
+  }
+
+  let manualSki = $state('')
+  let manualValid = $derived(isValidSki(manualSki))
+  async function pairManual() {
+    await pair(manualSki, true)
+    if (!pairError) manualSki = ''
+  }
+
+  let localRevert = $state(0)
+  function saveFailsafeLimit(v) {
+    if (!Number.isInteger(v) || v < EEBUS_FAILSAFE_LIMIT.min || v > EEBUS_FAILSAFE_LIMIT.max) {
+      localRevert += 1
+      return
+    }
+    form.saveField('eebus_failsafe_limit', v)
+  }
+  function saveFailsafeHours(v) {
+    if (!Number.isInteger(v) || v < EEBUS_FAILSAFE_HOURS.min || v > EEBUS_FAILSAFE_HOURS.max) {
+      localRevert += 1
+      return
+    }
+    form.saveField('eebus_failsafe_duration', v * 3600)
+  }
+</script>
+
+<ConfigPage title={$_('config.pages.eebus')}>
+  <ConfigSection>
+    <ReadOnlyRow
+      label={$_('kinetos.eebus.state')}
+      value={enabled ? $_('kinetos.eebus.states.' + state) : $_('kinetos.eebus.off')}
+      detail={stateDetail}
+      tone={limited ? 'warn' : 'default'}
+    />
+    <FormField
+      label={$_('kinetos.eebus.enable')}
+      description={$_('kinetos.eebus.enable_desc')}
+      status={$ss.eebus_enabled ?? 'idle'}
+    >
+      <Toggle
+        checked={enabled}
+        label={$_('kinetos.eebus.enable')}
+        onchange={(v) => form.saveField('eebus_enabled', v)}
+      />
+    </FormField>
+  </ConfigSection>
+
+  {#if enabled}
+    <ConfigSection title={$_('kinetos.eebus.identity')}>
+      <p class="mb-2 text-xs text-text-dim">{$_('kinetos.eebus.identity_desc')}</p>
+      {#if data?.ski}
+        <p class="break-all rounded-xl bg-surface-2 px-3 py-2 font-mono text-sm text-text">{formatSki(data.ski)}</p>
+        <ReadOnlyRow label={$_('kinetos.eebus.port')} value={data.port} />
+      {:else}
+        <p class="text-sm text-text-dim">{$_('kinetos.eebus.starting')}</p>
+      {/if}
+    </ConfigSection>
+
+    <ConfigSection title={$_('kinetos.eebus.paired')}>
+      {#if peers.paired.length === 0}
+        <p class="text-sm text-text-dim">{$_('kinetos.eebus.paired_none')}</p>
+      {/if}
+      {#each peers.paired as peer (peer.ski)}
+        <div class="border-b border-border py-3 last:border-b-0">
+          <div class="flex items-center justify-between gap-3">
+            <div class="min-w-0">
+              <p class="text-sm text-text">
+                {peerName(peer) || $_('kinetos.eebus.unknown')}
+                {#if peer.guard}
+                  <span class="ml-1 rounded-full bg-surface-2 px-2 py-0.5 text-xs text-warning">{$_('kinetos.eebus.guard')}</span>
+                {/if}
+              </p>
+              <p class="break-all font-mono text-xs text-text-dim">{formatSki(peer.ski)}</p>
+              <p class="text-xs {peer.connected && !peer.waiting ? 'text-accent' : 'text-text-dim'}">
+                {$_('kinetos.eebus.' + peerStateKey(peer))}
+              </p>
+            </div>
+            <div class="w-28 shrink-0">
+              <Button label={$_('kinetos.eebus.unpair')} variant="ghost" disabled={busy} onclick={() => pair(peer.ski, false)} />
+            </div>
+          </div>
+        </div>
+      {/each}
+    </ConfigSection>
+
+    <ConfigSection title={$_('kinetos.eebus.found')}>
+      {#if peers.found.length === 0}
+        <p class="text-sm text-text-dim">{$_('kinetos.eebus.found_none')}</p>
+      {/if}
+      {#each peers.found as peer (peer.ski)}
+        <div class="border-b border-border py-3 last:border-b-0">
+          <div class="flex items-center justify-between gap-3">
+            <div class="min-w-0">
+              <p class="text-sm text-text">{peerName(peer) || $_('kinetos.eebus.unknown')}</p>
+              <p class="break-all font-mono text-xs text-text-dim">{formatSki(peer.ski)}</p>
+            </div>
+            <div class="w-28 shrink-0">
+              <Button label={$_('kinetos.eebus.pair')} disabled={busy} onclick={() => pair(peer.ski, true)} />
+            </div>
+          </div>
+        </div>
+      {/each}
+
+      <FormField label={$_('kinetos.eebus.manual')} description={$_('kinetos.eebus.manual_desc')}>
+        <!-- Bound directly (TextInput only reports on blur): the button
+             below follows the input while typing. -->
+        <input
+          type="text"
+          bind:value={manualSki}
+          placeholder={$_('kinetos.eebus.manual_placeholder')}
+          maxlength="60"
+          autocomplete="off"
+          spellcheck="false"
+          class="w-full rounded-xl border border-border bg-surface-2 px-3 py-2 font-mono text-sm text-text
+                 placeholder:text-text-dim focus:border-accent focus:outline-none"
+        />
+      </FormField>
+      <Button label={$_('kinetos.eebus.pair')} disabled={busy || !manualValid} onclick={pairManual} />
+      {#if pairError}
+        <p class="mt-2 text-xs text-error" role="alert">{pairError}</p>
+      {/if}
+    </ConfigSection>
+
+    <ConfigSection title={$_('kinetos.eebus.failsafe')}>
+      <p class="mb-2 text-xs text-text-dim">{$_('kinetos.eebus.failsafe_desc')}</p>
+      <FormField label={$_('kinetos.eebus.failsafe_limit')} status={$ss.eebus_failsafe_limit ?? 'idle'}>
+        <NumberInput
+          value={$config_store?.eebus_failsafe_limit ?? EEBUS_FAILSAFE_LIMIT.default}
+          min={EEBUS_FAILSAFE_LIMIT.min}
+          max={EEBUS_FAILSAFE_LIMIT.max}
+          step={EEBUS_FAILSAFE_LIMIT.step}
+          revert={form.revert + localRevert}
+          onchange={saveFailsafeLimit}
+        />
+      </FormField>
+      <FormField label={$_('kinetos.eebus.failsafe_duration')} status={$ss.eebus_failsafe_duration ?? 'idle'}>
+        <NumberInput
+          value={Math.round(($config_store?.eebus_failsafe_duration ?? EEBUS_FAILSAFE_HOURS.default * 3600) / 3600)}
+          min={EEBUS_FAILSAFE_HOURS.min}
+          max={EEBUS_FAILSAFE_HOURS.max}
+          step={EEBUS_FAILSAFE_HOURS.step}
+          revert={form.revert + localRevert}
+          onchange={saveFailsafeHours}
+        />
+      </FormField>
+    </ConfigSection>
+  {/if}
+</ConfigPage>
diff --git a/src/routes/settings/__tests__/Eebus.test.js b/src/routes/settings/__tests__/Eebus.test.js
