diff --git a/src/lib/kinetos/__tests__/eebus.test.js b/src/lib/kinetos/__tests__/eebus.test.js
new file mode 100644
index 0000000..c413757
--- /dev/null
+++ b/src/lib/kinetos/__tests__/eebus.test.js
@@ -0,0 +1,75 @@
+import { describe, it, expect } from 'vitest'
+import {
+  normalizeSki, isValidSki, formatSki, peerName, splitPeers, peerStateKey,
+  isLimitedState, formatRemaining, eebusResponseOk,
+} from '../eebus.js'
+
+const SKI = 'd821f6a40448720a57def41308b191ff94f339a6'
+
+describe('SKI helpers', () => {
+  it('accepts 40 hex characters, with spaces, colons and upper case', () => {
+    expect(isValidSki(SKI)).toBe(true)
+    expect(isValidSki('D8:21:F6:A4:04:48:72:0A:57:DE:F4:13:08:B1:91:FF:94:F3:39:A6')).toBe(true)
+    expect(normalizeSki(' D821 f6a4 0448720a57def41308b191ff94f339a6 ')).toBe(SKI)
+  })
+  it('rejects anything else', () => {
+    expect(isValidSki(SKI.slice(1))).toBe(false)
+    expect(isValidSki(SKI + '0')).toBe(false)
+    expect(isValidSki(SKI.replace('d', 'g'))).toBe(false)
+    expect(isValidSki(null)).toBe(false)
+  })
+  it('formats in groups of four', () => {
+    expect(formatSki(SKI)).toBe('d821 f6a4 0448 720a 57de f413 08b1 91ff 94f3 39a6')
+  })
+})
+
+describe('peers', () => {
+  const peers = [
+    { ski: 'a', trusted: true, connected: true, guard: true, brand: 'DVhub', model: 'DVhub' },
+    { ski: 'b', trusted: false, discovered: true, name: 'EVCC_HEMS_01' },
+    { ski: 'c', trusted: true, discovered: false },
+    { ski: 'd', trusted: false, discovered: false },
+  ]
+  it('splits into paired and found', () => {
+    const { paired, found } = splitPeers(peers)
+    expect(paired.map((p) => p.ski)).toEqual(['a', 'c'])
+    expect(found.map((p) => p.ski)).toEqual(['b'])
+    expect(splitPeers(undefined)).toEqual({ paired: [], found: [] })
+  })
+  it('names a node by brand and model, else by its service name', () => {
+    expect(peerName(peers[0])).toBe('DVhub DVhub')
+    expect(peerName(peers[1])).toBe('EVCC_HEMS_01')
+    expect(peerName(peers[2])).toBe('')
+  })
+  it('maps the connection state of a paired node', () => {
+    expect(peerStateKey({ connected: true })).toBe('peer_connected')
+    expect(peerStateKey({ connected: true, waiting: true })).toBe('peer_waiting')
+    expect(peerStateKey({ discovered: true })).toBe('peer_found')
+    expect(peerStateKey({})).toBe('peer_absent')
+  })
+})
+
+describe('limit', () => {
+  it('is in force in the states limited and failsafe', () => {
+    expect(isLimitedState('limited')).toBe(true)
+    expect(isLimitedState('failsafe')).toBe(true)
+    expect(isLimitedState('unlimited_controlled')).toBe(false)
+    expect(isLimitedState('disabled')).toBe(false)
+  })
+  it('formats the remaining time', () => {
+    expect(formatRemaining(7199)).toBe('1 h 59 min')
+    expect(formatRemaining(600)).toBe('10 min')
+    expect(formatRemaining(45)).toBe('45 s')
+    expect(formatRemaining(-1)).toBe('')
+    expect(formatRemaining(undefined)).toBe('')
+  })
+})
+
+describe('eebusResponseOk', () => {
+  it('accepts {msg: done} only', () => {
+    expect(eebusResponseOk({ msg: 'done' })).toBe(true)
+    expect(eebusResponseOk({ msg: 'too many paired nodes' })).toBe(false)
+    expect(eebusResponseOk('error')).toBe(false)
+    expect(eebusResponseOk(null)).toBe(false)
+  })
+})
