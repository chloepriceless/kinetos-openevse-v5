+// src/routes/settings/__tests__/Eebus.test.js
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, fireEvent } from '@testing-library/svelte'
+
+vi.mock('svelte-i18n', () => {
+  const t = (k, opts) => (opts?.values ? `${k} ${JSON.stringify(opts.values)}` : k)
+  t.subscribe = (fn) => { fn(t); return () => {} }
+  return { _: t }
+})
+vi.mock('../../../lib/api/httpAPI.js', () => ({ httpAPI: vi.fn() }))
+
+import { httpAPI } from '../../../lib/api/httpAPI.js'
+import { config_store } from '../../../lib/stores/config.js'
+import { uistates_store } from '../../../lib/stores/uistates.js'
+
+import Eebus from '../Eebus.svelte'
+
+const OWN = 'd821f6a40448720a57def41308b191ff94f339a6'
+const BOX = 'd8d8a68526bb20370327d840fdfd1d78b99953b8'
+const HEMS = 'a0a0e31303cc38b841e131c9491574acd2d7ae70'
+
+const STATE = {
+  enabled: true, running: true, ski: OWN, port: 4712,
+  state: 'limited', limited: true, limit: 4200, remaining: 7199, heartbeat: true,
+  failsafe_limit: 4200, failsafe_duration: 7200,
+  peers: [
+    { ski: BOX, name: 'Steuerbox', brand: '', model: '', type: '', trusted: true, discovered: true, connected: true, waiting: false, guard: true },
+    { ski: HEMS, name: 'EVCC_HEMS_01', brand: 'evcc', model: 'HEMS', type: '', trusted: false, discovered: true, connected: false, waiting: false, guard: false },
+  ],
+}
+
+const posts = (url) =>
+  httpAPI.mock.calls.filter(([m, u]) => m === 'POST' && u === url).map(([, , body]) => body)
+
+beforeEach(() => {
+  uistates_store.resetAlertBox()
+  httpAPI.mockReset()
+  httpAPI.mockImplementation((method, url) =>
+    Promise.resolve(method === 'GET' && url === '/eebus' ? STATE : { msg: 'done' }))
+  config_store.set({ eebus_enabled: true, eebus_failsafe_limit: 4200, eebus_failsafe_duration: 7200 })
+})
+
+describe('EEBUS page', () => {
+  it('shows only the switch while EEBUS is off', () => {
+    config_store.set({ eebus_enabled: false, eebus_failsafe_limit: 4200, eebus_failsafe_duration: 7200 })
+    const { getByText, queryByText } = render(Eebus)
+    expect(getByText('kinetos.eebus.off')).toBeInTheDocument()
+    expect(queryByText('kinetos.eebus.identity')).not.toBeInTheDocument()
+  })
+
+  it('shows the limit, the own SKI and both lists', async () => {
+    const { findByText, getByText } = render(Eebus)
+    expect(await findByText('d821 f6a4 0448 720a 57de f413 08b1 91ff 94f3 39a6')).toBeInTheDocument()
+    expect(getByText('kinetos.eebus.states.limited')).toBeInTheDocument()
+    expect(getByText('4200 units.watt · 1 h 59 min')).toBeInTheDocument()
+    expect(getByText('Steuerbox')).toBeInTheDocument()
+    expect(getByText('kinetos.eebus.guard')).toBeInTheDocument()
+    expect(getByText('kinetos.eebus.peer_connected')).toBeInTheDocument()
+    expect(getByText('evcc HEMS')).toBeInTheDocument()
+  })
+
+  it('pairs a found device and removes a paired one by SKI', async () => {
+    const { findByText, getAllByText, getByText } = render(Eebus)
+    await findByText('evcc HEMS')
+    // first "pair" button belongs to the found device, the last to the manual entry
+    await fireEvent.click(getAllByText('kinetos.eebus.pair')[0])
+    await vi.waitFor(() => expect(posts('/eebus/trust')).toEqual([HEMS]))
+    // the buttons are locked until the first request has finished
+    await vi.waitFor(() => expect(getByText('kinetos.eebus.unpair')).not.toBeDisabled())
+    await fireEvent.click(getByText('kinetos.eebus.unpair'))
+    await vi.waitFor(() => expect(posts('/eebus/untrust')).toEqual([BOX]))
+  })
+
+  it('pairs by a typed SKI once it is valid', async () => {
+    const { findByText, getAllByText, getByPlaceholderText } = render(Eebus)
+    await findByText('evcc HEMS')
+    const manual = getAllByText('kinetos.eebus.pair').at(-1)
+    expect(manual).toBeDisabled()
+    const typed = 'AA:BB:CC:DD:EE:FF:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD'
+    await fireEvent.input(getByPlaceholderText('kinetos.eebus.manual_placeholder'), { target: { value: typed } })
+    expect(manual).not.toBeDisabled()
+    await fireEvent.click(manual)
+    await vi.waitFor(() => expect(posts('/eebus/trust')).toEqual(['aabbccddeeff00112233445566778899aabbccdd']))
+  })
+
+  it('shows what the charger answers when pairing fails', async () => {
+    httpAPI.mockImplementation((method, url) =>
+      Promise.resolve(method === 'GET' ? STATE : { msg: 'too many paired nodes' }))
+    const { findByText, getAllByText, findByRole } = render(Eebus)
+    await findByText('evcc HEMS')
+    await fireEvent.click(getAllByText('kinetos.eebus.pair')[0])
+    expect(await findByRole('alert')).toHaveTextContent('too many paired nodes')
+  })
+})
