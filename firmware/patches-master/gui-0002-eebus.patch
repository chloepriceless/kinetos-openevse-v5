index 0000000..8c4568f
--- /dev/null
+++ b/src/lib/kinetos/eebus.js
@@ -0,0 +1,66 @@
+// src/lib/kinetos/eebus.js
+// EEBUS helpers (firmware src/eebus.cpp, GET /eebus).
+
+/** Failsafe limit (W) the firmware accepts from the settings page. */
+export const EEBUS_FAILSAFE_LIMIT = { min: 0, max: 22000, step: 100, default: 4200 }
+/** Failsafe duration in hours; EEBUS allows 2 to 24. */
+export const EEBUS_FAILSAFE_HOURS = { min: 2, max: 24, step: 1, default: 2 }
+
+/** States of the limit, as GET /eebus and the status report them. */
+export const EEBUS_STATES = [
+  'disabled', 'init', 'unlimited_controlled', 'limited', 'failsafe', 'unlimited_autonomous',
+]
+
+/** An SKI is 40 hex characters; spaces and colons from copy and paste are ignored. */
+export function normalizeSki(text) {
+  return String(text ?? '').replace(/[\s:]/g, '').toLowerCase()
+}
+
+export function isValidSki(text) {
+  return /^[0-9a-f]{40}$/.test(normalizeSki(text))
+}
+
+/** The SKI in groups of four characters, as it is read out or compared. */
+export function formatSki(ski) {
+  return normalizeSki(ski).replace(/(.{4})(?=.)/g, '$1 ')
+}
+
+/** What to show as the name of a node. */
+export function peerName(peer) {
+  const parts = [peer?.brand, peer?.model].filter(Boolean)
+  return parts.length ? parts.join(' ') : peer?.name || ''
+}
+
+/** Paired nodes first as their own list, then the ones only found in the network. */
+export function splitPeers(peers) {
+  const list = Array.isArray(peers) ? peers : []
+  return {
+    paired: list.filter((p) => p.trusted),
+    found: list.filter((p) => !p.trusted && p.discovered),
+  }
+}
+
+/** i18n key (below kinetos.eebus) for the connection state of a paired node. */
+export function peerStateKey(peer) {
+  if (peer?.connected) return peer.waiting ? 'peer_waiting' : 'peer_connected'
+  return peer?.discovered ? 'peer_found' : 'peer_absent'
+}
+
+/** True when the state means the charger is limited right now. */
+export function isLimitedState(state) {
+  return state === 'limited' || state === 'failsafe'
+}
+
+/** "1 h 59 min" / "45 s" for the remaining time of a limit; '' when open-ended. */
+export function formatRemaining(seconds) {
+  if (typeof seconds !== 'number' || seconds < 0) return ''
+  if (seconds < 60) return `${seconds} s`
+  const h = Math.floor(seconds / 3600)
+  const m = Math.floor((seconds % 3600) / 60)
+  return h > 0 ? `${h} h ${m} min` : `${m} min`
+}
+
+/** Did POST /eebus/trust or /eebus/untrust succeed? Failures carry another msg or are 'error'. */
+export function eebusResponseOk(res) {
+  return !!res && typeof res === 'object' && res.msg === 'done'
+}
