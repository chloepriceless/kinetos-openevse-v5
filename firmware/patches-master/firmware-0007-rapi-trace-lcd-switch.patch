+// ---- RAPI trace -------------------------------------------------------------------------
+
+struct RapiTraceLine
+{
+  uint32_t ms;
+  char dir;                     // '>' to the controller, '<' from it
+  char text[RAPITRACE_TEXT];    // printable, anything else as \xHH, '~' at the end if cut
+};
+
+struct RapiTraceLineBuf
+{
+  char text[RAPITRACE_TEXT];
+  uint8_t len = 0;
+  bool cut = false;
+};
+
+static RapiTraceLine s_trace[RAPITRACE_LINES];
+static uint8_t s_traceNext = 0;
+static uint8_t s_traceCount = 0;
+static RapiTraceLineBuf s_traceOut;
+static RapiTraceLineBuf s_traceIn;
+static bool s_traceSaved = false;        // a saved trace exists in LittleFS
+static bool s_traceSaveDone = false;     // saved since boot
+static uint32_t s_traceSaveMs = 0;
+static uint32_t s_traceLastOkMs = 0;     // when the last line starting with $OK came in
+
+static void rapitrace_push(char dir, RapiTraceLineBuf &b)
+{
+  RapiTraceLine &l = s_trace[s_traceNext];
+  l.ms = millis();
+  l.dir = dir;
+  memcpy(l.text, b.text, b.len);
+  l.text[b.len] = '\0';
+  if(b.cut && b.len > 0) {
+    l.text[b.len - 1] = '~';
+  }
+  if('<' == dir && 0 == strncmp(l.text, "$OK", 3)) {
+    s_traceLastOkMs = l.ms;
+  }
+  s_traceNext = (s_traceNext + 1) % RAPITRACE_LINES;
+  if(s_traceCount < RAPITRACE_LINES) {
+    s_traceCount++;
+  }
+  b.len = 0;
+  b.cut = false;
+}
+
+static void rapitrace_add(RapiTraceLineBuf &b, uint8_t c)
+{
+  char esc[5];
+  size_t n = 1;
+  if(c >= 0x20 && c < 0x7f) {
+    esc[0] = (char)c;
+  } else {
+    n = snprintf(esc, sizeof(esc), "\\x%02X", c);
+  }
+  if(b.len + n < RAPITRACE_TEXT) {
+    memcpy(b.text + b.len, esc, n);
+    b.len += n;
+  } else {
+    b.cut = true;
+  }
+}
+
+void kinetos_rapiwatch_tap(bool write, const uint8_t *buffer, size_t size)
+{
+  RapiTraceLineBuf &b = write ? s_traceOut : s_traceIn;
+  for(size_t i = 0; i < size; i++)
+  {
+    uint8_t c = buffer[i];
+    if('\r' == c) {
+      rapitrace_push(write ? '>' : '<', b);
+    } else if('\n' == c && 0 == b.len) {
+      continue;
+    } else {
+      rapitrace_add(b, c);
+    }
+  }
+}
+
+// Lines oldest first, times in seconds relative to refMs
+static void rapitrace_print_lines(Print &out, uint32_t refMs)
+{
+  for(uint8_t i = 0; i < s_traceCount; i++)
+  {
+    const RapiTraceLine &l = s_trace[(s_traceNext + RAPITRACE_LINES - s_traceCount + i) % RAPITRACE_LINES];
+    int32_t d = (int32_t)(l.ms - refMs);
+    out.printf("%+9.3f %c %s\n", d / 1000.0, l.dir, l.text);
+  }
+  if(s_traceOut.len) {
+    out.printf("  unfinished > %.*s\n", s_traceOut.len, s_traceOut.text);
+  }
+  if(s_traceIn.len) {
+    out.printf("  unfinished < %.*s\n", s_traceIn.len, s_traceIn.text);
+  }
+}
+
+static void rapitrace_save(uint32_t lastOkMs, uint32_t silences, const RapiWatchSnapshot &start)
+{
+  uint32_t ms = millis();
+  if(s_traceSaveDone && ms - s_traceSaveMs < RAPITRACE_SAVE_GAP_MS) {
+    return;
+  }
+  s_traceSaveDone = true;
+  s_traceSaveMs = ms;
+
+  if(!LittleFS.exists("/kinetos")) {
+    LittleFS.mkdir("/kinetos");
+  }
+  File f = LittleFS.open(RAPITRACE_FILE ".tmp", "w");
+  if(!f) {
+    DBUGLN("kinetos: could not save the RAPI trace");
+    return;
+  }
+  f.printf("Kinetos RAPI trace, firmware %s\n", currentfirmware.c_str());
+  f.printf("silence %lu: no $OK since uptime %lu s", (unsigned long)silences, (unsigned long)start.upS);
+  if(start.epoch) {
+    time_t t = start.epoch;
+    struct tm tm;
+    gmtime_r(&t, &tm);
+    char when[24];
+    strftime(when, sizeof(when), "%Y-%m-%d %H:%M:%S", &tm);
+    f.printf(" (%s UTC)", when);
+  }
+  f.printf(", state %u, vehicle %u", start.state, start.vehicle);
+  if(start.amps >= 0) {
+    f.printf(", %.2f A", start.amps);
+  }
+  f.printf("\ntimes in s relative to the last $OK, > to the controller, < from it\n");
+  // the watch task sees a new $OK up to 1 s late, the trace knows the exact time
+  rapitrace_print_lines(f, (s_traceLastOkMs && lastOkMs - s_traceLastOkMs < 2000UL) ? s_traceLastOkMs : lastOkMs);
+  f.close();
+  LittleFS.remove(RAPITRACE_FILE);
+  LittleFS.rename(RAPITRACE_FILE ".tmp", RAPITRACE_FILE);
+  s_traceSaved = true;
+  DBUGLN("kinetos: RAPI trace saved");
+}
+
+void kinetos_rapiwatch_print(Print &out)
+{
+  File f;
+  if(s_traceSaved) {
+    f = LittleFS.open(RAPITRACE_FILE, "r");
+  }
+  if(f)
+  {
+    out.print("=== saved when the last silence began (survives a restart) ===\n");
+    uint8_t buf[128];
+    size_t n;
+    while((n = f.read(buf, sizeof(buf))) > 0) {
+      out.write(buf, n);
+    }
+    f.close();
+  } else {
+    out.print("=== no silence saved yet ===\n");
+  }
+  out.printf("\n=== live, uptime %lu s, times in s relative to now ===\n", (unsigned long)(millis() / 1000UL));
+  rapitrace_print_lines(out, millis());
+}
