+  -D I2C_SCL=32
+  -D ENABLE_PN532
+  -D ENABLE_WIRED_ETHERNET
+  -D RESET_ETH_PHY_ON_BOOT=1
+  -D ETH_PHY_TYPE=ETH_PHY_LAN8720
+  -D ETH_PHY_ADDR=1
+  -D ETH_PHY_MDC=23
+  -D ETH_PHY_MDIO=18
