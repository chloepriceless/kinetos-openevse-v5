+#ifdef KINETOS_NO_DEBUG_UART
+// UART0 is wired to the EVSE controller and the other UARTs are taken, so debug output only
+// goes to the web console buffer (StreamSpy), never to a pin.
+class NullSerial : public Stream
+{
+  public:
+    void begin(unsigned long) {}
+    int available() { return 0; }
+    int read() { return -1; }
+    int peek() { return -1; }
+    void flush() {}
+    size_t write(uint8_t) { return 1; }
+    size_t write(const uint8_t *, size_t size) { return size; }
+};
+static NullSerial NullDebugPort;
+#undef DEBUG_PORT
+#define DEBUG_PORT NullDebugPort
+#endif
+
 StreamSpy SerialDebug(DEBUG_PORT);
 StreamSpy SerialEvse(RAPI_PORT);
 
